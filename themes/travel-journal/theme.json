  "density": "comfortable",
  "colours": {
    "light": {
      "heroShade": "#141c22",
      "heroText": "#ffffff",
      "bg": "#f6f3ee",
      "surface": "#ffffff",
      "text": "#1f2a2e",
      "muted": "#55625f",
      "accent": "#a5481f",
      "onAccent": "#ffffff",
      "border": "#e2ddd3",
      "art1": "#5f8c99",
      "art2": "#d9b26f"
    },
    "dark": {
      "heroShade": "#0a0f12",
      "heroText": "#ffffff",
      "bg": "#10161a",
      "surface": "#182128",
      "text": "#eef1ee",
      "muted": "#a9b5b3",
      "accent": "#f0a072",
      "onAccent": "#2a1206",
      "border": "#2a363d",
      "art1": "#2e5562",
      "art2": "#7a6233"
