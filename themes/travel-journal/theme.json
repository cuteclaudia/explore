        "page": "journal",
        "heading": "Earlier journeys",
        "columns": 3,
        "count": 3
      },
      {
        "type": "gallery",
        "page": "galleries",
        "style": "strip",
        "count": 5
      },
      {
        "type": "intro",
        "page": "about",
        "heading": "About"
      }
