{
  "schemaVersion": 1,
  "id": "neighbourhood",
  "number": 46,
  "name": "Neighbourhood noticeboard",
  "category": "organisation",
  "status": "preview",
  "description": "A friendly local noticeboard: dated notices, a guide to local groups and services, and a contact for residents.",
  "suits": [
    "Residents’ associations",
    "Street groups",
    "Village committees",
    "Progress associations"
  ],
  "baseTemplate": "canvas",
  "purpose": "personal",
  "recommendedVisibility": "public",
  "workgroupFriendly": true,
  "pages": [
    "home",
    "blog",
    "articles",
    "about",
    "contact"
  ],
  "pageLabels": {
    "blog": "Notices",
    "articles": "Local guide"
  },
  "density": "compact",
  "colours": {
    "light": {
      "heroShade": "#12130e",
      "heroText": "#eeefe6",
      "bg": "#f9f8f3",
      "surface": "#ffffff",
      "text": "#23261d",
      "muted": "#5a5e50",
      "accent": "#36622b",
      "onAccent": "#ffffff",
      "border": "#e5e3d6",
      "art1": "#a3c585",
      "art2": "#e6b566"
    },
    "dark": {
      "heroShade": "#12130e",
      "heroText": "#eeefe6",
      "bg": "#12130e",
      "surface": "#1b1c16",
      "text": "#eeefe6",
      "muted": "#a9ac9c",
      "accent": "#a9d68f",
      "onAccent": "#183011",
      "border": "#2f3127",
      "art1": "#3f5a2c",
      "art2": "#7a5c1c"
    }
  },
  "typography": {
    "heading": "humanist",
    "body": "sans",
    "headingWeight": 700,
    "headingCase": "none",
    "headingTracking": 0,
    "scale": 1
  },
  "shape": {
    "radius": 10,
    "buttonRadius": 10
  },
  "layout": {
    "maxWidth": 1180,
    "header": "split",
    "hero": "banner",
    "home": [
      {
        "type": "list",
        "page": "blog",
        "heading": "Noticeboard"
      },
      {
        "type": "cards",
        "page": "articles",
        "heading": "Local guide",
        "images": false
      },
      {
        "type": "intro",
        "page": "about",
        "heading": "About the association"
      },
      {
        "type": "contact",
        "page": "contact",
        "heading": "Contact the committee"
      }
    ]
  },
  "widgets": {
    "catalogue": "themes/widgets.json",
    "enabled": [
      "feature-panel",
      "quick-links"
    ],
    "suggested": [
      "upcoming-events",
      "map",
      "contact-card",
      "social-links"
    ],
    "switchable": "all"
  },
  "notes": [
    "Notices are posted by the site’s editors; there is no public posting, so the board cannot be spammed."
  ]
}
