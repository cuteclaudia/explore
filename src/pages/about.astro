---
import {siteContent} from '../lib/studio-content';
import AboutContent from '../components/AboutContent.astro';
export const prerender=false;
Astro.response.headers.set('Cache-Control','no-store');
let data;try{data=await siteContent().publicEntry('pages/about');}catch(error){if(error.status===404)return new Response('This page is not published.',{status:404});throw error;}
---
<AboutContent data={data}/>
