---
import Base from '../../layouts/Base.astro';
import {protectPage} from '../../../server/identity';
import {KOBO_APPS} from '../../lib/kobo-contract.mjs';
export const prerender=false;
const actor=await protectPage('/studio/kobo-test','settings.manage');if(actor instanceof Response)return actor;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Base title="Kōbō storage integration test" noindex>
<main class="wrap"><p><a href="/studio">← My Studio</a></p><h1>Kōbō integration test</h1><p>Owner testing only. The new storage contract is experimental until the shared acceptance checks pass. Saving here never publishes your files. This test requires a verified WebDAV or Google Drive connection.</p><p><a href="/studio/storage" target="_blank" rel="noopener">Configure and verify your storage connection ↗</a> · <a href="/apps">Use current editors</a></p>
<label>Test app <select id="kobo-app">{Object.entries(KOBO_APPS).map(([id,spec])=><option value={id}>{spec.folder}</option>)}</select></label><button id="kobo-start" type="button">Open test app</button><button id="kobo-stop" type="button" disabled>Close app</button><button id="kobo-fullscreen" type="button">Full screen</button><p id="kobo-state" role="status">Choose an app to start. Its test origin must be configured in Netlify first.</p>
<details id="kobo-diagnostics" hidden><summary>Storage error details</summary><p>The app may summarize several problems as a sync conflict. These are the exact failed website operations; no file contents or credentials are included.</p><pre id="kobo-errors" aria-live="polite"></pre><button type="button" id="kobo-copy-errors">Copy error details</button><span id="kobo-copy-status" role="status"></span></details>
<iframe id="kobo-test-frame" title="Kōbō test editor" sandbox="allow-scripts allow-same-origin allow-downloads allow-popups allow-modals" allow="clipboard-read; clipboard-write; fullscreen" referrerpolicy="no-referrer"></iframe>
</main></Base>
<script>
import {mountKoboShell} from '../../scripts/kobo-shell';
const frame=document.querySelector<HTMLIFrameElement>('#kobo-test-frame')!,state=document.querySelector<HTMLElement>('#kobo-state')!,start=document.querySelector<HTMLButtonElement>('#kobo-start')!,stop=document.querySelector<HTMLButtonElement>('#kobo-stop')!;let shell;const errors:string[]=[];
function operationError(e){const details=document.querySelector<HTMLDetailsElement>('#kobo-diagnostics')!;details.hidden=false;details.open=true;errors.push([new Date().toISOString(),e.operation,e.path,e.code,e.message].filter(Boolean).join(' · '));if(errors.length>8)errors.shift();document.querySelector('#kobo-errors')!.textContent=errors.join('\n');}
document.querySelector('#kobo-copy-errors')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(errors.join('\n'));document.querySelector('#kobo-copy-status')!.textContent='Copied.';}catch{document.querySelector('#kobo-copy-status')!.textContent='Select the error text above to copy it.';}});
start.onclick=async()=>{start.disabled=true;shell?.close();state.textContent='Starting isolated app…';try{const response=await fetch('/api/kobo/launch',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({app:document.querySelector<HTMLSelectElement>('#kobo-app')!.value})});const launch=await response.json();if(!response.ok)throw Error(launch.error?.message||'Could not launch this app.');if(!launch.storageStatus?.available)throw Error('Connect and verify your chosen storage provider in Files & storage before opening this experimental app. Current storage status: '+(launch.storageStatus?.reason||'unavailable')+'.');
 state.textContent='App opened. Waiting for its Kōbō storage bridge…';
 shell=mountKoboShell({frame,launch,requireStorage:true,onOperationError:operationError,onStatus:s=>{state.textContent=s.available?'Experimental storage bridge connected. Your working files stay private.':'App connected; storage status: '+s.reason+'. Configure Files & storage if needed.';},onClosed:message=>{state.textContent=message;stop.disabled=true;}});stop.disabled=false;
}catch(e){state.textContent=e instanceof Error?e.message:'The app could not start.';}finally{start.disabled=false;}};
stop.onclick=()=>shell?.close('App closed.');document.querySelector<HTMLButtonElement>('#kobo-fullscreen')!.onclick=async()=>{try{await frame.requestFullscreen();}catch{state.textContent='Full screen was declined by your browser.';}};
</script>
<style>main{padding-block:35px}h1{font-family:var(--serif);font-size:38px}button,select{margin:8px;padding:9px}iframe{width:100%;height:75vh;border:1px solid var(--border);background:#1c1c1c}p{max-width:80ch}#kobo-diagnostics{margin:12px 0;padding:12px;border:1px solid var(--border);border-radius:6px;font-size:12px}#kobo-diagnostics summary{cursor:pointer;font-weight:600}#kobo-errors{white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px}</style>
