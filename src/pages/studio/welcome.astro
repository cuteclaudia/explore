---
import Base from '../../layouts/Base.astro';
import {SORASPACE_SERVICES} from '../../lib/soraspace-services.mjs';
export const prerender=false;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Base title="Your SoraSpace account" noindex skipPageFeature><section class="wrap welcome-wrap" id="trial-account"><span class="eyebrow">SoraSpace · Your account</span><h1>Your space starts here.</h1><p id="trial-account-status" role="status">Checking your account…</p><div id="trial-account-private" hidden><p>Signed in as <strong id="trial-account-email"></strong>.</p><section id="trial-timing"><p id="trial-expiry" role="status"></p><button type="button" id="trial-activate" hidden>Start trial</button><button type="button" id="trial-redeem" hidden>Activate tester invitation</button><p id="trial-activation-status" role="status"></p></section><nav class="trial-actions"><a class="btn" id="trial-open-site" href="/studio/soraspace-setup" hidden>Start your website draft →</a><a class="btn ghost" id="trial-open-editor" href="/studio/soraspace-editor" hidden>Open saved editor</a><a class="btn ghost" id="trial-open-apps" href="/apps" hidden><span data-i18n="Open workspace">Open workspace</span></a><button type="button" id="trial-refresh">Refresh approval status</button><button type="button" id="trial-logout"><span data-i18n="Sign out">Sign out</span></button></nav><section id="trial-service-panel"><h2>Manage requested services</h2><p>You can add or remove choices here. During the trial, changes are requests for manual review; they do not charge you or change active access automatically.</p><form id="trial-services"><fieldset>{Object.entries(SORASPACE_SERVICES).map(([id,s])=><label class="trial-service"><input name="requested" type="checkbox" value={id}/><span><strong data-i18n={s.name}>{s.name}</strong><small data-i18n={s.description}>{s.description}</small><small data-active-service={id}></small></span></label>)}</fieldset><button type="submit" class="btn" id="trial-services-save">Save service choices</button><p id="trial-services-status" role="status"></p></form></section></div><p id="trial-signin" hidden><a href="/studio/login?next=%2Fstudio%2Fwelcome">Sign in to check your account →</a></p><p><a href="/studio/signup">Create a trial account →</a></p><p><a href="https://www.soraspace.studio/">← SoraSpace</a></p></section></Base>
<script>import '../../scripts/soraspace-account.mjs';</script>
<style>.welcome-wrap{max-width:850px;padding-block:24px 40px;font:14px/1.6 system-ui}.welcome-wrap h1{font:600 30px system-ui;margin:10px 0}.welcome-wrap h2{font:600 20px system-ui}.welcome-wrap [hidden]{display:none!important}.trial-actions{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0}.trial-actions a,.trial-actions button,.welcome-wrap button{min-height:44px;font-size:13px}#trial-service-panel{padding:16px;border:1px solid var(--border);border-radius:7px}.welcome-wrap fieldset{border:0;padding:0;margin:12px 0}.trial-service{display:flex;gap:12px;align-items:center;margin:8px 0;min-height:48px}.trial-service input{width:18px;height:18px;flex-shrink:0}.trial-service small{display:block;font-size:12px;opacity:.75}#trial-services-status{min-height:24px;font-size:12px}</style>
