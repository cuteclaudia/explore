---
import Base from '../../layouts/Base.astro';
import {protectPage} from '../../../server/identity';
export const prerender=false;
const access=await protectPage('/studio/storage');if(access instanceof Response)return access;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Base title="Storage connections" description="Choose where to keep private working files." noindex>
<section class="wrap storage-wrap"><a href="/studio">← My Studio</a><h1 class="serif">Your storage connections</h1><h2>Private site storage</h2><p>Working files can be saved privately with the site. Publishing a finished export is a separate action.</p>{access.isOwner&&<section><h2>First-time encryption setup</h2><p>Generate this key only when first enabling private storage connections. Save it as FILE_STORAGE_ENCRYPTION_KEY in Netlify. Keep an existing key unchanged; replacing it prevents saved connection credentials from being decrypted.</p><button type="button" id="generate-storage-key" class="btn ghost">Generate setup key</button><label>New encryption key<input id="storage-key" type="password" readonly autocomplete="off" /></label><button type="button" id="copy-storage-key" class="btn ghost">Copy key</button></section>}<h2>Default save location</h2><p>The apps can remember your preferred destination on your account. Each export still requires a Save click. Device folders remain controlled by your browser.</p><label>Preferred destination<select id="save-destination"><option value="download">Download to this device</option><option value="site">Private site storage</option><option value="webdav">My WebDAV folder</option></select></label><button type="button" id="save-preferences" class="btn">Save preference</button><p id="preference-status" role="status"></p><h2>WebDAV</h2><p>Connect an existing HTTPS WebDAV folder, such as a Nextcloud folder. Test and save writes a temporary test file and removes it. Your app password is encrypted on the server and is never returned to this form.</p>
<p id="storage-status" role="status">Loading your connection…</p>
<form id="webdav-form" class="form" method="post" action="/api/storage/webdav"><label>WebDAV folder URL<input name="url" type="url" placeholder="https://cloud.example.com/remote.php/dav/files/username/Explore/" required /></label><label>Username<input name="username" autocomplete="username" required /></label><label>App password<input name="password" type="password" autocomplete="new-password" required /></label><button class="btn" type="submit">Test and save connection</button></form><button class="btn ghost" id="webdav-remove">Remove connection</button>
<h2>Google Drive and other providers</h2><p>Google Drive file access is not connected yet. Your Google site login does not grant access to Drive. Separate consent and a provider integration are required; no Drive access is requested by this page.</p></section>
</Base>
<script>
document.querySelector('#generate-storage-key')?.addEventListener('click',()=>{const bytes=crypto.getRandomValues(new Uint8Array(32));document.querySelector<HTMLInputElement>('#storage-key')!.value=btoa(String.fromCharCode(...bytes));});
document.querySelector('#copy-storage-key')?.addEventListener('click',async()=>{const input=document.querySelector<HTMLInputElement>('#storage-key')!;if(input.value)try{await navigator.clipboard.writeText(input.value);document.querySelector<HTMLElement>('#storage-status')!.textContent='Setup key copied. Save it in Netlify; it is not stored by this page.';}catch{input.focus();input.select();}});
const preferenceSelect=document.querySelector<HTMLSelectElement>('#save-destination')!,preferenceStatus=document.querySelector<HTMLElement>('#preference-status')!;fetch('/api/storage/preferences',{cache:'no-store'}).then(async r=>{const p=await r.json();if(!r.ok)throw Error(p.error);preferenceSelect.value=p.defaultDestination;}).catch(e=>preferenceStatus.textContent=e.message);document.querySelector<HTMLButtonElement>('#save-preferences')!.onclick=async()=>{try{const r=await fetch('/api/storage/preferences',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({defaultDestination:preferenceSelect.value})});const p=await r.json();if(!r.ok)throw Error(p.error);preferenceStatus.textContent='Your default save destination is saved on your account.';}catch(e){preferenceStatus.textContent=e instanceof Error?e.message:'Preference could not be saved.';}};
const status=document.querySelector<HTMLElement>('#storage-status')!,form=document.querySelector<HTMLFormElement>('#webdav-form')!;
const show=data=>{status.textContent=data.connected?'WebDAV connected. You can copy private cloud files to this folder.':'No WebDAV connection saved.';if(data.url)(form.elements.namedItem('url') as HTMLInputElement).value=data.url;if(data.username)(form.elements.namedItem('username') as HTMLInputElement).value=data.username;};
fetch('/api/storage/webdav',{cache:'no-store'}).then(async r=>{const data=await r.json();if(!r.ok)throw Error(data.error);show(data);}).catch(e=>status.textContent=e.message);
form.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector('button')!;button.disabled=true;status.textContent='Testing secure connection…';const values=Object.fromEntries(new FormData(form));try{const r=await fetch('/api/storage/webdav',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(values)});const data=await r.json();if(!r.ok)throw Error(data.error);show(data);}catch(e){status.textContent=e instanceof Error?e.message:'Connection failed.';}finally{(form.elements.namedItem('password') as HTMLInputElement).value='';button.disabled=false;}});
document.querySelector('#webdav-remove')!.addEventListener('click',async()=>{try{const r=await fetch('/api/storage/webdav',{method:'DELETE'});if(!r.ok)throw Error('Connection could not be removed.');form.reset();show({connected:false});}catch(e){status.textContent=e instanceof Error?e.message:'Removal failed.';}});
</script>
<style>.storage-wrap{max-width:850px;padding-top:45px;padding-bottom:60px}.storage-wrap h1{font-size:44px}.storage-wrap h2{margin-top:35px}.storage-wrap button{margin:12px 0}</style>
