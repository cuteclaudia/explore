---
import Settings from '../../layouts/Settings.astro';
import {protectPage} from '../../../server/identity';
export const prerender=false;
const access=await protectPage('/studio/storage');if(access instanceof Response)return access;
Astro.response.headers.set('Cache-Control','private, no-store');
---

<Settings title="Files & storage settings" section="storage">
<section class="settings-section"><h2>Files & storage</h2><p>One set of storage connections for all your apps. Your private files and connections stay associated with your account.</p><div class="storage-destination"><label for="save-destination">Default save destination</label><select id="save-destination"><option value="download">Download to this device</option><option value="site">Private site storage</option><option value="webdav">My WebDAV folder</option></select><button type="button" id="save-preferences" class="btn">Save preference</button></div><p>Each export still asks you to save. A device folder is controlled by your browser, rather than stored on your account.</p><p id="preference-status" role="status"></p></section>
<section class="settings-section"><div class="connection-heading"><h2>WebDAV</h2><span class="connection-badge">File connection</span></div><p>Connect your existing HTTPS WebDAV account. Kōbō uses a separate folder for each app; the current editors can also copy exports to this connection.</p><p id="storage-status" role="status">Checking connection…</p><details class="connection-details"><summary>Connection details</summary><form id="webdav-form" class="form" method="post" action="/api/storage/webdav"><label>Connection name<input name="label" maxlength="120" placeholder="My kDrive" /></label><label>WebDAV account/folder URL<input name="url" type="url" placeholder="https://cloud.example.com/remote.php/dav/files/username/Explore/" required /></label><label>Kōbō base folder<input name="baseFolder" value="Kobo" placeholder="Kobo" /><small>Relative to the URL above. Hikari uses Kobo/Hikari. Leave blank if the URL already ends in /Kobo/.</small></label><label>Username<input name="username" autocomplete="username" required /></label><label>App password<input name="password" type="password" autocomplete="new-password" required /></label><div class="connection-actions"><button class="btn" type="submit">Test & save</button><button type="button" class="btn ghost" id="webdav-remove">Disconnect</button></div></form><p>The test writes and removes a temporary file. Your app password is encrypted and is never returned to this form.</p></details><h3>Experimental Kōbō sync</h3><p>After connecting, test conditional saves, metadata, read-back and safe deletion. This creates temporary files under the Hikari folder. Passing this connection check does not complete the app’s full acceptance tests.</p><button type="button" id="verify-kobo">Test Kōbō sync connection</button><p id="kobo-verification" role="status"></p></section>
<section class="settings-section"><h2>Other file providers</h2><p>Google Drive and OneDrive are not connected yet. Signing into Explore with Google does not grant access to your Drive files.</p></section>
{access.isOwner&&<details class="admin-storage"><summary>Administrator setup</summary><p>First time only: generate a key for FILE_STORAGE_ENCRYPTION_KEY in Netlify. Keep an existing key unchanged to preserve saved connection credentials.</p><button type="button" id="generate-storage-key" class="btn ghost">Generate setup key</button><label>New encryption key<input id="storage-key" type="password" readonly autocomplete="off" /></label><button type="button" id="copy-storage-key" class="btn ghost">Copy key</button></details>}
</Settings>
<script>
document.querySelector('#generate-storage-key')?.addEventListener('click',()=>{const bytes=crypto.getRandomValues(new Uint8Array(32));document.querySelector<HTMLInputElement>('#storage-key')!.value=btoa(String.fromCharCode(...bytes));});
document.querySelector('#copy-storage-key')?.addEventListener('click',async()=>{const input=document.querySelector<HTMLInputElement>('#storage-key')!;if(input.value)try{await navigator.clipboard.writeText(input.value);document.querySelector<HTMLElement>('#storage-status')!.textContent='Setup key copied. Save it in Netlify; it is not stored by this page.';}catch{input.focus();input.select();}});
const preferenceSelect=document.querySelector<HTMLSelectElement>('#save-destination')!,preferenceStatus=document.querySelector<HTMLElement>('#preference-status')!;fetch('/api/storage/preferences',{cache:'no-store'}).then(async r=>{const p=await r.json();if(!r.ok)throw Error(p.error);preferenceSelect.value=p.defaultDestination;}).catch(e=>preferenceStatus.textContent=e.message);document.querySelector<HTMLButtonElement>('#save-preferences')!.onclick=async()=>{try{const r=await fetch('/api/storage/preferences',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({defaultDestination:preferenceSelect.value})});const p=await r.json();if(!r.ok)throw Error(p.error);preferenceStatus.textContent='Your default save destination is saved on your account.';}catch(e){preferenceStatus.textContent=e instanceof Error?e.message:'Preference could not be saved.';}};
const status=document.querySelector<HTMLElement>('#storage-status')!,form=document.querySelector<HTMLFormElement>('#webdav-form')!;
const show=data=>{document.querySelector('.connection-details summary')!.textContent=data.connected?'Manage connection':'Connect WebDAV';status.textContent=data.connected?'WebDAV connected. You can copy private cloud files to this folder.':'No WebDAV connection saved.';if(data.url)(form.elements.namedItem('url') as HTMLInputElement).value=data.url;if(data.username)(form.elements.namedItem('username') as HTMLInputElement).value=data.username;if(typeof data.baseFolder==='string')(form.elements.namedItem('baseFolder') as HTMLInputElement).value=data.baseFolder;if(data.label)(form.elements.namedItem('label') as HTMLInputElement).value=data.label;document.querySelector<HTMLElement>('#kobo-verification')!.textContent=data.koboVerified?'Connection checks passed. Full app sync remains experimental.':'Kōbō sync has not been verified on this connection.';};
fetch('/api/storage/webdav',{cache:'no-store'}).then(async r=>{const data=await r.json();if(!r.ok)throw Error(data.error);show(data);}).catch(e=>status.textContent=e.message);
form.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector('button')!;button.disabled=true;status.textContent='Testing secure connection…';const values=Object.fromEntries(new FormData(form));try{const r=await fetch('/api/storage/webdav',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(values)});const data=await r.json();if(!r.ok)throw Error(data.error);show(data);}catch(e){status.textContent=e instanceof Error?e.message:'Connection failed.';}finally{(form.elements.namedItem('password') as HTMLInputElement).value='';button.disabled=false;}});
document.querySelector<HTMLButtonElement>('#verify-kobo')!.onclick=async()=>{const button=document.querySelector<HTMLButtonElement>('#verify-kobo')!,message=document.querySelector<HTMLElement>('#kobo-verification')!;button.disabled=true;message.textContent='Checking conditional writes and reading back a temporary file…';try{const r=await fetch('/api/storage/webdav/verify-kobo',{method:'POST'}),data=await r.json();if(!r.ok)throw Error(data.error||'Verification failed.');message.textContent='Connection checks passed. Full app sync remains experimental.';}catch(e){message.textContent=e instanceof Error?e.message:'Verification failed.';}finally{button.disabled=false;}};
document.querySelector('#webdav-remove')!.addEventListener('click',async()=>{try{const r=await fetch('/api/storage/webdav',{method:'DELETE'});if(!r.ok)throw Error('Connection could not be removed.');form.reset();show({connected:false});}catch(e){status.textContent=e instanceof Error?e.message:'Removal failed.';}});
</script>
<style>.storage-destination{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:25px 0 15px}.connection-heading{display:flex;align-items:center;justify-content:space-between;gap:16px}.connection-heading h2{margin:0}.connection-badge{font-size:11px;opacity:.6}.connection-details summary,.admin-storage summary{cursor:pointer;font-size:13px;padding:12px 0}.connection-details form{max-width:580px;margin-top:15px}.connection-actions{display:flex;gap:10px}.admin-storage{border:1px solid var(--border);border-radius:8px;padding:5px 18px}.admin-storage input{display:block;width:100%;margin:10px 0}.admin-storage button{margin:8px 8px 8px 0}</style>
