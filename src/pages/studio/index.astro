---
import {DESKTOP_TOOLS as CRAFT_TOOLS} from '../../../server/desktop-tools.mjs';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import AppCard from '../../components/AppCard.astro';
import {protectPage} from '../../../server/identity';
export const prerender=false;
const access=await protectPage('/studio');if(access instanceof Response)return access;
const available=Object.entries(CRAFT_TOOLS).filter(([id,tool])=>access.permissions[tool.capability]||access.permissions['desktop.'+id]);
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Base title="Your Studio" noindex><section class="wrap studio-home"><header class="studio-heading"><div><span class="eyebrow">Your creative space</span><h1>My Studio</h1><p>Stories, photographs, and whatever comes next.</p></div><a class="icon-control" href="/settings" aria-label="Settings" data-tooltip="Settings"><Icon name="settings"/></a></header>
{access.isOwner&&<section class="studio-section"><div class="studio-section-head"><h2>Writing & photography</h2><a href="/studio/content">View all <Icon name="arrow" size={15}/></a></div><div class="studio-content-grid">{[['journal','Journal','document','A moment, a place, a story.'],['essays','Essays & analysis','edit','Ideas with a wider perspective.'],['photography','Photography','image','Light, landscape and everything between.']].map(([id,title,icon,description])=><article><Icon name={icon} size={23}/><h3>{title}</h3><p>{description}</p><div><a href={'/studio/content/edit?collection='+id}><Icon name="plus" size={15}/>Create</a><a href={'/studio/content?collection='+id}>Manage <Icon name="arrow" size={15}/></a></div></article>)}</div></section>}
<section class="studio-section"><div class="studio-section-head"><h2>Your SoraSpace apps</h2><a href="/apps">Open app library <Icon name="arrow" size={15}/></a></div><div class="studio-app-grid">{available.map(([id,tool])=><AppCard id={id} tool={tool} canOpen={!tool.desktopOnly&&access.permissions[tool.capability]} betaAccess={tool.slug==='hikari'&&access.permissions['beta.hikari']&&access.permissions[tool.capability]}/>)}</div><p class="studio-note">Your enabled apps and desktop downloads appear here. Save information is available inside each app.</p>{!available.length&&<p class="studio-note">No apps have been enabled on your account yet.</p>}</section>
<section class="studio-section"><div class="studio-section-head"><h2>Trips & events</h2><a href="/trips?view=mine">View entries <Icon name="arrow" size={15}/></a></div><p class="studio-note">Your entries stay private. Claudia’s published events are visible to everyone.</p>{access.permissions['trips.manage_own']&&<a class="btn ghost" href="/trips?new=1"><Icon name="plus" size={15}/>Add trip or event</a>}</section><footer class="studio-shortcuts">{access.isOwner&&<a href="/studio/content?collection=cyber">Cyber reports</a>}{access.isOwner&&<a href="/studio/content?collection=osint">OSINT Brief</a>}<a href="/settings">Settings</a>{access.isOwner&&<a href="/studio/downloads">Desktop installers</a>}{access.isOwner&&<a href="/studio/users">User permissions</a>}{access.isOwner&&<a href="/studio/kobo-test">SoraSpace integration test</a>}{access.isOwner&&<a href="/studio/irodori-test">Irodori preview</a>}{access.isOwner&&<a href="/studio/about">Edit About</a>}</footer>
</section></Base>
<style>.studio-home{max-width:1140px;padding-top:24px;padding-bottom:40px}.studio-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}.studio-heading h1{font-family:var(--serif);font-size:34px;font-weight:450;margin:8px 0}.studio-heading p{font-size:15px;opacity:.65;margin:0}.studio-section{margin:0 0 28px}.studio-section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.studio-section-head h2{font-family:var(--serif);font-size:23px;font-weight:450;margin:0}.studio-section-head>a,.studio-content-grid article a{display:inline-flex;align-items:center;gap:8px;text-decoration:none;font-size:13px}.studio-content-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.studio-content-grid article{border-top:1px solid var(--border);padding:16px 8px 12px 0}.studio-content-grid article>svg{color:var(--accent)}.studio-content-grid h3{font-size:18px;font-weight:500;margin:14px 0 8px}.studio-content-grid p{font-size:13px;opacity:.65;min-height:40px;max-width:30ch}.studio-content-grid article>div{display:flex;gap:28px;margin-top:14px}.studio-app-grid{display:grid;grid-template-columns:1fr 1fr;column-gap:28px}.studio-note{font-size:12px;opacity:.6;margin-top:14px}.studio-shortcuts{display:flex;flex-wrap:wrap;gap:25px;border-top:1px solid var(--border);padding-top:16px}.studio-shortcuts a{font-size:12px;text-decoration:none}@media(max-width:650px){.studio-content-grid{grid-template-columns:1fr}.studio-content-grid p{min-height:0}.studio-app-grid{grid-template-columns:1fr}.studio-heading h1{font-size:30px}.studio-section-head>a{font-size:11px}}</style>
