---
import Workspace from '../../layouts/KoboWorkspace.astro';
import {protectPage} from '../../../server/identity';
import {SORASPACE_SERVICES} from '../../lib/soraspace-services.mjs';
export const prerender=false;
const actor=await protectPage('/studio/soraspace-controls','settings.manage');if(actor instanceof Response)return actor;
if(!actor.isOwner)return new Response('Owner access required.',{status:403});
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Workspace actor={actor} title="Launch & trial controls"><section id="launch-controls" class="launch-controls"><a href="/studio/soraspace-admin">← SoraSpace Administration</a><h1>Launch &amp; tester trials</h1><p>Open public registration and trials when you are ready. Invite selected testers first, choose their services and extend their access without changing permanent grants.</p><button type="button" id="controls-reload">Reload latest</button><p id="controls-status" role="status">Loading launch controls…</p>
<form id="rollout-form"><fieldset disabled><legend>SoraSpace launch switches</legend><label><input type="checkbox" name="signupOpen"/> Public signup open</label><label><input type="checkbox" name="publicTrialsOpen"/> Public trials open</label><label><input type="checkbox" name="testerTrialsOpen"/> New selected-tester trials and invitations enabled</label><label>Default public trial days<input type="number" name="defaultDays" min="1" max="365" value="30" required/></label><div class="trial-choices"><strong>Services available to public trials</strong>{Object.entries(SORASPACE_SERVICES).map(([id,s])=><label><input type="checkbox" name="publicServices" value={id}/>{s.name}</label>)}</div><p class="note">Public trials require a verified account and an explicit Start trial action. Closing either trial switch does not cancel active trials. Netlify email-confirmation and registration setup must still be ready.</p><label>Reason for change<input name="reason" maxlength="300" required/></label><button type="submit">Save launch switches</button></fieldset></form>
<form id="storefront-form"><fieldset disabled><legend>HobbyNest shop sections</legend><label><input type="checkbox" name="physicalOpen"/> Physical shop open</label><label><input type="checkbox" name="digitalOpen"/> Digital shop open</label><label>Physical paused message<input name="physicalMessage" maxlength="200" required/></label><label>Digital paused message<input name="digitalMessage" maxlength="200" required/></label><p class="note">These are the existing catalogue/test-order section switches. Opening them does not enable live purchases, charge a basket or deliver paid files.</p><button type="submit">Save HobbyNest switches</button><a href="/studio/hobbynest">Full HobbyNest administration →</a></fieldset></form>
<section class="checkout-readiness"><h2>Paid checkout</h2><label><input type="checkbox" disabled/> SoraSpace subscriptions — not connected</label><label><input type="checkbox" disabled/> HobbyNest payments — not connected</label><p>Payment-provider integration, signed events, fulfilment and release checks must pass before these can be enabled. Free tester trials do not charge anyone.</p></section>
<form id="tester-form"><fieldset disabled><legend>Individual tester access</legend><label>Tester account<select name="account" required><option value="">Choose a registered tester</option></select></label><p id="tester-current" role="status">Choose an account to see its trial.</p><label>Action<select name="action"><option value="start">Start a new trial</option><option value="extend">Extend / reactivate an existing trial</option><option value="revoke">Stop trial access</option></select></label><label>Trial days / additional days<input name="days" type="number" min="1" max="365" value="30" required/></label><div class="trial-choices"><strong>Services for a new trial</strong>{Object.entries(SORASPACE_SERVICES).map(([id,s])=><label><input type="checkbox" name="services" value={id} checked={id==='website'}/>{s.name}</label>)}</div><label>Reason<input name="reason" maxlength="300" required/></label><p class="note">An extension adds days from the later of now or the existing expiry. It can restore expired/revoked trial access. Suspension still blocks access. Existing permanent permissions and files remain intact.</p><button type="submit">Save tester trial</button><a href="/studio/users">Manage permanent permissions →</a></fieldset></form>
<form id="invitation-form"><fieldset disabled><legend>Invite a selected tester</legend><label>Tester email<input name="email" type="email" maxlength="254" required/></label><label>Trial days<input name="days" type="number" min="1" max="365" value="30" required/></label><div class="trial-choices"><strong>Invited services</strong>{Object.entries(SORASPACE_SERVICES).map(([id,s])=><label><input type="checkbox" name="services" value={id} checked={id==='website'}/>{s.name}</label>)}</div><label>Reason<input name="reason" maxlength="300" required/></label><p class="note">The link is tied to this email and can be claimed within 14 days. Trial time starts after the tester verifies that email and activates the invitation. We create the link here; you review and send the invitation using your email application.</p><button type="submit">Create tester invitation</button></fieldset></form>
<div id="invitation-result" hidden><label>Invitation link<input id="invitation-url" readonly/></label><button type="button" id="invitation-copy">Copy link</button><a id="invitation-compose">Compose invitation email</a><p>Not sent automatically. Keep this link private; it is shown only when created.</p></div>
<p class="note">Trial expiry is enforced on server requests and refreshed access checks. It does not remotely stop an already-installed offline desktop app. Trial expiry does not delete stored work; account-wide recovery/export after expiry still needs its separate release checks.</p></section></Workspace>
<script>import '../../scripts/soraspace-controls.mjs';</script>
<style>.launch-controls{max-width:960px;font:14px/1.5 system-ui}.launch-controls h1{font:600 28px system-ui;margin:14px 0 10px}.launch-controls>p{font-size:13px}.launch-controls form{margin-block:14px}.launch-controls fieldset,.checkout-readiness,#invitation-result{border:1px solid var(--border);border-radius:7px;padding:14px;background:var(--surface)}.launch-controls legend{font-weight:600;padding-inline:5px}.launch-controls label{display:flex;align-items:center;gap:8px;margin:8px 0;flex-wrap:wrap;min-height:32px;font-size:13px}.launch-controls input:not([type=checkbox]),.launch-controls select{min-height:44px;padding:8px;border:1px solid var(--border);border-radius:5px;background:var(--bg);color:var(--text);font:14px system-ui;max-width:100%;min-width:0}.launch-controls input:not([type=checkbox]){flex:1;min-width:100px}.launch-controls input[type=number]{max-width:100px}.launch-controls input[type=checkbox]{width:18px;height:18px;flex-shrink:0}.launch-controls button{min-height:44px;padding:8px 12px;font:13px system-ui;border:1px solid var(--border);border-radius:5px;color:inherit;background:var(--surface);cursor:pointer}.launch-controls button:disabled{opacity:.5;cursor:default}.launch-controls a{display:inline-flex;align-items:center;min-height:44px;font-size:12px;margin-right:12px}.launch-controls .note,.checkout-readiness p,#invitation-result p{font-size:12px;opacity:.75}.trial-choices{display:flex;gap:4px 16px;flex-wrap:wrap}.trial-choices strong{flex-basis:100%;font-size:12px}.checkout-readiness h2{font-size:17px;margin:0}#invitation-url{width:100%}.launch-controls [hidden]{display:none!important}@media(max-width:550px){.launch-controls h1{font-size:24px}.launch-controls fieldset{padding:10px}.launch-controls label{align-items:flex-start}.launch-controls select{width:100%}}</style>
