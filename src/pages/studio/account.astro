---
import Settings from '../../layouts/Settings.astro';
import { protectPage } from '../../../server/identity';
export const prerender=false;
const access=await protectPage('/studio/account');
if(access instanceof Response)return access;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Settings title="Sign-in & security settings" section="security">
  <section class="account-wrap">
    <h2>Sign-in & security</h2>
    <p>Signed in as <strong>{access.user.email}</strong>.</p>
    {access.isOwner&&<p>Your owner account has access to every site capability.</p>}
    <section id="google" class="settings-section">
      <h2 class="serif">Google sign-in</h2>
      <p>Use the Google account whose verified email is <strong>{access.user.email}</strong>. Netlify matches that verified address to your existing Identity account, so your access stays attached to the same user ID.</p>
      <p>This does not merge an unrelated Gmail address into your account.</p>
      <p id="google-status" role="status">Checking Google availability…</p>
      <a class="btn" id="account-google" href="/studio/login?provider=google" hidden>Continue with Google</a>
      <p id="google-disabled" hidden>Google sign-in is not enabled for this site yet.{access.isOwner&&' In Netlify, open Identity → Registration → External providers → Add provider → Google.'}</p>
    </section>
    <section class="settings-section"><h2 class="serif">Password</h2><p>You can continue using your email and password alongside Google sign-in.</p><button class="btn ghost" id="account-reset" data-email={access.user.email}>Send password reset email</button><p id="account-reset-status" role="status"></p></section>
  </section>
</Settings>
<script>
  import {getSettings,requestPasswordRecovery} from '@netlify/identity';
  const status=document.querySelector<HTMLElement>('#google-status')!;
  getSettings().then(settings=>{const enabled=settings.providers.google;document.querySelector<HTMLAnchorElement>('#account-google')!.hidden=!enabled;document.querySelector<HTMLElement>('#google-disabled')!.hidden=enabled;status.textContent=enabled?'Google sign-in is available.':'Google sign-in is not enabled.';}).catch(()=>{status.textContent='Google availability could not be checked. Please try again.';});
  const reset=document.querySelector<HTMLButtonElement>('#account-reset')!;
  reset.addEventListener('click',async()=>{const message=document.querySelector<HTMLElement>('#account-reset-status')!;reset.disabled=true;try{await requestPasswordRecovery(reset.dataset.email!);message.textContent='A password reset email has been requested. Check your inbox.';}catch{message.textContent='The reset email could not be requested. Please try again.';}finally{reset.disabled=false;}});
</script>
<style>.account-wrap{max-width:100%}.account-wrap>p{margin-bottom:14px}.account-wrap section{padding-top:12px}.account-wrap .btn{margin-top:8px}</style>
