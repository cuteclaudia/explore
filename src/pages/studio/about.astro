---
import Base from '../../layouts/Base.astro';
import {protectPage} from '../../../server/identity';
export const prerender=false;
const access=await protectPage('/studio/about','settings.manage');if(access instanceof Response)return access;
if(!access.isOwner)return new Response('Owner access required.',{status:403});
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Base title="Edit About Claudia" noindex><section class="wrap about-editor"><a href="/studio">← My Studio</a><header><h1>Edit About Claudia</h1><p id="about-status" role="status">Opening your page…</p></header>
<form id="about-form" hidden><details class="page-metadata"><summary>Page title & description</summary><div class="page-details"><label>Page title<input id="about-title" maxlength="250" required/></label><label>Short description<input id="about-summary" maxlength="3000"/></label></div></details>
<div class="builder"><aside><details id="about-sections"><summary>Page sections</summary><p class="help">Arrange sections with the arrows. Select one to edit.</p><div id="section-list"></div><div class="add-sections"><button type="button" data-add="text">＋ Text</button><button type="button" data-add="split">＋ Text & image</button><button type="button" data-add="image">＋ Image</button></div></details></aside>
<section id="section-settings"><div class="section-options"><label>Section heading<input id="block-title" maxlength="200"/></label><label>Width<select id="block-width"><option value="reading">Reading width</option><option value="wide">Wide</option></select></label></div>
<div id="text-settings"><div class="format-bar"><label>Font<select id="font-family"><option value="">Site font</option><option value="Arial, sans-serif">Sans serif</option><option value="Georgia, serif">Serif</option><option value="monospace">Monospace</option></select></label><label>Size<select id="font-size"><option value="">Default</option>{[12,14,16,18,20,24,28,32,40,48].map(n=><option value={n+'px'}>{n}</option>)}</select></label><button type="button" data-format="bold" title="Bold"><b>B</b></button><button type="button" data-format="italic" title="Italic"><i>I</i></button><button type="button" data-format="heading" title="Heading">H2</button><button type="button" data-format="bulletList" title="Bulleted list">• List</button><button type="button" data-format="link">Link</button><label>Align<select id="text-align"><option value="left">Left</option><option value="center">Centre</option><option value="right">Right</option><option value="justify">Justify</option></select></label><label>Spacing<select id="line-height"><option value="">Default</option><option value="1.3">1.3</option><option value="1.5">1.5</option><option value="1.7">1.7</option><option value="2">2</option></select></label></div><div id="about-rich-editor"></div></div>
<details id="image-settings"><summary>Section photograph</summary><div class="image-fields"><img id="block-preview" alt="Selected section photograph" hidden/><label>Upload a replacement<input id="block-upload" type="file" accept="image/jpeg,image/png,image/webp"/></label><label>Or image address<input id="block-image" placeholder="HTTPS image URL"/></label><label>Description (alt text)<input id="block-alt" maxlength="1000"/></label><label>Caption / credit<input id="block-caption" maxlength="2000"/></label><label>Image position<select id="block-side"><option value="left">Left of text</option><option value="right">Right of text</option></select></label><button type="button" id="remove-image">Remove image</button><p class="help">Uploads are resized to 2400 px and camera/GPS metadata is removed.</p></div></details>
<button type="button" id="remove-section">Remove section</button></section></div>
<footer class="about-actions"><button class="btn" type="submit">Save draft</button><button class="btn ghost" type="button" id="about-preview">Preview</button><button class="btn" type="button" id="about-publish">Publish</button><a href="/about" target="_blank" rel="noopener">View public page ↗</a><small>Only publishing changes the public page.</small></footer></form></section></Base>
<script>import '../../scripts/about-editor';</script>
<style>.about-editor{max-width:1180px;padding:20px 24px 32px}.about-editor>a{font-size:12px}.about-editor header{display:flex;align-items:baseline;gap:20px;margin:12px 0}.about-editor h1{font:450 30px var(--serif);margin:0}.about-editor header p,.help{font-size:12px;opacity:.7}.page-details{display:grid;grid-template-columns:1fr 1.4fr;gap:18px;margin-bottom:14px}.about-editor label{display:block;font-size:12px}.about-editor input,.about-editor select{display:block;width:100%;box-sizing:border-box;padding:8px;margin:5px 0 12px;border:1px solid var(--border);border-radius:5px;background:var(--surface);color:var(--text)}.builder{display:grid;grid-template-columns:240px minmax(0,1fr);gap:20px}.builder h2{font-size:17px;margin:0}.about-editor button:not(.btn){background:transparent;border:1px solid var(--border);border-radius:4px;padding:6px 9px;color:var(--text);cursor:pointer;font-size:12px}.add-sections{display:flex;flex-wrap:wrap;gap:6px;margin-top:16px}#section-list :global(article){padding:9px 0;border-bottom:1px solid var(--border);display:flex;gap:4px}#section-list :global(button:first-child){flex:1;text-align:left}#section-list :global(button[aria-current=true]){background:var(--surface);font-weight:600;border-color:var(--accent)}.section-options{display:grid;grid-template-columns:1fr 140px;gap:15px}.format-bar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;background:var(--surface);padding:8px;border:1px solid var(--border)}.format-bar label{display:flex;align-items:center;gap:4px;font-size:11px}.format-bar select{width:auto;margin:0;padding:5px}.format-bar button{height:30px}#about-rich-editor{background:var(--surface);border:1px solid var(--border);border-top:0;padding:18px}#about-rich-editor :global(.tiptap){min-height:260px;font-size:16px;line-height:1.6;outline:none}#about-rich-editor :global(p){margin:0 0 .8em}#image-settings{border-top:1px solid var(--border);margin:18px 0;padding-top:12px}#image-settings summary{cursor:pointer;font-size:13px}.image-fields{padding-top:12px}#block-preview{width:180px;max-height:160px;object-fit:cover;margin-bottom:10px}#remove-section{margin-top:14px}.about-actions{position:sticky;bottom:0;background:var(--bg);border-top:1px solid var(--border);margin-top:24px;padding:12px 0;display:flex;align-items:center;gap:9px;flex-wrap:wrap}.about-actions .btn{padding:7px 12px;font-size:12px}.about-actions a,.about-actions small{font-size:11px}.about-actions small{margin-left:auto;opacity:.6}@media(max-width:700px){.builder{grid-template-columns:1fr}.page-details{grid-template-columns:1fr}.about-editor header{display:block}.about-actions small{display:none}.section-options{grid-template-columns:1fr 110px}}.page-metadata{border-block:1px solid var(--border);margin-bottom:14px}.page-metadata>summary,#about-sections>summary{font-size:13px;cursor:pointer;padding:10px 0;min-height:40px}.page-metadata .page-details{margin-top:10px}.builder>aside,#section-settings{min-width:0}#section-list :global(button){min-width:0;overflow-wrap:anywhere}.format-bar label{min-width:0}.format-bar select{max-width:150px}@media(max-width:700px){.about-editor{padding:18px 16px 28px}.builder{gap:12px}#about-sections{border-bottom:1px solid var(--border)}.section-options{gap:10px;grid-template-columns:minmax(0,1fr) 115px}.about-actions{padding:8px 0}.about-actions small{display:none}}</style>
