---
import Base from '../../../layouts/Base.astro';
import {protectPage} from '../../../../server/identity';
export const prerender=false;
const access=await protectPage('/studio/content/edit'+Astro.url.search,'articles.edit_any');if(access instanceof Response)return access;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Base title="Content editor" noindex>
<section class="wrap content-editor"><div class="editor-top"><a href="/studio/content">← Writing & photography</a><span class="eyebrow" id="editor-section">Your content</span></div><header class="editor-heading"><h1 id="editor-heading">Create & edit</h1><p id="editor-status" role="status">Opening your editor…</p></header>
<form id="content-form" hidden>
<label class="title-field">Title<input id="entry-title" required maxlength="250" placeholder="Give your story a title"/></label>
<div class="editor-layout"><main class="editor-writing"><div class="rich-toolbar" role="toolbar" aria-label="Article formatting">
<label class="sr-only" for="font-family">Font family</label><select id="font-family" title="Font family"><option value="">Site font</option><option value="Arial, sans-serif">Sans serif</option><option value="Georgia, serif">Serif</option><option value="monospace">Monospace</option></select>
<label class="sr-only" for="font-size">Font size</label><select id="font-size" title="Font size"><option value="">Size</option>{[12,14,16,18,20,24,28,32,40,48].map(n=><option value={n+'px'}>{n}</option>)}</select>
<button type="button" data-command="bold" aria-label="Bold" title="Bold"><b>B</b></button><button type="button" data-command="italic" aria-label="Italic" title="Italic"><i>I</i></button><button type="button" data-command="underline" aria-label="Underline" title="Underline"><u>U</u></button>
<button type="button" data-command="heading2" title="Heading">H2</button><button type="button" data-command="heading3" title="Subheading">H3</button><button type="button" data-command="paragraph" title="Paragraph">¶</button>
<label class="sr-only" for="text-align">Text alignment</label><select id="text-align" title="Text alignment"><option value="left">Left</option><option value="center">Centre</option><option value="right">Right</option><option value="justify">Justify</option></select>
<label class="sr-only" for="line-height">Line spacing</label><select id="line-height" title="Line spacing"><option value="">Spacing</option><option value="1.3">1.3</option><option value="1.5">1.5</option><option value="1.7">1.7</option><option value="2">2</option></select>
<button type="button" data-command="bullet" title="Bullets">• List</button><button type="button" data-command="numbered" title="Numbered list">1. List</button><button type="button" data-command="quote" title="Quote">❞</button><button type="button" data-command="link" title="Add link">Link</button><button type="button" data-command="unlink" title="Remove link">Unlink</button>
<details class="toolbar-more"><summary>More</summary><div><button type="button" data-command="table">Table</button><button type="button" data-command="row">Add row</button><button type="button" data-command="column">Add column</button><button type="button" data-command="deleteTable">Remove table</button></div></details><button type="button" data-command="undo" title="Undo" aria-label="Undo">↶</button><button type="button" data-command="redo" title="Redo" aria-label="Redo">↷</button>
</div><h2 id="body-label" class="sr-only">Article</h2><div id="rich-editor"></div><p class="editor-help">Paste text to begin. Open Photos to upload images; double-click an inserted image to edit it.</p><section id="gallery-section"><h2>Gallery photographs</h2><p class="editor-help">Edit captions, tags and images. Move photographs up or down to arrange them.</p><div id="gallery-photos"></div></section></main>
<aside class="editor-sidebar"><details class="editor-panel"><summary>Details</summary><div class="panel-body"><label>URL name<input id="entry-slug" required pattern="[a-z0-9][a-z0-9-]*" maxlength="200"/><small>Fixed after the first save.</small></label><label>Date<input id="entry-date" type="date" required/></label><label>Tags<input id="entry-tags" placeholder="Japan, Travel, Photography"/><small>Separate tags with commas.</small></label><label>Location<input id="entry-location" maxlength="250"/></label><label>Location visibility<select id="entry-precision"><option value="hidden">Hidden</option><option value="approximate">Approximate · enter a broad area</option><option value="exact">Show the location as entered</option></select></label><label>Summary<textarea id="entry-summary" rows="3" maxlength="3000"></textarea></label></div></details>
<details class="editor-panel"><summary>Cover</summary><div class="panel-body"><div id="cover-preview"></div><label>Cover image address<input id="entry-cover" type="text" placeholder="Upload a cover or paste an HTTPS URL"/></label><label>Image description<input id="entry-cover-alt" maxlength="1000"/></label><button type="button" class="btn ghost" id="clear-cover">Remove cover</button></div></details>
<details class="editor-panel" id="photos-panel"><summary>Photos</summary><div class="panel-body"><label>Add photographs<input id="content-images" type="file" accept="image/jpeg,image/png,image/webp" multiple/></label><label>Use as<select id="image-purpose"><option value="inline">In the article</option><option value="cover">Cover photograph</option><option value="gallery">Gallery photographs</option></select></label><p class="editor-help">Images are resized to 2400 px and camera/GPS metadata is removed. They stay private until published.</p></div></details></aside></div>
<div class="save-actions"><button type="submit" class="btn" id="save-draft">Save draft</button><button type="button" class="btn ghost" id="preview-draft">Preview</button><button type="button" class="btn" id="publish-entry">Publish</button><button type="button" class="btn ghost" id="unpublish-entry">Unpublish</button><button type="button" class="btn ghost" id="copy-entry" hidden>Copy</button><button type="button" class="btn ghost" id="delete-entry" hidden>Delete</button><a id="view-entry" target="_blank" rel="noopener" hidden>View published →</a><small>Drafts stay private. Publish when ready.</small></div>
</form>
<dialog id="photo-edit-dialog"><h2>Edit photograph</h2><canvas id="content-photo-canvas" aria-label="Photograph edit preview"></canvas><div class="editor-fields"><label>Crop<select id="edit-crop"><option value="0">Original proportions</option><option value="1">Square</option><option value="1.3333333333">Landscape 4:3</option><option value="0.8">Portrait 4:5</option></select></label><label>Brightness<input id="edit-brightness" type="range" min="50" max="150" value="100"/></label><label>Contrast<input id="edit-contrast" type="range" min="50" max="150" value="100"/></label><label>Colour<input id="edit-colour" type="range" min="0" max="200" value="100"/></label></div><button type="button" class="btn ghost" id="edit-rotate">Rotate 90°</button><button type="button" class="btn ghost" id="edit-flip">Flip</button><button type="button" class="btn ghost" id="edit-reset">Reset</button><button type="button" class="btn" id="edit-apply">Use edited photograph</button><button type="button" class="btn ghost" id="edit-cancel">Cancel</button><p id="photo-edit-status" role="status"></p></dialog>
</section>
</Base>
<script>import '../../../scripts/content-editor';</script>
<style>
.content-editor{max-width:1240px;padding:22px 24px 45px}.editor-top{display:flex;align-items:center;justify-content:space-between;font-size:12px}.editor-heading{display:flex;align-items:baseline;gap:20px;margin:12px 0 16px}.editor-heading h1{font:450 30px var(--serif);margin:0}.editor-heading p{margin:0;font-size:12px;opacity:.7}.title-field{font-size:12px;display:block;margin-bottom:14px}.title-field input{font:450 25px var(--serif)!important}.editor-layout{display:grid;grid-template-columns:minmax(0,1fr) 255px;gap:20px}.editor-writing{min-width:0}.content-editor input:not([type=range]),.content-editor textarea,.content-editor select{width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:5px;background:var(--surface);color:var(--text);box-sizing:border-box;font:13px system-ui;margin-top:5px}.editor-panel{border-top:1px solid var(--border);font-size:12px}.editor-panel summary{cursor:pointer;padding:14px 0;font-weight:500}.panel-body{padding-bottom:15px}.panel-body label{display:block;margin:10px 0}.panel-body small,.editor-help{font-size:11px;line-height:1.5;opacity:.65;display:block}.rich-toolbar{position:sticky;top:0;z-index:5;display:flex;gap:3px;align-items:center;flex-wrap:wrap;padding:7px;background:var(--surface);border:1px solid var(--border);border-radius:6px 6px 0 0}.rich-toolbar button,.rich-toolbar select,.rich-toolbar summary{font-size:12px;padding:5px 7px;min-height:29px;border:1px solid transparent;border-radius:4px;background:transparent;color:var(--text);cursor:pointer;margin:0;width:auto}.rich-toolbar button:hover{border-color:var(--border)}.rich-toolbar button[aria-pressed=true]{background:var(--accent);color:var(--on-accent)}.toolbar-more{position:relative}.toolbar-more>div{position:absolute;background:var(--surface);border:1px solid var(--border);padding:6px;min-width:110px}.toolbar-more button{display:block}#rich-editor{background:var(--surface);border:1px solid var(--border);border-top:0;padding:20px 25px}#rich-editor :global(.tiptap){min-height:46vh;outline:none;font-size:16px;line-height:1.6}#rich-editor :global(.tiptap p){margin:0 0 .65em}#rich-editor :global(img){max-width:100%;height:auto}#rich-editor :global(table){border-collapse:collapse;width:100%}#rich-editor :global(td),#rich-editor :global(th){border:1px solid var(--border);padding:7px}#rich-editor :global(blockquote){border-left:3px solid var(--accent);padding-left:16px}.save-actions{display:flex;align-items:center;gap:7px;flex-wrap:wrap;position:sticky;bottom:0;z-index:4;background:var(--bg);border-top:1px solid var(--border);padding:12px 0;margin-top:16px}.save-actions small{margin-left:auto;font-size:11px;opacity:.6}.save-actions .btn{font-size:12px;min-height:32px;padding:6px 10px}#cover-preview :global(img),#gallery-photos :global(img){max-width:100%;max-height:220px;border-radius:6px}#gallery-photos :global(article){border:1px solid var(--border);border-radius:6px;padding:14px;margin:14px 0}#photo-edit-dialog{width:min(900px,90vw);max-height:90vh;overflow:auto;background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:10px}#photo-edit-dialog::backdrop{background:#0009}#content-photo-canvas{max-width:100%;max-height:45vh}#photo-edit-dialog button{margin:5px}.editor-fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}@media(max-width:800px){.editor-layout{grid-template-columns:1fr}.editor-sidebar{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;order:-1}.editor-heading{display:block}.editor-heading p{margin-top:7px}}@media(max-width:520px){.content-editor{padding:16px}.editor-sidebar{display:block}#rich-editor{padding:15px}.editor-heading h1{font-size:26px}.save-actions small{display:none}.rich-toolbar select{max-width:100px}}
@media(max-width:800px){.editor-sidebar{display:flex;flex-wrap:wrap;gap:0 8px}.editor-sidebar .editor-panel{flex:1;min-width:0}.editor-sidebar .editor-panel[open]{flex-basis:100%;order:2}.editor-panel summary{padding:10px 6px;min-height:44px}.rich-toolbar{padding:5px;gap:3px}#rich-editor{padding:16px}.save-actions{padding:8px 0}.panel-body{padding-inline:4px}.editor-sidebar input,.editor-sidebar select{min-width:0}}
</style>
