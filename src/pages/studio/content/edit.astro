---
import Base from '../../../layouts/Base.astro';
import {protectPage} from '../../../../server/identity';
export const prerender=false;
const access=await protectPage('/studio/content/edit'+Astro.url.search,'articles.edit_any');if(access instanceof Response)return access;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Base title="Content editor" noindex>
<section class="wrap content-editor"><a href="/studio/content">← Writing & photography</a><header class="page-head"><span class="eyebrow" id="editor-section">Your content</span><h1 id="editor-heading">Create & edit</h1><p>Save drafts privately. Publish when you are ready for readers to see your changes.</p></header><p id="editor-status" role="status">Opening your editor…</p>
<form id="content-form" hidden>
<div class="editor-fields"><label>Title<input id="entry-title" required maxlength="250"/></label><label>URL name<input id="entry-slug" required pattern="[a-z0-9][a-z0-9-]*" maxlength="200"/><small>Fixed after the first save so existing links keep working.</small></label><label>Date<input id="entry-date" type="date" required/></label><label>Tags<input id="entry-tags" placeholder="Japan, Travel, Photography"/><small>Separate tags with commas.</small></label><label>Location<input id="entry-location" maxlength="250"/></label><label>Location visibility<select id="entry-precision"><option value="hidden">Hidden</option><option value="approximate">Approximate — enter a broad area</option><option value="exact">Show the location as entered</option></select></label></div>
<label>Summary<textarea id="entry-summary" rows="3" maxlength="3000"></textarea></label>
<fieldset><legend>Cover photograph</legend><div id="cover-preview"></div><label>Cover image address<input id="entry-cover" type="text" placeholder="Upload below or paste an HTTPS image URL"/></label><label>Cover description (alt text)<input id="entry-cover-alt" maxlength="1000"/></label><button type="button" class="btn ghost" id="clear-cover">Remove cover</button></fieldset>
<div class="upload-bar"><label>Add photographs <input id="content-images" type="file" accept="image/jpeg,image/png,image/webp" multiple/></label><label>Use as<select id="image-purpose"><option value="inline">In the article</option><option value="cover">Cover photograph</option><option value="gallery">Gallery photographs</option></select></label><p>Uploads are resized to at most 2400 pixels and re-encoded without the original camera/GPS metadata. They stay private until included in published content.</p></div>
<h2 id="body-label">Article</h2><div class="rich-toolbar" role="toolbar" aria-label="Article formatting">
<button type="button" data-command="bold">Bold</button><button type="button" data-command="italic">Italic</button><button type="button" data-command="underline">Underline</button><button type="button" data-command="heading2">Heading</button><button type="button" data-command="heading3">Subheading</button><button type="button" data-command="paragraph">Paragraph</button><button type="button" data-command="bullet">Bullets</button><button type="button" data-command="numbered">Numbered list</button><button type="button" data-command="quote">Quote</button><button type="button" data-command="link">Link</button><button type="button" data-command="unlink">Remove link</button><button type="button" data-command="table">Table</button><button type="button" data-command="row">Add row</button><button type="button" data-command="column">Add column</button><button type="button" data-command="deleteTable">Remove table</button><button type="button" data-command="undo">Undo</button><button type="button" data-command="redo">Redo</button>
</div><div id="rich-editor"></div><p class="muted">Use Add photographs above to insert images. Paste ordinary text or formatted text directly into the editor. Double-click an inserted photograph to edit it.</p>
<section id="gallery-section"><h2>Gallery photographs</h2><p>Edit the image, caption, description and tags. Use Move up/down to arrange photographs. Removing a photograph here changes the draft until you publish.</p><div id="gallery-photos"></div></section>
<div class="save-actions"><button type="submit" class="btn" id="save-draft">Save draft</button><button type="button" class="btn ghost" id="preview-draft">Preview saved draft</button><button type="button" class="btn" id="publish-entry">Publish</button><button type="button" class="btn ghost" id="unpublish-entry">Unpublish</button><button type="button" class="btn ghost" id="copy-entry" hidden>Make a copy</button><button type="button" class="btn ghost" id="delete-entry" hidden>Delete</button><a id="view-entry" target="_blank" rel="noopener" hidden>View published page →</a></div>
<p>Publishing updates the public page immediately without a GitHub login or a site rebuild. Saving a draft leaves the current published version unchanged.</p>
</form>
<dialog id="photo-edit-dialog"><h2>Edit photograph</h2><canvas id="content-photo-canvas" aria-label="Photograph edit preview"></canvas><div class="editor-fields"><label>Crop<select id="edit-crop"><option value="0">Original proportions</option><option value="1">Square</option><option value="1.3333333333">Landscape 4:3</option><option value="0.8">Portrait 4:5</option></select></label><label>Brightness<input id="edit-brightness" type="range" min="50" max="150" value="100"/></label><label>Contrast<input id="edit-contrast" type="range" min="50" max="150" value="100"/></label><label>Colour<input id="edit-colour" type="range" min="0" max="200" value="100"/></label></div><button type="button" class="btn ghost" id="edit-rotate">Rotate 90°</button><button type="button" class="btn ghost" id="edit-flip">Flip</button><button type="button" class="btn ghost" id="edit-reset">Reset</button><button type="button" class="btn" id="edit-apply">Use edited photograph</button><button type="button" class="btn ghost" id="edit-cancel">Cancel</button><p id="photo-edit-status" role="status"></p></dialog>
</section>
</Base>
<script>import '../../../scripts/content-editor';</script>
<style>
.content-editor{max-width:1100px;padding:40px 0 70px}.editor-fields{display:grid;grid-template-columns:1fr 1fr;gap:18px}.content-editor label{display:block;margin:14px 0}.content-editor input:not([type=range]),.content-editor textarea,.content-editor select{display:block;width:100%;padding:12px;margin-top:8px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text);box-sizing:border-box}.content-editor small{display:block;margin-top:5px}.content-editor fieldset{border:1px solid var(--border);border-radius:12px;padding:18px;margin:20px 0}.upload-bar{padding:20px;border:1px solid var(--border);border-radius:12px;margin:25px 0}.upload-bar p{font-size:14px}.rich-toolbar{position:sticky;top:0;z-index:5;display:flex;gap:5px;flex-wrap:wrap;padding:12px;background:var(--surface);border:1px solid var(--border)}.rich-toolbar button{padding:8px;border:1px solid var(--border);border-radius:5px;background:var(--bg);color:var(--text);cursor:pointer}.rich-toolbar button[aria-pressed=true]{background:var(--accent);color:white}#rich-editor{background:var(--surface);border:1px solid var(--border);padding:25px}#rich-editor :global(.tiptap){min-height:380px;outline:none;line-height:1.8}#rich-editor :global(img){max-width:100%;height:auto}#rich-editor :global(table){border-collapse:collapse;width:100%}#rich-editor :global(td),#rich-editor :global(th){border:1px solid var(--border);padding:8px}#rich-editor :global(blockquote){border-left:3px solid var(--accent);padding-left:20px}.save-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}#cover-preview :global(img),#gallery-photos :global(img){max-width:100%;max-height:320px;border-radius:10px}#gallery-photos :global(article){border:1px solid var(--border);border-radius:12px;padding:20px;margin:20px 0}#photo-edit-dialog{width:min(900px,90vw);max-height:90vh;overflow:auto;background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:15px}#photo-edit-dialog::backdrop{background:#0009}#content-photo-canvas{max-width:100%;max-height:45vh}#photo-edit-dialog button{margin:5px}@media(max-width:650px){.editor-fields{grid-template-columns:1fr}.content-editor{padding-left:16px;padding-right:16px}}
</style>
