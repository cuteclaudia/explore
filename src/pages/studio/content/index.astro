---
import Base from '../../../layouts/Base.astro';
import {protectPage} from '../../../../server/identity';
export const prerender=false;
const access=await protectPage('/studio/content','articles.edit_any');if(access instanceof Response)return access;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Base title="Writing & photography" noindex>
<section class="wrap content-library"><a href="/studio">← My Studio</a><header class="page-head"><span class="eyebrow">Your content</span><h1>Write, curate, publish.</h1><p>Create a draft or open existing content. Saved edits stay private until you publish them.</p></header>
<div class="actions"><a class="btn" href="/studio/content/edit?collection=journal">New journal article</a><a class="btn ghost" href="/studio/content/edit?collection=essays">New essay</a><a class="btn ghost" href="/studio/content/edit?collection=cyber">New cyber report</a><a class="btn ghost" href="/studio/content/edit?collection=osint">New OSINT brief</a><a class="btn" href="/studio/content/edit?collection=photography">New photo gallery</a></div>
{access.isOwner&&<details class="category-manager" data-category-owner={access.user.id}><summary>Writing categories</summary><p>Add, rename or delete the filters shown on Research &amp; analysis. Article addresses stay unchanged.</p><form id="category-create"><label>New category<input id="category-name" required maxlength="60"/></label><button class="btn" type="submit">Add category</button></form><div id="category-list"></div><p id="category-status" role="status">Loading categories…</p><button class="btn ghost" id="category-reload" type="button">Reload categories</button></details>}
{access.isOwner&&<details class="feature-manager" data-feature-owner={access.user.id}><summary>Pinned &amp; featured content</summary><p>Choose published content to highlight. Unpublished or deleted items stop appearing automatically.</p><form data-feature-slot="writing"><label>Pinned writing<select name="key" disabled><option value="">Loading…</option></select></label><button class="btn ghost" type="submit" disabled>Save writing pin</button></form><form data-feature-slot="home"><label>Home page feature<select name="key" disabled><option value="">Loading…</option></select></label><button class="btn ghost" type="submit" disabled>Save home feature</button></form><form data-feature-slot=""><label>Other page<select name="slot" disabled><option value="">Loading pages…</option></select></label><label>Highlight<select name="key" disabled><option value="">Loading…</option></select></label><button class="btn ghost" type="submit" disabled>Save page highlight</button></form><p id="feature-status" role="status">Loading featured content…</p><button class="btn ghost" id="feature-reload" type="button">Reload selections</button></details>}
<label>State <select id="content-state"><option value="active">Active content</option><option value="bin">Deleted items</option></select></label><label>Show <select id="content-filter"><option value="">All content</option><option value="journal">Journal</option><option value="essays">China Series</option><option value="cyber">Cyber reports</option><option value="osint">OSINT Brief</option><option value="photography">Photography</option></select></label><label>Search <input id="content-search" type="search" placeholder="Title or tag"/></label><p id="content-status" role="status">Loading your content…</p><div class="grid-3" id="content-items"></div>
</section>
</Base>
<script>
import '../../../scripts/writing-categories';
import '../../../scripts/content-features';
const state=document.querySelector<HTMLSelectElement>('#content-state')!;const filter=document.querySelector<HTMLSelectElement>('#content-filter')!,search=document.querySelector<HTMLInputElement>('#content-search')!,items=document.querySelector('#content-items')!,status=document.querySelector('#content-status')!;let records=[];
const selected=new URLSearchParams(location.search).get('collection');if(selected)filter.value=selected;
const labels={journal:'Journal',essays:'China Series',cyber:'Cyber report',osint:'OSINT Brief',photography:'Gallery'};
function draw(){items.replaceChildren();const shown=records.filter(r=>((state.value==='bin')===!!r.deletedAt)&&(!filter.value||r.collection===filter.value)&&(!search.value||[r.title,...r.tags].join(' ').toLowerCase().includes(search.value.toLowerCase())));for(const r of shown){const card=document.createElement('article');card.className='card';const body=document.createElement('div');body.className='body';const meta=document.createElement('p');meta.className='meta';meta.textContent=labels[r.collection]+' · '+(r.isPublished?(r.hasChanges?'Published · draft changes':'Published'):'Draft');const title=document.createElement('h2');title.className='serif';title.textContent=r.title;const tags=document.createElement('p');tags.textContent=r.tags.join(' · ');const link=document.createElement('a');link.className='btn';link.href='/studio/content/edit?entry='+encodeURIComponent(r.key);link.textContent='Edit '+(r.collection==='photography'?'gallery':'article')+' →';if(r.deletedAt){link.textContent='Restore as draft';link.href='#';link.onclick=async e=>{e.preventDefault();try{const result=await fetch('/api/content/manage?collection='+r.collection+'&slug='+encodeURIComponent(r.slug),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({version:r.version,action:'restore'})});const data=await result.json();if(!result.ok)throw Error(data.error);records=records.map(x=>x.key===r.key?{...x,...data,isPublished:false}:x);draw();}catch(error){status.textContent=error.message;}};}body.append(meta,title,tags,link);card.append(body);items.append(card);}status.textContent=shown.length+' items';}
let recordsRevision=0;
async function loadRecords(){const revision=++recordsRevision;try{const response=await fetch('/api/content/list',{cache:'no-store',signal:AbortSignal.timeout(15000)}),data=await response.json();if(revision!==recordsRevision)return;if(!response.ok)throw Error(data.error);records=data.filter(r=>r.collection!=='pages');draw();}catch(error){if(revision===recordsRevision)status.textContent=error.message;}}
void loadRecords();window.addEventListener('writing-categories-changed',()=>void loadRecords());filter.onchange=draw;state.onchange=draw;search.oninput=draw;
</script>
<style>.content-library{padding-block:20px 32px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:18px}.content-library label{display:inline-block;margin:0 16px 16px 0}.content-library select,.content-library input{padding:10px;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:8px}.content-library h2{font-size:26px}</style>

<style>.category-manager{margin:0 0 18px;border:1px solid var(--border);border-radius:8px;padding:12px}.category-manager summary{cursor:pointer;font-weight:600}.category-manager p{font-size:.9rem;margin:8px 0}.category-manager form,.category-manager :global(.category-row){display:flex;align-items:end;gap:8px;flex-wrap:wrap;margin:10px 0}.category-manager label{display:flex;flex-direction:column;margin:0;min-width:0;flex:1 1 180px}.category-manager input{width:100%;min-width:0}.category-manager :global(.category-row input){max-width:100%;min-width:0;flex:1 1 180px}.category-manager button{min-height:44px}</style>

<style>.category-manager :global(.category-item){border-bottom:1px solid var(--border);padding-bottom:6px}.category-manager :global(.category-delete){padding:10px;background:var(--surface);border:1px solid var(--border);border-radius:6px}.category-manager :global(.category-delete label){display:block;margin:8px 0}.category-manager :global(.category-delete select){display:block;width:100%;max-width:100%;min-width:0}.category-manager :global(.category-delete button){margin:4px 8px 4px 0}.category-manager :global(.category-delete p){overflow-wrap:anywhere}</style>

<style>.feature-manager{margin-bottom:18px;padding:12px;border:1px solid var(--border);border-radius:8px}.feature-manager summary{font-weight:600;cursor:pointer}.feature-manager p{font-size:13px;margin:8px 0}.feature-manager form{display:flex;align-items:end;gap:8px;margin:12px 0;flex-wrap:wrap}.feature-manager label{display:flex;flex:1 1 220px;flex-direction:column;gap:4px;margin:0;min-width:0}.feature-manager select{width:100%;min-width:0;max-width:100%}.feature-manager button{min-height:44px}</style>
