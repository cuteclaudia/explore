---
import Base from '../../layouts/Base.astro';
import { protectPage } from '../../../server/identity';
export const prerender=false;
const access=await protectPage('/studio/users','users.manage');
if(access instanceof Response)return access;
if(!access.isOwner)return new Response('Only the owner can manage access.',{status:403,headers:{'Cache-Control':'private, no-store'}});
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Base title="User permissions" description="Control access to your creative tools." noindex>
  <section class="wrap permissions-wrap"><a href="/studio">← Owner studio</a><h1 class="serif">People & permissions</h1><p>Your owner access is permanent and includes every feature. Community remains switched off. Grant individual app checkboxes to enable the separate My apps area; other users cannot edit your site or access your private Studio.</p><p id="users-status" role="status">Loading accounts…</p><div id="user-permissions"></div></section>
</Base>
<script>
  const status=document.querySelector<HTMLElement>('#users-status')!;
  const container=document.querySelector<HTMLElement>('#user-permissions')!;
  (async()=>{
    try{
      const response=await fetch('/api/studio/users',{cache:'no-store'});const data=await response.json();if(!response.ok)throw Error(data.error);
      for(const user of data.users){
        const form=document.createElement('form');form.className='access-card';
        const title=document.createElement('h2');title.textContent=user.email+(user.isOwner?' · Owner':'');form.append(title);
        const fields=document.createElement('fieldset');fields.disabled=user.isOwner;
        for(const [key,label] of Object.entries(data.capabilityLabels)){
          const row=document.createElement('label');const input=document.createElement('input');input.type='checkbox';input.name=key;input.checked=user.isOwner||user.capabilities[key]===true;input.disabled=!user.isOwner&&data.ownerOnlyCapabilities.includes(key);row.append(input,document.createTextNode(' '+String(label)+(data.ownerOnlyCapabilities.includes(key)?' · Owner only':'')));fields.append(row);
        }
        const row=document.createElement('label');const suspended=document.createElement('input');suspended.type='checkbox';suspended.name='suspended';suspended.checked=!user.isOwner&&user.suspended;row.append(suspended,document.createTextNode(' Suspend account access'));fields.append(row);form.append(fields);
        if(user.isOwner){const note=document.createElement('p');note.textContent='All features enabled. Owner permissions cannot be removed.';form.append(note);}else{
          const save=document.createElement('button');save.type='submit';save.className='btn';save.textContent='Save access';form.append(save);
          form.addEventListener('submit',async event=>{event.preventDefault();save.disabled=true;try{const capabilities=Object.fromEntries(Object.keys(data.capabilityLabels).map(key=>[key,(form.elements.namedItem(key) as HTMLInputElement).checked]));const result=await fetch('/api/studio/users/'+encodeURIComponent(user.id)+'/access',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({capabilities,suspended:suspended.checked})});const reply=await result.json();if(!result.ok)throw Error(reply.error);status.textContent='Access saved for '+user.email+'. App grants apply now; community remains off.';}catch(error){status.textContent=error instanceof Error?error.message:'Access could not be saved.';}finally{save.disabled=false;}});
        }
        container.append(form);
      }
      status.textContent=data.users.length+' account(s).';
    }catch(error){status.textContent=error instanceof Error?error.message:'Accounts could not be loaded.';}
  })();
</script>
<style>.permissions-wrap{padding-top:50px;padding-bottom:60px}.permissions-wrap h1{font-size:48px}.permissions-wrap :global(.access-card){margin:25px 0;padding:24px;background:var(--surface);border:1px solid var(--border);border-radius:16px}.permissions-wrap :global(fieldset){display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-bottom:20px;border:0;padding:0}.permissions-wrap :global(label){display:block}.permissions-wrap :global(input){width:18px;height:18px;accent-color:var(--accent)}.permissions-wrap :global(h2){overflow-wrap:anywhere}</style>
