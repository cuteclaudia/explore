---
import Base from '../../layouts/Base.astro';
import {protectPage} from '../../../server/identity';
export const prerender=false;
const access=await protectPage('/studio/users','users.manage');if(access instanceof Response)return access;
if(!access.isOwner)return new Response('Only the owner can manage access.',{status:403,headers:{'Cache-Control':'private, no-store'}});
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Base title="People & access" noindex><section class="wrap permissions-wrap"><a class="back-link" href="/studio">← My Studio</a><header class="people-heading"><div><h1>People & access</h1><p>Choose an app bundle, then desktop or web access. Fine-tune only when needed.</p></div><label class="people-search"><span class="sr-only">Find a person</span><input id="people-search" type="search" placeholder="Find a person…" /></label></header><p id="users-status" role="status">Loading accounts…</p><div id="user-permissions"></div><p class="access-footnote">Web access includes desktop. Access grants are manual; billing is not connected. Site administration stays owner-only.</p></section></Base>
<script>import '../../scripts/user-permissions';</script>
<style>.permissions-wrap{max-width:1140px;padding-top:22px;padding-bottom:35px;font-size:13px}.back-link{font-size:12px}.people-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:12px 0}.people-heading h1{font:450 30px var(--serif);margin:0 0 6px}.people-heading p{margin:0;font-size:13px;opacity:.7}.people-search input{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:5px;padding:8px 10px;width:200px}#users-status,.access-footnote{font-size:12px;opacity:.7;margin:12px 0}#user-permissions :global(.access-row){border-bottom:1px solid var(--border)}#user-permissions :global(.person-summary){display:grid;grid-template-columns:minmax(180px,1fr) 120px 150px 80px 95px;gap:12px;align-items:center;padding:14px 10px;list-style:none;cursor:pointer;font-size:12px}#user-permissions :global(.person-summary::-webkit-details-marker){display:none}#user-permissions :global(.person-name){font-weight:500;font-size:13px;overflow-wrap:anywhere}#user-permissions :global(.person-name small){display:block;opacity:.65;font-size:11px;font-weight:400}#user-permissions :global(.person-edit){text-align:right;color:var(--accent)}#user-permissions :global(.owner-row){background:color-mix(in srgb,var(--accent) 4%,transparent);border-radius:5px}#user-permissions :global(.owner-row .person-summary){cursor:default}#user-permissions :global(.access-editor){padding:5px 12px 18px;max-width:790px}#user-permissions :global(.access-basics){display:flex;flex-wrap:wrap;gap:12px;margin-bottom:12px}#user-permissions :global(.access-basics label){display:flex;gap:6px;align-items:center;font-size:12px}#user-permissions :global(select){padding:7px;border:1px solid var(--border);border-radius:5px;background:var(--surface);color:var(--text);font-size:12px}#user-permissions :global(fieldset){border:0;padding:0;margin:12px 0}#user-permissions :global(legend){font-size:12px;font-weight:500;padding:0;margin:0 0 8px}#user-permissions :global(table){width:100%;border-collapse:collapse;font-size:12px}#user-permissions :global(th),#user-permissions :global(td){padding:6px 8px;border-bottom:1px solid var(--border);text-align:left}#user-permissions :global(th:not(:first-child)),#user-permissions :global(td:not(:first-child)){text-align:center;width:100px}#user-permissions :global(input[type=checkbox]){width:17px;height:17px;accent-color:var(--accent);vertical-align:middle}#user-permissions :global(.beta-grant){display:inline-flex;align-items:center;gap:6px;font-size:12px}#user-permissions :global(.extra-permissions){margin:12px 0;font-size:12px}#user-permissions :global(.extra-permissions summary){cursor:pointer}#user-permissions :global(.extra-grid){display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}#user-permissions :global(.access-actions){display:flex;align-items:center;gap:14px;margin-top:12px}#user-permissions :global(.access-actions button){font-size:12px;min-height:32px}#user-permissions :global(.access-note){font-size:11px;opacity:.65;margin:5px 0}@media(max-width:700px){.people-heading{display:block}.people-search input{margin-top:12px;width:100%}#user-permissions :global(.person-summary){grid-template-columns:minmax(0,1fr) auto;gap:4px 10px;padding:12px 4px}#user-permissions :global(.person-name){grid-column:1}#user-permissions :global(.person-edit){grid-column:2;grid-row:1}#user-permissions :global(.person-summary>span:not(.person-name):not(.person-edit)){font-size:11px}#user-permissions :global(.extra-grid){grid-template-columns:1fr}.permissions-wrap{padding-inline:16px}}
</style>
