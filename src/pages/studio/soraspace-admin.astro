---
import Workspace from '../../layouts/KoboWorkspace.astro';
import {protectPage} from '../../../server/identity';
export const prerender=false;
const actor=await protectPage('/studio/soraspace-admin','settings.manage');if(actor instanceof Response)return actor;
if(!actor.isOwner)return new Response('Owner access required.',{status:403});
Astro.response.headers.set('Cache-Control','private, no-store');
const groups=[
 ['People & access',[
 ['Legacy people and app permissions','Existing owner tool','Explore accounts, manual app access and suspension; not multi-customer platform staff roles.','/studio/users'],
 ['Customer workspace lifecycle','Required for beta','Verified onboarding, invitations, membership, last-owner protection, account recovery and scoped suspension.'],
 ['Platform staff & step-up access','Required for beta','Separate owner, admin, support, billing and security roles; MFA, revocation and no tenant bypass.'],
 ['Recovery after subscription expiry','Required before billing','Keep account, authorised export and recovery accessible after editing grants expire.']]],
 ['Websites & domains',[
 ['Guided site setup','Approved trial','Five templates and a question-led private starting draft.','/studio/soraspace-setup'],
 ['Private site editor','Approved trial','Page visibility, navigation, content, appearance and private draft save/reopen. No publishing.','/studio/soraspace-editor'],
 ['Customer publishing','Required before public sites','Versioned publication, private preview, route/feed/asset/cache isolation, revert and unpublish.'],
 ['Domain and certificate lifecycle','Required before customer domains','Ownership challenges, trusted host binding, reserved names, TLS renewal, removal and collision checks.']]],
 ['Plans & billing',[
 ['Product and entitlement policy','Isolated proposal','Versioned app/workspace plans, source-specific grants, trial/expiry rules and first-year-only founding offer.'],
 ['Verified payments & reconciliation','Required before billing','Hosted checkout, signed/idempotent events, failed renewals, refunds, invoices and provider reconciliation.'],
 ['Usage and budgets','Required for beta','Per-tenant metering, limits, spend alerts and safe recovery access when a limit is reached.']]],
 ['Storage & privacy',[
 ['Existing storage connections','Existing owner tool','Per-account connection settings and index-recovery tools; this is not a customer support console.','/studio/storage'],
 ['Tenant data isolation','Isolated prototype','PostgreSQL policy/service tests exist; identity, object access, jobs and real provider deployment still need qualification.'],
 ['Backups and restore drills','Required for beta','Separate original bytes, manifests, indexes, configuration and keys; prove restore into an isolated copy.'],
 ['Export, retention and deletion','Required before public sites','Verified requests, scoped expiring exports, deletion scheduling and backup/third-party retention.'],
 ['Region and encryption evidence','Required before residency claims','Identify files, replicas, relays, metadata, keys and subprocessors independently; no blanket jurisdiction exemption.']]],
 ['Apps & releases',[
 ['Desktop download settings','Existing owner tool','Existing installer configuration for Explore app access. Native builds remain with Claude.','/studio/downloads'],
 ['App/template rollout and rollback','Required before customer rollout','Accepted builds, artifact provenance, beta cohorts, feature gates, compatibility and preserved user data.'],
 ['Desktop devices and licensing','Required before licensed desktop sales','Transactional activation limits, bounded offline tickets, device removal and recovery; no instant offline revocation claim.']]],
 ['Support & security',[
 ['Scoped support assistance','Required for beta','Metadata-first diagnostics; time-limited content access with reason/consent and staff attribution.'],
 ['Security response','Required for beta','Session revocation, quarantine, incident evidence, key-rotation recovery and measured alerting.'],
 ['Public abuse reports','Required before public sites','Report, triage, limited takedown, customer notice, appeal and restoration.']]],
 ['SoraShop & merchants',[
 ['HobbyNest owner store','Existing owner tool','Catalogue, stock, colours, discounts and shipping preparation; checkout remains closed.','/studio/hobbynest'],
 ['Merchant and order isolation','Required before multi-merchant sales','Merchant delegation, transactional stock/reservations, signed payment events and separate ledgers.'],
 ['Paid downloads and fulfilment','Required before commerce','Immutable private product files, order-scoped grants, shipping, tracking, returns and tested refunds.']]],
 ['Operations & audit',[
 ['Administrator audit trail','Required for beta','Actor, target, reason, safe diff and outcome for privileged writes, support reads, exports and denials.'],
 ['Service health and job operations','Required for beta','Measured status, queue retries, scoped replay, certificate and backup alerts; no sample telemetry.'],
 ['Emergency and rollout switches','Required before customer rollout','Scoped signup/checkout/launch/write/publish pauses with reasons, expiry and rollback; preserve authorised reads.'],
 ['Platform ownership and recovery','Required for beta','Last-owner protection, verified transfer, separate recovery factors and a tested owner recovery procedure.']]]
];
---
<Workspace actor={actor} title="SoraSpace Administration" section="admin"><section class="admin-assessment"><a href="/studio">← My Studio</a><header><span class="eyebrow">Owner only · Readiness assessment</span><h1>SoraSpace Administration</h1><p>A compact view of the controls needed to run the platform. Existing links manage your own Explore account. Full customer administration is being prepared. Limited trial access is managed through People & access.</p></header><p><a class="btn" href="/studio/soraspace-controls">Launch switches &amp; tester trials →</a></p><div class="admin-principles"><p><strong>Separate responsibilities</strong>Platform staff roles, customer memberships and app entitlements stay separate.</p><p><strong>Private by default</strong>Support access needs a scoped, time-limited and audited process.</p><p><strong>Launch in stages</strong>Invitation beta → customer publishing → subscriptions → SoraShop.</p></div><p class="admin-note">This is a source-based readiness inventory, not live customer, revenue or service-health telemetry. Expand an area to review the requirements.</p><div class="admin-groups">{groups.map(([title,rows])=><details><summary>{title}<span>{rows.length} controls</span></summary><div>{rows.map(([name,status,description,href])=><article><div><h2>{name}</h2><p>{description}</p>{href&&<a href={href}>Open owner tool →</a>}</div><span class:list={['admin-state',status==='Existing owner tool'?'existing':'']}>{status}</span></article>)}</div></details>)}</div><section class="admin-next"><h2>Next implementation priorities</h2><ol><li>Qualify identity/MFA, transactional database and backups.</li><li>Build invitation onboarding, staff roles, audit and the account recovery shell.</li><li>Connect customer publishing, domains and real operational status.</li><li>Add billing and merchant controls after their separate release checks.</li></ol><p>The full assessment also covers acceptance tests, high-impact confirmations, support privacy, region claims, billing reconciliation and emergency recovery.</p></section></section></Workspace>
<style>.admin-assessment{max-width:1200px;margin:auto;font:14px/1.6 system-ui}.admin-assessment>a{font-size:12px}.admin-assessment header{margin:16px 0}.admin-assessment h1{font:600 28px/1.2 system-ui;letter-spacing:-.03em;margin:8px 0}.admin-assessment header>p{max-width:85ch;font-size:13px;opacity:.75}.admin-principles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.admin-principles p{padding:12px;border:1px solid var(--border);border-radius:7px;margin:0;font-size:12px}.admin-principles strong{display:block;margin-bottom:4px;font-size:13px}.admin-note{font-size:12px;opacity:.75}.admin-groups{display:grid;gap:8px}.admin-groups details{border:1px solid var(--border);background:var(--surface);border-radius:7px}.admin-groups summary{cursor:pointer;padding:12px 16px;min-height:48px;font-weight:600;font-size:14px}.admin-groups summary>span{float:right;font-size:11px;font-weight:400;opacity:.7}.admin-groups article{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:20px;border-top:1px solid var(--border);padding:12px 16px;align-items:start}.admin-groups h2,.admin-next h2{font:600 14px system-ui;margin:0 0 6px}.admin-groups p{font-size:12px;margin:0;opacity:.8}.admin-groups a{display:inline-flex;min-height:44px;align-items:center;font-size:12px}.admin-state{font-size:11px;border:1px solid var(--border);padding:4px 8px;border-radius:5px;justify-self:end}.admin-state.existing{color:var(--accent)}.admin-next{margin-top:20px;padding-top:16px;border-top:1px solid var(--border)}.admin-next ol,.admin-next p{font-size:12px}@media(max-width:650px){.admin-principles{grid-template-columns:1fr}.admin-groups article{grid-template-columns:1fr;gap:8px}.admin-state{justify-self:start;grid-row:1}.admin-groups summary{padding-inline:12px}.admin-assessment h1{font-size:24px}}
</style>
