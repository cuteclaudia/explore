---
import Base from '../../layouts/Base.astro';
import {APP_PRESENTATION} from '../../lib/app-presentation.mjs';
import {SORASPACE_SERVICES} from '../../lib/soraspace-services.mjs';
export const prerender=false;
Astro.response.headers.set('Cache-Control','private, no-store');
const enabled=process.env.SORASPACE_SIGNUP_ENABLED==='true';
// Pricing selection is an editable starting point, never proof of payment/access.
const requestedApp=Astro.url.searchParams.get('app');
const appServices={fumi:'docs',tsuzuri:'pdf',hikari:'photos',irodori:'image'};
const startingApp=requestedApp&&Object.hasOwn(appServices,requestedApp)?requestedApp:null;
const choice=Astro.url.searchParams.get('package');
const startingPackage=choice==='workspace'?'Workspace':choice==='workspace-website'?'Workspace + Website':null;
---
<Base title="Create your SoraSpace trial account" noindex skipPageFeature><section class="wrap signup-wrap"><span class="eyebrow">SoraSpace · Trial registration</span><h1><span data-i18n="Create your account.">Create your account.</span></h1><p><span data-i18n="Choose the services you’d like to try. Verify your email, then wait for approval before opening the trial tools.">Choose the services you’d like to try. Verify your email, then wait for approval before opening the trial tools.</span></p>{startingApp&&<p class="signup-app"><strong>{APP_PRESENTATION[startingApp].name}</strong></p>}{startingPackage&&<aside class="signup-package" aria-labelledby="signup-package-heading"><span id="signup-package-heading" data-i18n="Your starting package">Your starting package</span><strong data-i18n={startingPackage}>{startingPackage}</strong>{enabled&&<p data-i18n="You can change the service choices below.">You can change the service choices below.</p>}</aside>}<p id="signup-message" role="status">{enabled?'Email verification and manual approval are required.':'Registration is being prepared. Please check back shortly.'}</p>{enabled&&<form method="post" action="/api/soraspace/account/signup" id="soraspace-signup"><label><span data-i18n="Your name">Your name</span><input name="name" autocomplete="name" maxlength="80" required/></label><label><span data-i18n="Email address">Email address</span><input name="email" type="email" autocomplete="email" maxlength="254" required/></label><label><span data-i18n="Password">Password</span><input name="password" type="password" autocomplete="new-password" minlength="12" required/><small><span data-i18n="At least 12 characters, up to 72 UTF-8 bytes.">At least 12 characters, up to 72 UTF-8 bytes.</span></small></label><fieldset><legend><span data-i18n="Services you’re interested in">Services you’re interested in</span></legend>{Object.entries(SORASPACE_SERVICES).map(([id,s])=><label class="signup-service"><input name="services" type="checkbox" value={id} checked={startingApp?id===appServices[startingApp]:id==='website'&&choice!=='workspace'}/><span><strong data-i18n={s.name}>{s.name}</strong><small data-i18n={s.description}>{s.description}</small></span></label>)}</fieldset><p class="signup-note">This is a free, manually approved test. No payment details are requested. Your name, email and choices are stored with the existing Explore/Netlify account service. You can change your requested services after signing in. Research Library, Projects, SoraShop, mail and spreadsheets will be offered separately when available.</p><button class="btn" type="submit"><span data-i18n="Create trial account">Create trial account</span></button></form>}<p><a href="/studio/login?next=%2Fstudio%2Fwelcome"><span data-i18n="Already registered? Sign in →">Already registered? Sign in →</span></a></p><p><a href="https://www.soraspace.studio/">← SoraSpace</a></p></section></Base>
<script>
const message=document.getElementById('signup-message');if(new URLSearchParams(location.search).get('check')==='email'){document.getElementById('soraspace-signup')?.setAttribute('hidden','');message.textContent='Check your inbox for the verification email. Follow its link, then sign in to view approval status.';}
const form=document.getElementById('soraspace-signup');form?.addEventListener('submit',async event=>{event.preventDefault();const f=event.currentTarget as HTMLFormElement,button=f.querySelector('button')!;button.disabled=true;message.textContent='Creating your account…';try{const body=new URLSearchParams();for(const [key,value] of new FormData(f))body.append(key,String(value));const r=await fetch(f.action,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body,redirect:'follow',signal:AbortSignal.timeout(20000)});if(r.redirected&&new URL(r.url).pathname==='/studio/signup'){f.reset();location.replace('/studio/signup?check=email');return;}const data=await r.json();throw Error(data.error||'Registration could not be completed.');}catch(e){message.textContent=e instanceof Error?e.message:'Registration could not be completed. Check your inbox before trying again.';}finally{const password=f.querySelector<HTMLInputElement>('[name=password]');if(password)password.value='';button.disabled=false;}});
</script>
<style>.signup-wrap{max-width:760px;padding-block:24px 40px;font:14px/1.6 system-ui}.signup-wrap h1{font:600 30px system-ui;margin:10px 0}.signup-wrap form>label{display:block;margin:14px 0}.signup-wrap input:not([type=checkbox]){display:block;width:100%;font:16px system-ui;padding:10px;border:1px solid var(--border);border-radius:5px;background:var(--surface);color:var(--text);min-height:44px}.signup-wrap small{display:block;font-size:12px;opacity:.75}.signup-wrap fieldset{border:1px solid var(--border);border-radius:7px;padding:12px}.signup-service{display:flex;gap:12px;min-height:48px;margin:8px 0;align-items:center}.signup-service input{width:18px;height:18px;flex-shrink:0}.signup-service strong{font-size:14px}.signup-note{font-size:12px;opacity:.8}.signup-wrap [hidden]{display:none!important}</style>

<style>.signup-package{padding:12px 14px;border:1px solid var(--border);border-radius:7px;background:var(--surface);margin:14px 0}.signup-package>span{display:block;font-size:12px;opacity:.75}.signup-package strong{display:block;font-size:17px}.signup-package p{font-size:12px;margin:4px 0 0}</style>
