---
import Settings from '../../layouts/Settings.astro';
import {protectPage} from '../../../server/identity';
export const prerender=false;
const actor=await protectPage('/studio/downloads','settings.manage');if(actor instanceof Response)return actor;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Settings title="Desktop installer settings" section="downloads"><section class="settings-section"><h2>Desktop installers</h2><p>Add the GitHub installer or release link for each app and platform. A compact Desktop link appears beside the app in My Studio and My apps when an installer and access are available.</p><p>Web access includes desktop downloads. Desktop-only access can be granted separately in <a href="/studio/users">User permissions</a>. Payment processing and licence checks inside the desktop apps are not connected yet; a public GitHub download can still be shared.</p><p><strong>macOS is planned.</strong> Keep its installer field available for future builds; leave the URL empty until a tested macOS release is published. My Studio and My apps show “macOS · Planned” until a macOS download is configured.</p><p>GitHub draft releases are private and do not appear at <code>/releases/latest</code>. Configure member download links after publishing a tested release. For a changing “latest” release-page link, leave Version and SHA-256 blank; use the release’s own checksums. Only attach an installer checksum to the exact installer file it verifies.</p><div id="installer-settings"></div><p id="installer-status" role="status">Loading installers…</p></section></Settings>
<script>
const area=document.querySelector('#installer-settings')!,status=document.querySelector('#installer-status')!;
async function load(){const response=await fetch('/api/desktop/settings',{cache:'no-store'}),data=await response.json();if(!response.ok)throw Error(data.error);area.replaceChildren();let current,app;for(const record of data.installers){if(app!==record.app){app=record.app;current=document.createElement('details');const summary=document.createElement('summary');summary.textContent=record.name;current.append(summary);area.append(current);}const form=document.createElement('form');const heading=document.createElement('h3');heading.textContent=record.label+(record.platform==='macos'&&!record.url?' · Planned':'');form.append(heading);for(const [name,label,placeholder] of [['url','GitHub release or installer URL','https://github.com/owner/repository/releases/latest'],['version','Version (optional)','0.15.0'],['sha256','SHA-256 (optional)','Installer checksum']]){const field=document.createElement('label');field.textContent=label;const input=document.createElement('input');input.name=name;input.type=name==='url'?'url':'text';input.value=record[name];input.placeholder=placeholder;field.append(input);form.append(field);}const save=document.createElement('button');save.type='submit';save.className='btn ghost';save.textContent='Save '+record.label+' link';form.append(save);form.onsubmit=async event=>{event.preventDefault();save.disabled=true;try{const response=await fetch('/api/desktop/settings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({app:record.app,platform:record.platform,etag:record.etag,...Object.fromEntries(new FormData(form))})}),result=await response.json();if(!response.ok)throw Error(result.error);status.textContent=record.name+' '+record.label+' link saved. Clear the URL and save to remove it.';const fresh=await fetch('/api/desktop/settings',{cache:'no-store'});const settings=await fresh.json();if(!fresh.ok)throw Error(settings.error);record.etag=settings.installers.find(r=>r.app===record.app&&r.platform===record.platform).etag;}catch(error){status.textContent=error instanceof Error?error.message:'Installer could not be saved.';}finally{save.disabled=false;}};current.append(form);}status.textContent='Only configured downloads are shown to permitted accounts. Clear a URL and save to remove a link.';}
load().catch(error=>status.textContent=error.message);
</script>
<style>#installer-settings :global(details){border-top:1px solid var(--border);padding:12px 0}#installer-settings :global(summary){cursor:pointer;font-size:16px}#installer-settings :global(form){display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0 24px}#installer-settings :global(h3){grid-column:1/-1;margin:0}#installer-settings :global(label){display:flex;flex-direction:column;gap:5px;font-size:12px}#installer-settings :global(label:first-of-type){grid-column:1/-1}#installer-settings :global(input){width:100%;box-sizing:border-box;font-size:12px}#installer-settings :global(button){justify-self:start;font-size:12px}@media(max-width:550px){#installer-settings :global(form){grid-template-columns:1fr}}</style>
