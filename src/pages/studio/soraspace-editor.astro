---
import Workspace from '../../layouts/KoboWorkspace.astro';
import {protectPage} from '../../../server/identity';
import {SITE_TEMPLATES,SITE_PALETTES} from '../../lib/soraspace-site-setup.mjs';
export const prerender=false;
const actor=await protectPage('/studio/soraspace-editor','settings.manage');if(actor instanceof Response)return actor;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Workspace actor={actor} title="Site editor preview" section="site">
<section id="site-editor" data-account={actor.user.id}>
 <header class="editor-heading"><div><a href="/studio/soraspace-setup">← Site setup</a><h1>Your site, your way.</h1><p>Owner preview · Private draft · Publishing is not enabled</p></div><div class="editor-actions"><button id="editor-reload" type="button">Reload saved</button><button id="editor-export" type="button" disabled>Export draft</button><label class="editor-file">Import draft<input id="editor-import" type="file" accept=".json,application/json" disabled/></label><button id="editor-save" type="button" disabled>Save draft</button></div></header>
 <p class="editor-status" id="editor-status" role="status">Loading your private draft…</p>
 <div id="editor-panels" hidden>
 <div class="editor-grid">
  <aside class="editor-pages"><h2>Pages & navigation</h2><p>Use the arrows to change the menu order. Hidden pages keep their content.</p><div id="editor-page-list"></div><label>Homepage<select id="editor-home"></select></label><label>Featured page<select id="editor-featured"></select></label></aside>
  <section class="editor-controls" aria-labelledby="editor-controls-heading"><h2 id="editor-controls-heading">Customise your site</h2>
   <details id="editor-brand"><summary>Brand & appearance</summary><div class="editor-fields"><label>Site name<input id="editor-name" maxlength="80" required/></label><label>Tagline<input id="editor-tagline" maxlength="160"/></label><label>Logo text <small>Up to 4 characters</small><input id="editor-mark" maxlength="8"/></label><label>Footer text<input id="editor-footer" maxlength="160"/></label><label>Template<select id="editor-template">{Object.entries(SITE_TEMPLATES).map(([id,t])=><option value={id}>{t.name}</option>)}</select></label><label>Palette<select id="editor-palette">{Object.entries(SITE_PALETTES).map(([id,p])=><option value={id}>{p.name}</option>)}</select></label><label>Spacing<select id="editor-density"><option value="compact">Compact</option><option value="comfortable">Comfortable</option></select></label></div></details>
   <section class="editor-page-fields"><h3 id="editor-page-heading">Page content</h3><label>Navigation name<input id="editor-page-title" maxlength="32"/></label><label>Page heading<input id="editor-page-name" maxlength="100"/></label><label>Short introduction<textarea id="editor-page-summary" maxlength="240" rows="2"></textarea></label><label>Page text<textarea id="editor-page-body" maxlength="3000" rows="8"></textarea></label><p>Plain text for this first editor. Photos, article collections and contact forms will be connected later.</p></section>
  </section>
  <section class="editor-preview-panel"><header><h2>Preview</h2><div class="preview-sizes" aria-label="Preview width"><button type="button" data-preview-size="wide" aria-pressed="true">Wide</button><button type="button" data-preview-size="phone" aria-pressed="false">Phone</button></div></header><p class="editor-preview-note">Only enabled pages appear here. Your draft has no public address.</p><div id="editor-preview"></div></section>
 </div></div>
 <noscript><p>Enable JavaScript to try the private site editor.</p></noscript>
</section>
<script>import '../../scripts/soraspace-site-editor.mjs';</script>
</Workspace>
<style is:global>
.workspace-content:has(#site-editor){max-width:none;padding:18px 22px}#site-editor{font:14px/1.5 system-ui;min-width:0}#site-editor [hidden]{display:none!important}.editor-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.editor-heading a{font-size:12px}.editor-heading h1{font:600 26px/1.2 system-ui;letter-spacing:-.03em;margin:8px 0 5px}.editor-heading p{font-size:12px;margin:0;opacity:.75}.editor-actions{display:flex;gap:8px;flex-wrap:wrap}#site-editor button,.editor-file{min-height:44px;border:1px solid var(--border);border-radius:5px;background:var(--surface);color:var(--text);padding:8px 10px;font:12px system-ui;cursor:pointer}#site-editor button:disabled{opacity:.5;cursor:default}#editor-save{border:2px solid var(--accent);font-weight:650}.editor-file{display:flex;align-items:center;position:relative;overflow:hidden}.editor-file input{position:absolute;inset:0;opacity:0;width:100%;cursor:pointer}.editor-file:focus-within{outline:2px solid var(--accent);outline-offset:3px}.editor-status{min-height:36px;margin:12px 0;font-size:12px;overflow-wrap:anywhere}.editor-grid{display:grid;grid-template-columns:200px minmax(260px,340px) minmax(0,1fr);gap:14px;align-items:start}.editor-pages,.editor-controls,.editor-preview-panel{min-width:0;border:1px solid var(--border);border-radius:8px;padding:14px;background:var(--surface)}#site-editor h2{font:600 16px system-ui;margin:0 0 10px}#site-editor h3{font:600 15px system-ui}.editor-pages>p,.editor-page-fields>p,.editor-preview-note{font-size:11px;line-height:1.6;opacity:.75}.editor-page-row{display:grid;grid-template-columns:24px minmax(0,1fr);gap:6px;align-items:center;padding:6px 0;border-bottom:1px solid var(--border)}#site-editor .editor-page-select{display:block;text-align:left;font-size:12px;border:0;padding-inline:4px;overflow-wrap:anywhere}#site-editor .editor-page-select[aria-current=page]{color:var(--accent);font-weight:700;background:color-mix(in srgb,var(--accent) 8%,transparent)}.editor-page-order{grid-column:2;display:flex;gap:4px}#site-editor .editor-page-order button{padding:4px 9px;min-width:44px}.editor-page-row input{width:16px;height:16px}.editor-page-row small{display:block;font-size:10px;opacity:.7}.editor-pages>label,#site-editor .editor-fields label,.editor-page-fields label{display:block;font-size:12px;margin-top:12px}#site-editor input:not([type=checkbox]):not([type=file]),#site-editor textarea,#site-editor select{display:block;width:100%;box-sizing:border-box;border:1px solid var(--border);border-radius:5px;background:var(--surface);color:var(--text);font:16px/1.4 system-ui;min-height:44px;padding:8px;margin-top:5px;min-width:0}#site-editor textarea{resize:vertical}#site-editor small{font-size:10px}#site-editor summary{font-weight:600;cursor:pointer;min-height:44px;display:list-item;align-content:center}.editor-controls details{border-bottom:1px solid var(--border);padding-bottom:12px;margin-bottom:16px}.editor-preview-panel>header{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap}.preview-sizes{display:flex;gap:5px}#site-editor .preview-sizes button[aria-pressed=true]{border-color:var(--accent);font-weight:650}#editor-preview{overflow:hidden;min-width:0;border:1px solid GrayText;border-radius:7px;margin:auto;color-scheme:light dark;background:Canvas;color:CanvasText}#editor-preview[data-size=phone]{max-width:390px}.site-draft-view{--preview-accent:LinkText;--preview-wash:ButtonFace;min-height:360px;background:Canvas;color:CanvasText}.site-draft-view[data-palette=moss]{color-scheme:light;--preview-accent:#36594a;--preview-wash:#e7eee9}.site-draft-view[data-palette=ink]{color-scheme:light;--preview-accent:#344e72;--preview-wash:#e8edf5}.site-draft-view[data-palette=clay]{color-scheme:light;--preview-accent:#854a36;--preview-wash:#f4e9e3}.site-draft-view>header{padding:14px;border-bottom:1px solid GrayText}.site-draft-brand{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;overflow-wrap:anywhere}.site-draft-mark{font-size:22px;color:var(--preview-accent);flex-shrink:0}.site-draft-nav{display:flex;flex-wrap:wrap;gap:4px 10px;margin-top:8px}#site-editor .site-draft-nav button{border:0;background:transparent;color:inherit;font-size:12px;padding:5px;min-height:44px}#site-editor .site-draft-nav button[aria-current=page]{text-decoration:underline;text-underline-offset:5px;color:var(--preview-accent)}.site-draft-content{padding:22px 18px;background:var(--preview-wash)}#site-editor .site-draft-content h3{font:600 clamp(22px,2vw,30px)/1.2 system-ui;letter-spacing:-.03em;overflow-wrap:anywhere;margin:0 0 12px}.site-draft-content p{font-size:14px;line-height:1.65;white-space:pre-wrap;overflow-wrap:anywhere}.site-draft-tagline{font-size:11px!important;color:var(--preview-accent)}.site-draft-view footer{font-size:11px;line-height:1.6;padding:14px;overflow-wrap:anywhere}.site-draft-feature{padding:14px;border-top:1px solid GrayText}#site-editor .site-draft-feature button{color:inherit;background:transparent;border-color:GrayText;overflow-wrap:anywhere}.site-draft-view[data-template=folio] .site-draft-content{border-left:5px solid var(--preview-accent)}.site-draft-view[data-template=editorial] .site-draft-content h3{font-family:Georgia,serif}.site-draft-view[data-template=horizon] .site-draft-content{background:linear-gradient(140deg,var(--preview-wash),Canvas);padding-block:40px}.site-draft-view[data-template=practice] .site-draft-content{border-top:4px solid var(--preview-accent)}.site-draft-view[data-template=canvas] .site-draft-content{text-align:center;background:Canvas}.site-draft-view[data-density=comfortable] .site-draft-content{padding:34px 24px}.site-draft-badge{display:inline-block;margin-bottom:12px;font-size:10px;letter-spacing:.05em;color:var(--preview-accent)}@media(max-width:1200px){.editor-grid{grid-template-columns:190px minmax(0,1fr)}.editor-preview-panel{grid-column:1/-1}.editor-fields{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}}@media(max-width:650px){.workspace-content:has(#site-editor){padding:16px}.editor-grid{grid-template-columns:minmax(0,1fr)}.editor-preview-panel{grid-column:auto}.editor-heading h1{font-size:23px}.editor-fields{grid-template-columns:1fr}.editor-page-row{grid-template-columns:24px minmax(0,1fr) auto}.editor-page-order{grid-column:auto}.editor-pages{padding:12px}.editor-status{min-height:48px}.editor-actions{gap:6px}}@media(forced-colors:active){.site-draft-content{background:Canvas!important}.site-draft-view{--preview-accent:LinkText;--preview-wash:Canvas}}
</style>
