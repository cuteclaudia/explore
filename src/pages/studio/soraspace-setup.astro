---
import Base from '../../layouts/Base.astro';
import {protectPage} from '../../../server/identity';
import {SITE_PURPOSES,SITE_PAGES,SITE_TEMPLATES,SITE_PALETTES} from '../../lib/soraspace-site-setup.mjs';
export const prerender=false;
const actor=await protectPage('/studio/soraspace-setup','settings.manage');if(actor instanceof Response)return actor;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Base title="SoraSpace site setup preview" noindex skipPageFeature>
<section class="wrap site-setup" id="site-setup">
 <a href="/studio">← My Studio</a><header><span class="eyebrow">SoraSpace · Owner preview</span><h1>A space that feels like yours.</h1><p>Tell us what you have in mind. Start with a template, then make it your own.</p></header>
 <p class="setup-notice">Try the setup flow here. Your answers stay in this tab; download the draft to keep a copy. This preview does not create or publish a website.</p>
 <noscript><p>Enable JavaScript to try the site setup preview.</p></noscript>
 <div id="setup-interactive" hidden>
 <ol class="setup-progress" aria-label="Site setup progress">{['Purpose','Pages & template','Your style','Review'].map((label,index)=><li data-progress={index}><span>{index+1}</span>{label}</li>)}</ol>
 <form id="site-setup-form" novalidate>
  <section data-step="0"><h2 tabindex="-1">What will your site be for?</h2><p>We’ll suggest a starting point. You can change every choice.</p><fieldset><legend class="sr-only">Main site purpose</legend><div class="setup-choices">{Object.entries(SITE_PURPOSES).map(([id,p])=><label class="setup-choice"><input type="radio" name="purpose" value={id} checked={id==='personal'}/><span><strong>{p.name}</strong><small>{p.description}</small></span></label>)}</div></fieldset><p class="setup-help">A shop can be added through SoraShop in a future release. Payments are not part of this preview.</p></section>
  <section data-step="1" hidden><h2 tabindex="-1">Choose your pages and a starting layout.</h2><fieldset><legend>Pages to include</legend><div class="setup-pages">{Object.entries(SITE_PAGES).map(([id,title])=><label><input type="checkbox" name="pages" value={id} checked={['home','about','blog'].includes(id)} disabled={id==='home'}/>{title}{id==='home'&&<small>Required</small>}</label>)}</div><p class="setup-help">Pages start as drafts. Adding Journal never publishes existing private entries.</p></fieldset><fieldset><legend>Your template</legend><div class="setup-templates">{Object.entries(SITE_TEMPLATES).map(([id,t])=><label class="setup-choice"><input type="radio" name="template" value={id} checked={id==='editorial'}/><span><span class:list={['template-swatch',id]} aria-hidden="true"><i></i><i></i><i></i></span><strong>{t.name}</strong><small>{t.description}</small></span></label>)}</div></fieldset></section>
  <section data-step="2" hidden><h2 tabindex="-1">Make it yours.</h2><div class="setup-fields"><label>Site name <input name="siteName" maxlength="80" required autocomplete="off" placeholder="Your name, project or publication"/></label><label>Tagline <span class="setup-optional">Optional</span><input name="tagline" maxlength="160" placeholder="A short line about your space"/></label><label class="setup-wide">A short introduction <span class="setup-optional">Optional</span><textarea name="introduction" maxlength="500" rows="3" placeholder="What would you like visitors to know?"></textarea></label></div><div class="setup-fields"><fieldset><legend>Colour palette</legend><div class="setup-palettes">{Object.entries(SITE_PALETTES).map(([id,p])=><label><input type="radio" name="palette" value={id} checked={id==='moss'}/><span class:list={['palette-dot',id]}></span>{p.name}</label>)}</div></fieldset><fieldset><legend>Layout density</legend><label class="density-choice"><input type="radio" name="density" value="compact" checked/>Compact</label><label class="density-choice"><input type="radio" name="density" value="comfortable"/>Comfortable</label></fieldset></div></section>
  <section data-step="3" hidden><h2 tabindex="-1">Your starting point.</h2><p id="setup-summary"></p><div id="setup-preview" aria-label="Draft website preview"></div><p class="setup-help">This is an unpublished layout with empty sections. You can edit text, pages and appearance later. Contact forms, galleries, domains and publishing will be connected in a later release.</p><button type="button" class="btn ghost" id="setup-download">Download draft (.json)</button></section>
  <p id="setup-status" role="status" aria-live="polite"></p><div class="setup-actions"><button type="button" class="btn ghost" id="setup-back" hidden>Back</button><span id="setup-step-count"></span><button type="submit" class="btn" id="setup-next">Continue →</button></div>
 </form></div>
</section>
<script>import '../../scripts/soraspace-site-setup.mjs';</script>
</Base>
<style is:global>
.site-setup{max-width:1060px;padding-block:24px 44px}.site-setup>header{margin:18px 0}.site-setup h1{font:500 clamp(28px,4vw,39px)/1.15 var(--serif);margin:8px 0}.site-setup header>p{margin:8px 0}.site-setup p{font-size:14px;line-height:1.6}.setup-notice{padding:10px 14px;border:1px solid var(--border);border-radius:8px;background:var(--surface)}.setup-progress{display:flex;flex-wrap:wrap;list-style:none;padding:0;gap:12px 24px;margin:20px 0}.setup-progress li{display:flex;gap:8px;align-items:center;font-size:12px;opacity:.65}.setup-progress li[aria-current=step]{opacity:1;font-weight:650;color:var(--accent)}.setup-progress li>span{display:grid;place-items:center;border:1px solid var(--border);border-radius:50%;width:25px;height:25px}.site-setup h2{font:600 23px/1.3 system-ui;letter-spacing:-.02em;margin:0 0 12px}.site-setup fieldset{border:0;padding:0;margin:18px 0}.site-setup legend{font-size:14px;font-weight:600;margin-bottom:10px}.setup-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.setup-choice{display:flex;gap:12px;border:1px solid var(--border);background:var(--surface);border-radius:9px;padding:14px;cursor:pointer;min-width:0}.setup-choice:has(input:checked){border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}.setup-choice input{margin-top:5px;flex-shrink:0}.setup-choice strong,.setup-choice small{display:block}.setup-choice strong{font-size:14px}.setup-choice small{font-size:12px;line-height:1.6;opacity:.75;margin-top:4px}.setup-pages,.setup-palettes{display:flex;flex-wrap:wrap;gap:6px 20px}.setup-pages label,.setup-palettes label,.density-choice{display:inline-flex;align-items:center;gap:8px;font-size:14px;min-height:44px}.setup-pages small{font-size:11px;opacity:.65}.setup-templates{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.template-swatch{display:grid;gap:5px;padding:8px;background:var(--bg);border:1px solid var(--border);height:66px;border-radius:4px;margin-bottom:10px;grid-template-columns:1fr 1fr}.template-swatch i{display:block;background:color-mix(in srgb,var(--accent) 22%,var(--surface));border-radius:2px}.template-swatch i:first-child{grid-column:1/-1}.template-swatch.folio{grid-template-columns:2fr 1fr}.template-swatch.folio i:first-child{grid-column:auto;grid-row:1/3}.template-swatch.horizon i:first-child{background:linear-gradient(130deg,#36594a66,#9baab5)}.setup-fields{display:grid;grid-template-columns:1fr 1fr;gap:14px 20px}.setup-fields>label{display:block;font-size:14px;font-weight:500}.setup-fields input:not([type=radio]),.setup-fields textarea{display:block;width:100%;margin-top:6px;padding:10px 12px;font:16px/1.5 system-ui;background:var(--surface);border:1px solid var(--border);border-radius:6px;color:var(--text);box-sizing:border-box}.setup-wide{grid-column:1/-1}.setup-optional{font-size:11px;opacity:.6;margin-left:6px}.site-setup .setup-help{font-size:12px;opacity:.75;line-height:1.6}.palette-dot{display:block;width:18px;height:18px;border-radius:50%}.palette-dot.moss{background:#36594a}.palette-dot.ink{background:#344e72}.palette-dot.clay{background:#854a36}.density-choice{margin-right:16px}.setup-actions{display:flex;align-items:center;justify-content:space-between;gap:14px;border-top:1px solid var(--border);margin-top:18px;padding-top:16px}.setup-actions button,#setup-download{min-height:44px}.setup-actions span{font-size:12px;opacity:.7}.site-setup [hidden]{display:none!important}#setup-status{min-height:24px;overflow-wrap:anywhere}#setup-preview{border:1px solid #c7cec8;border-radius:10px;overflow:hidden;background:#fbfaf6;color:#25332d}.draft-preview{--draft-accent:#36594a;--draft-wash:#e7eee9}.draft-preview[data-palette=ink]{--draft-accent:#344e72;--draft-wash:#e8edf5}.draft-preview[data-palette=clay]{--draft-accent:#854a36;--draft-wash:#f4e9e3}.draft-preview nav{display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;padding:14px 20px;border-bottom:1px solid #d7dcd6}.draft-preview nav strong{margin-right:auto;font-size:14px;overflow-wrap:anywhere}.draft-preview nav span{font-size:11px}.draft-hero{padding:28px 24px;background:var(--draft-wash)}.draft-hero h3{font:500 clamp(24px,4vw,36px)/1.2 var(--serif);margin:6px 0;color:var(--draft-accent);overflow-wrap:anywhere}.draft-hero p{max-width:65ch;overflow-wrap:anywhere}.draft-hero small{font-size:11px;letter-spacing:.08em}.draft-sections{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:18px 24px}.draft-sections article{border-top:1px solid #c7cec8;padding-top:10px}.draft-sections h4{font:600 15px system-ui;margin:0 0 6px}.draft-sections p{font-size:12px}.draft-preview[data-template=folio] .draft-sections{grid-template-columns:1fr}.draft-preview[data-template=folio] .draft-hero{border-left:5px solid var(--draft-accent)}.draft-preview[data-template=horizon] .draft-hero{background:radial-gradient(ellipse at 95% 10%,#ffffff88,transparent 65%),linear-gradient(140deg,var(--draft-wash),#d3dfdc);padding-block:44px}.draft-preview[data-density=comfortable] .draft-sections{gap:24px;padding:28px}.draft-preview[data-density=comfortable] .draft-hero{padding-block:44px}@media(max-width:650px){.setup-choices,.setup-templates,.setup-fields{grid-template-columns:minmax(0,1fr)}.setup-wide{grid-column:auto}.setup-progress{gap:10px}.setup-progress li{font-size:11px}.site-setup{padding-block:16px 30px}.setup-choice{padding:12px}.template-swatch{height:40px}.draft-sections{grid-template-columns:1fr}.draft-preview nav{padding:12px}.draft-hero,.draft-sections{padding:18px}.setup-fields fieldset{margin-block:6px}.setup-actions{gap:8px}}
</style>
