---
import Settings from '../../layouts/Settings.astro';
import {protectPage} from '../../../server/identity';
export const prerender=false;
const actor=await protectPage('/studio/hobbynest','settings.manage');if(actor instanceof Response)return actor;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Settings title="HobbyNest store administration" section="hobbynest">
<div id="nest-admin"><header class="nest-heading"><div><h2>HobbyNest</h2><p>Catalogue, stock and shipping · AUD</p></div><a href="/hobbynest" target="_blank" rel="noopener">View shop preview ↗</a></header>
<p class="nest-notice">Orders are closed. You can prepare and publish listings; checkout, automatic sale deductions and STL delivery are still to come.</p>
<div class="nest-tools"><button type="button" id="nest-reload">Reload latest</button><button type="button" id="nest-export" disabled>Export catalogue backup</button></div>
<p id="nest-status" role="status" aria-live="polite">Loading store…</p>
<div class="nest-tabs" role="tablist" aria-label="Store administration">{[['products','Products'],['inventory','Stock'],['collections','Collections'],['discounts','Discounts'],['shipping','Shipping'],['estimate','Test estimate']].map(([id,label],i)=><button type="button" role="tab" id={'nest-tab-'+id} aria-selected={i===0?'true':'false'} aria-controls={'nest-panel-'+id} tabindex={i===0?0:-1}>{label}</button>)}</div>
<div id="nest-panels" inert>
<section id="nest-panel-products" role="tabpanel" aria-labelledby="nest-tab-products"><div class="nest-split"><aside><h3>Products</h3><button type="button" id="nest-new-product">+ Add product</button><div id="nest-products" class="nest-list"></div></aside><div><form id="nest-product" class="nest-form"></form><div id="nest-publication" class="nest-actions"></div></div></div></section>
<section id="nest-panel-inventory" role="tabpanel" aria-labelledby="nest-tab-inventory" hidden><h3>Receive or adjust stock</h3><p>Count finished, sellable pieces only. Printing or receiving stock adds units; damage or a manual sale removes units. Estimates update on published listings immediately.</p><form id="nest-stock" class="nest-form"></form><h3>Colours & filament</h3><p>Finished inventory is counted per colour. Filament availability enables printing when that colour has no finished stock. Hide a colour to stop offering it without losing its stock history.</p><form id="nest-colour-product" class="nest-form"></form><div id="nest-colours" class="nest-list"></div><button type="button" id="nest-new-colour">+ Add colour</button><form id="nest-colour" class="nest-form"></form><h3>Recent stock movements</h3><p>Last 500 changes across the store. Export regularly to retain your history. This is not an order or accounting ledger.</p><div id="nest-movements" class="nest-list"></div></section>
<section id="nest-panel-collections" role="tabpanel" aria-labelledby="nest-tab-collections" hidden><h3>Collections & catalogues</h3><p>Group products into collections. Hiding a collection hides its filter; unpublish individual products to remove them from the shop.</p><div id="nest-collections" class="nest-list"></div><button type="button" id="nest-new-collection">+ Add collection</button><form id="nest-collection" class="nest-form"></form></section>
<section id="nest-panel-discounts" role="tabpanel" aria-labelledby="nest-tab-discounts" hidden><h3>Discounts & codes</h3><p>Leave the code blank for an automatic offer. One best eligible discount applies; offers do not stack. Usage limits and redemptions need the future checkout ledger.</p><div id="nest-discounts" class="nest-list"></div><button type="button" id="nest-new-discount">+ Add discount</button><form id="nest-discount" class="nest-form"></form></section>
<section id="nest-panel-shipping" role="tabpanel" aria-labelledby="nest-tab-shipping" hidden><h3>Australian shipping</h3><p>These are rates you set, not Australia Post quotes. An empty state selection covers all Australia. No matching rate means no estimate is available. International shipping is not configured.</p><form id="nest-shipping" class="nest-form"></form><div id="nest-rates" class="nest-list"></div><button type="button" id="nest-new-rate">+ Add shipping rate</button><form id="nest-rate" class="nest-form"></form><p>Australia Post is not connected. A live integration needs verified API access, parcel packing and real service/rate testing before checkout opens.</p></section>
<section id="nest-panel-estimate" role="tabpanel" aria-labelledby="nest-tab-estimate" hidden><h3>Test a customer estimate</h3><p>Uses published prices and current stock. This does not place an order, reserve stock or take a payment. Mixed physical orders ship together; the longest dispatch estimate applies. Shipping thresholds use the discounted merchandise total.</p><form id="nest-estimate" class="nest-form"></form><div id="nest-estimate-result" aria-live="polite"></div></section>
</div></div>
</Settings>
<script>import '../../scripts/hobbynest-admin.mjs';</script>
<style>
#nest-admin{font-size:14px}.nest-heading{display:flex;justify-content:space-between;gap:12px;align-items:start}.nest-heading p{margin:0}.nest-heading>a{font-size:12px;min-height:44px;display:inline-flex;align-items:center}.nest-notice{padding:10px 12px;border:1px solid var(--border);border-radius:6px}.nest-tools,.nest-actions{display:flex;gap:8px;flex-wrap:wrap}#nest-admin :global(button){font:inherit;min-height:44px;padding:8px 12px;cursor:pointer;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:6px}#nest-admin :global(button:disabled){opacity:.6;cursor:default}.nest-tabs{display:flex;overflow:auto;gap:6px;margin:16px 0}.nest-tabs button{flex-shrink:0}.nest-tabs [aria-selected=true]{background:var(--accent)!important;color:var(--surface)!important}.nest-split{display:grid;grid-template-columns:minmax(145px,.6fr) minmax(0,1.5fr);gap:20px}.nest-split>*{min-width:0}.nest-list{margin:10px 0 18px}.nest-list :global(.nest-row){display:flex;gap:8px;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border);padding:9px 0;overflow-wrap:anywhere}.nest-list :global(.nest-row>span){min-width:0}.nest-list :global(small){display:block;font-size:12px;opacity:.8}.nest-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:14px 0 20px}.nest-form :global(label){display:flex;flex-direction:column;gap:5px;min-width:0;font-size:12px}.nest-form :global(input),.nest-form :global(select),.nest-form :global(textarea){width:100%;box-sizing:border-box;font:inherit;font-size:16px;min-height:44px}.nest-form :global(textarea){border:1px solid var(--border);border-radius:6px;padding:10px;background:var(--surface);color:var(--text);resize:vertical}.nest-form :global(summary){cursor:pointer;min-height:44px;padding:10px 0}.nest-form :global(.nest-pack-grid){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.nest-form :global(.nest-wide){grid-column:1/-1}.nest-form :global(button){justify-self:start}.nest-form :global(select[multiple]){min-height:100px}.nest-form :global(.nest-help){margin:0;font-size:12px;opacity:.8;grid-column:1/-1}#nest-status{min-height:2.5em;opacity:1}#nest-estimate-result :global(p){opacity:1}@media(max-width:620px){.nest-split{grid-template-columns:minmax(0,1fr)}.nest-form{grid-template-columns:minmax(0,1fr)}.nest-heading{flex-wrap:wrap}.nest-list :global(.nest-row){flex-wrap:wrap}}@media(forced-colors:active){.nest-tabs [aria-selected=true]{outline:2px solid Highlight}}
</style>
