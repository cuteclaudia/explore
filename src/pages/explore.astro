---
import Base from '../layouts/Base.astro';
import ExploreTiles from '../components/ExploreTiles.astro';

const featured = [
  { img: '/images/blue-mountains.jpg', alt: 'The Three Sisters rock formation above forested valleys', where: 'Blue Mountains, NSW', title: 'The Three Sisters and Echo Point', blurb: 'Sandstone towers above endless blue-green valleys, a short trip from Sydney.', tags: ['Walk', 'Lookout', 'Photography'], credit: 'Celia Ferreira' },
  { img: '/images/twelve-apostles.jpg', alt: 'Limestone stacks of the Twelve Apostles reflected on wet sand at sunrise', where: 'Great Ocean Road, VIC', title: 'Sunrise at the Twelve Apostles', blurb: 'Limestone stacks glowing at first light along one of the world’s great coastal drives.', tags: ['Coastal', 'Photography', 'Road trip'], credit: 'Kaiser Concha' },
  { img: '/images/torres.jpg', alt: 'Jagged granite peaks above a turquoise lake in Patagonia', where: 'Patagonia, Chile', title: 'Torres del Paine', blurb: 'Granite spires, glacial lakes and wind-swept trails at the end of the world.', tags: ['Multi-day hike', 'Travel'], credit: 'William Warby' },
];
---
<Base title="Explore" description="Journeys, photography and the places in between.">
  <section class="hero" style="min-height:520px" aria-label="Explore">
    <img src="/images/dolomites-dusk.jpg" alt="" />
    <div class="wrap" style="padding-top:80px;padding-bottom:120px">
      <div class="hero-copy">
        <span class="eyebrow">Travel · Photography · Adventure</span>
        <h1>Your world, your experiences, your community.</h1>
        <p class="lead">Trigs and summits around Canberra, coastlines and cities further afield, and the stories that come back with me.</p>
      </div>
    </div>
    <span class="credit">Photo: Lucien Schreiber / Pexels</span>
  </section>

  <div class="wrap">
    <ExploreTiles />

    <section class="section" aria-labelledby="feat-h">
      <div class="section-head">
        <h2 id="feat-h">Places on my list</h2>
        <span class="muted">Remarkable places, close to home and further afield.</span>
      </div>
      <div class="grid-3">
        {featured.map((f) => (
          <article class="card">
            <div class="media"><img src={f.img} alt={f.alt} loading="lazy" /></div>
            <div class="body">
              <span class="meta">{f.where}</span>
              <h3>{f.title}</h3>
              <p>{f.blurb}</p>
              <div style="display:flex;flex-wrap:wrap;gap:6px">{f.tags.map((t) => <span class="chip">{t}</span>)}</div>
              <span class="credit">Photo: {f.credit} / Pexels</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="places" aria-labelledby="places-h">
      <div class="section-head">
        <h2 id="places-h">Places</h2>
        <span class="muted">A map of the trigs, summits and lookouts I’ve visited.</span>
      </div>
      <div class="empty">The places map arrives with the Explore build. It will show approximate areas rather than exact points, and visits appear after the fact.</div>
    </section>

    <section class="section" id="community" aria-labelledby="community-h">
      <div class="card" style="flex-direction:row;flex-wrap:wrap;gap:0">
        <img src="/images/member-post.jpg" alt="Hiker with a backpack looking out at jagged Dolomite peaks" loading="lazy" style="flex:1 1 320px;min-height:260px;object-fit:cover" />
        <div class="body" style="flex:1 1 360px;padding:30px">
          <span class="eyebrow">Coming later</span>
          <h2 id="community-h" class="serif" style="margin:4px 0 6px;font-size:32px">The Explore community</h2>
          <p>A place for explorers, photographers and adventurers to have their own little corner of the world, with their own page, palette and map. It will live at explore.claudiagilbert.com.</p>
          <span class="credit">Photo: Apollonia / Pexels</span>
        </div>
      </div>
    </section>
  </div>
</Base>
