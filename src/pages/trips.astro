---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Trips & events" description="Claudia’s published trips and events, alongside your own private travel plans.">
<section class="wrap trips-page"><header class="trips-heading"><div><span class="eyebrow">Journeys & moments</span><h1>Trips & events</h1><p>Claudia’s published entries are shared here. Your own entries stay private to your account.</p></div><button type="button" id="new-trip" class="btn" hidden><Icon name="plus" size={16}/>Add trip or event</button></header>
<div class="trip-tabs" role="group" aria-label="Entry list"><button type="button" data-trip-view="public" aria-pressed="true">Claudia’s published events</button><button type="button" data-trip-view="mine" hidden aria-pressed="false">My entries</button><button type="button" data-trip-view="bin" hidden aria-pressed="false">Deleted items</button></div><p id="trips-status" role="status">Loading published entries…</p><div class="trip-grid" id="trip-list"></div>
<dialog id="trip-editor"><form id="trip-form"><div class="trip-dialog-heading"><h2 id="trip-editor-title">New trip or event</h2><button type="button" id="trip-cancel" class="icon-control" aria-label="Close editor">×</button></div><p id="trip-privacy-note">This entry is private to your account.</p><label>Title<input id="trip-title" maxlength="180" required/></label><div class="trip-fields"><label>Type<select id="trip-type"><option value="trip">Trip</option><option value="event">Event</option></select></label><label>Start date<input id="trip-start" type="date" required/></label><label>End date (optional)<input id="trip-end" type="date"/></label></div><p class="trip-help">Dates are all-day entries. Include meeting times in the description if needed.</p><label>Description<textarea id="trip-description" rows="4" maxlength="4000"></textarea></label><label>Tags<input id="trip-tags" placeholder="Hiking, Japan, Skiing"/></label><details id="trip-location-section"><summary>Location / map pin</summary><label>Place name<input id="trip-location-name" maxlength="250"/></label><div class="trip-fields"><label>Latitude<input id="trip-lat" type="number" min="-85.05112878" max="85.05112878" step="any"/></label><label>Longitude<input id="trip-lng" type="number" min="-180" max="180" step="any"/></label></div><p class="trip-help">Leave both coordinates blank for an entry without a map pin. <a href="/places">Choose a point on the map →</a></p><label id="trip-precision-label" hidden>Published location<select id="trip-precision"><option value="approximate">Approximate · coordinates rounded to about 1 km</option><option value="hidden">Hidden · no public location</option><option value="exact">Exact · share the entered coordinates</option></select></label><p class="trip-help" id="public-location-help" hidden>The place name is public when location is shown. Enter a broad area rather than a private address.</p></details><p id="trip-form-status" role="status"></p><div class="trip-actions"><button class="btn" type="submit">Save private entry</button><button class="btn" type="button" id="publish-trip" hidden>Publish for everyone</button><button class="btn ghost" type="button" id="unpublish-trip" hidden>Unpublish</button></div></form></dialog>
<p class="trip-signin" id="trip-signin" hidden><a href="/studio/login?next=%2Ftrips">Sign in</a> to manage your own private entries.</p></section>
</Base>
<script>import '../scripts/trips';</script>
<style>.trips-page{max-width:1140px;padding-top:40px;padding-bottom:70px}.trips-heading{display:flex;align-items:center;justify-content:space-between;gap:20px}.trips-heading h1{font:450 46px var(--serif);margin:14px 0}.trips-heading p{font-size:14px;opacity:.7;max-width:65ch}.trip-tabs{display:flex;gap:20px;margin:30px 0}.trip-tabs button{border:0;background:none;border-bottom:1px solid transparent;color:var(--text);padding:10px 0;font-size:13px;cursor:pointer}.trip-tabs button[aria-pressed=true]{border-color:var(--accent)}.trip-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px}.trip-grid :global(article){border-top:1px solid var(--border);padding:22px 0}.trip-grid :global(h2){font:450 25px var(--serif);margin:10px 0}.trip-grid :global(p){font-size:13px;white-space:pre-wrap;overflow-wrap:anywhere}.trip-grid :global(.trip-meta){font-size:11px;opacity:.65}.trip-grid :global(.trip-row-actions){display:flex;gap:12px;flex-wrap:wrap;margin-top:20px}.trip-grid :global(button){border:0;background:none;padding:5px 0;color:var(--accent);font-size:12px;cursor:pointer}.trip-grid :global(a){font-size:12px}.trip-signin{margin-top:30px;font-size:13px}#trip-editor{max-width:720px;width:calc(100% - 35px);max-height:90vh;overflow:auto;padding:25px;background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:12px}#trip-editor::backdrop{background:#0008}.trip-dialog-heading{display:flex;align-items:center;justify-content:space-between}.trip-dialog-heading h2{font:450 28px var(--serif);margin:0}#trip-editor label{display:block;font-size:13px;margin:16px 0}#trip-editor input,#trip-editor select,#trip-editor textarea{display:block;width:100%;padding:10px;margin-top:7px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text);font:14px system-ui}.trip-fields{display:flex;gap:15px;flex-wrap:wrap}.trip-fields>label{flex:1;min-width:135px}.trip-help,#trip-privacy-note{font-size:12px;opacity:.7}#trip-location-section summary{font-size:13px;cursor:pointer;padding:10px 0}.trip-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}#trips-status,#trip-form-status{font-size:13px}@media(max-width:650px){.trip-grid{grid-template-columns:1fr}.trips-heading{align-items:flex-start;flex-direction:column}.trips-heading h1{font-size:36px}.trip-tabs{gap:14px;flex-wrap:wrap}.trip-tabs button{font-size:12px}}</style>
