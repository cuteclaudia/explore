---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import { getEssays, formatDate, readingTime } from '../../lib/site';

export async function getStaticPaths() {
  const essays = await getEssays();
  return essays.map((essay, i) => ({
    params: { slug: essay.id },
    props: { essay, newer: essays[i - 1], older: essays[i + 1] },
  }));
}
const { essay, newer, older } = Astro.props;
const { Content } = await render(essay);
const img = essay.data.heroImage || essay.data.legacyHeroImage;
---
<Base title={essay.data.title} description={essay.data.summary} image={img ?? undefined}>
  <article>
    <header class="article-head wrap">
      <div class="inner">
        <a class="eyebrow" href="/chinaseries" style="text-decoration:none">China Series</a>
        <h1>{essay.data.title}</h1>
        <div class="meta">
          <span>Claudia Gilbert</span>
          <time datetime={essay.data.date.toISOString()}>{formatDate(essay.data.date)}</time>
          <span>{readingTime(essay.body)}</span>

        </div>
        <Tags tags={essay.data.tags} />
      </div>
    </header>
    {img && <figure class="article-hero" style="margin-top:0"><img src={img} alt={essay.data.heroAlt} /></figure>}
    <div class="prose"><Content /></div>
    <nav class="article-foot" aria-label="More essays">
      {older ? <a href={`/chinaseries/${older.id}`}>← {older.data.title.split(':')[0]}</a> : <span></span>}
      {newer ? <a href={`/chinaseries/${newer.id}`}>{newer.data.title.split(':')[0]} →</a> : <span></span>}
    </nav>
  </article>
</Base>
