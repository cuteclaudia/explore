---
import LanguagePicker from '../components/LanguagePicker.astro';
import Settings from '../layouts/Settings.astro';
import Icon from '../components/Icon.astro';
---
<Settings title="Appearance settings" section="appearance">
<section class="settings-section" id="appearance"><h2>Appearance</h2><p>Choose a colour story for Explore. System uses your device’s default colours and light/dark setting. You can also choose your own palette.</p><div class="theme-presets" id="theme-presets" role="group" aria-label="Colour themes"><button type="button" id="theme-system" aria-pressed="false"><span class="theme-swatches system-swatches" aria-hidden="true"><i></i><i></i></span><span class="theme-name">System</span></button></div><details class="custom-colours"><summary>Make it yours · custom colours</summary><div class="colour-fields">{[['bg','Background'],['ink','Text'],['accent','Accent'],['surface','Surfaces']].map(([id,label])=><label>{label}<input type="color" data-theme-colour={id}/></label>)}</div></details></section>
<section class="settings-section" id="language"><h2 data-i18n="Language">Language</h2><p data-i18n="Use your device language or choose your own. Language changes are saved immediately on this browser.">Use your device language or choose your own. Language changes are saved immediately on this browser.</p><LanguagePicker/></section>
<section class="settings-section"><h2>Comfort</h2><div class="setting-row"><div><label for="setting-landing">After sign-in</label><p>Open your personal Studio or the public homepage.</p></div><select id="setting-landing"><option value="studio">My Studio</option><option value="home">Home</option></select></div><div class="setting-row"><label for="setting-density">Interface spacing</label><select id="setting-density"><option value="comfortable">Comfortable</option><option value="compact">Compact</option></select></div><div class="setting-row"><div><label for="setting-motion">Reduce motion</label><p>Keep transitions and interface animation to a minimum.</p></div><input id="setting-motion" type="checkbox"/></div></section>
<div class="settings-save"><button class="btn" id="save-appearance" type="button">Save preferences</button><button class="btn ghost" id="reset-appearance" type="button">Reset appearance</button></div><p id="appearance-status" role="status">Appearance is saved on this browser. Sign in to save preferences to your account.</p>
<section class="settings-section connection-intro"><h2>Your apps, your storage</h2><p>Set a default save destination and connect WebDAV once for all your apps. Each app still asks before saving an export.</p><a class="setting-link" href="/studio/storage">Manage files & storage <Icon name="arrow" size={16}/></a></section>
</Settings>
<script>import '../scripts/appearance-settings';</script>
<style>.theme-presets{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:16px 0}.theme-presets :global(button){border:1px solid var(--border);background:transparent;color:var(--text);border-radius:8px;padding:10px;text-align:left;cursor:pointer}.theme-presets :global(button[aria-pressed=true]){outline:2px solid var(--accent);outline-offset:2px}.theme-presets :global(.theme-swatches){display:flex;height:22px;border-radius:5px;overflow:hidden;margin-bottom:8px}.theme-presets :global(.theme-swatches i){flex:1}.theme-presets :global(button[aria-pressed=true] .theme-name)::after{content:' ✓';margin-left:5px}.theme-presets :global(.theme-name){font-size:13px}.system-swatches i:first-child{background:Canvas}.system-swatches i:last-child{background:Highlight}.custom-colours summary{cursor:pointer;font-size:13px;padding:8px 0}.colour-fields{display:flex;flex-wrap:wrap;gap:20px;margin:15px 0}.colour-fields label{display:flex;gap:8px;align-items:center}.colour-fields input{width:32px;height:32px;padding:0;border:0;background:none}.setting-row{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:16px}.setting-row select{flex:0 0 155px;max-width:55%}.setting-row p{margin:5px 0}.setting-row input{width:18px;height:18px;accent-color:var(--accent)}.settings-save{display:flex;gap:12px;align-items:center}.connection-intro{margin-top:24px!important}.setting-link{font-size:14px;text-decoration:none;display:inline-flex;gap:25px;align-items:center}@media(max-width:500px){.theme-presets{grid-template-columns:1fr 1fr}.setting-row{align-items:flex-start;gap:12px}}</style>
