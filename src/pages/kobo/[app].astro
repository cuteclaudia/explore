---
import Base from '../../layouts/Base.astro';
import {appDestination} from '../../lib/app-destinations.mjs';
import KoboIcon from '../../components/KoboIcon.astro';
import {KOBO_APPS} from '../../lib/kobo-catalogue.mjs';
export function getStaticPaths(){return KOBO_APPS.map(app=>({params:{app:app.id},props:{app}}));}
const {app}=Astro.props;
---
<Base title={app.name+' · SoraSpace'} description={app.description}><section class="wrap product-page"><a href="/kobo">← All SoraSpace apps</a><header><KoboIcon name={app.id} size={76}/><div><span class="eyebrow">SoraSpace · {app.kind}</span><div class="product-name"><h1>{app.name}</h1><small lang="ja">{app.legacyName} · {app.japaneseName}</small></div><span class="product-status">{app.status}</span></div></header><p class="product-lead">{app.description}</p><section aria-labelledby="features"><h2 id="features">A closer look</h2><ul>{app.features.map(feature=><li>{feature}</li>)}</ul></section><section class="product-platforms" aria-labelledby="availability"><h2 id="availability">Platforms & availability</h2><p>Windows and Linux builds are in development or testing. macOS is planned, with no release date announced.</p><p>{app.web?'Web access is invitation-only while testing and release acceptance continue.':'This app is desktop only at this stage. A browser version is not available.'}</p><p>Microsoft Store · Forthcoming. Store links and screenshots will be added when reviewed releases are ready. No public installer is offered on this page.</p><a class="btn" href={appDestination(app)} data-app-launch target="_blank" rel="noopener">Open {app.web?'app':'desktop app area'} ↗</a></section><footer><a href={'https://github.com/cuteclaudia/'+app.id+'-releases/blob/main/PRIVACY.md'} target="_blank" rel="noopener noreferrer">Desktop privacy information ↗</a><a href="/contact">Privacy questions</a><a href="/contact">Ask about {app.name}</a></footer></section></Base>
<style>.product-page{max-width:850px;padding-block:24px 40px}.product-page>a{font-size:12px}.product-page header{display:flex;gap:20px;align-items:center;margin:24px 0 16px}.product-page h1{font:450 clamp(36px,6vw,52px)/1.1 var(--serif);margin:6px 0}.product-status{font-size:12px;opacity:.7}.product-lead{font-size:17px;line-height:1.65;max-width:55ch}.product-page section{border-top:1px solid var(--border);padding-top:16px;margin-top:22px}.product-page h2{font:450 26px var(--serif);margin:0 0 12px}.product-page li,.product-page section p{font-size:14px;line-height:1.7}.product-page ul{padding-left:20px}.product-page footer{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:22px}.product-page footer a{font-size:12px;min-height:44px;display:inline-flex;align-items:center}.product-page .btn{font-size:13px;min-height:44px;display:inline-flex;align-items:center}@media(max-width:450px){.product-page header{gap:14px}.product-page .eyebrow{font-size:10px}.product-lead{font-size:15px}}</style>

<script>import '../../scripts/app-launch.mjs';</script>

<style>.product-name{display:flex;align-items:baseline;gap:8px 12px;flex-wrap:wrap}.product-name small{font:12px/1.5 system-ui;opacity:.7}</style>
