---
import Base from '../layouts/Base.astro';
import KoboIcon from '../components/KoboIcon.astro';
import Icon from '../components/Icon.astro';
const apps=[
 {id:'hikari',name:'Hikari',kind:'Photo development',description:'Shape light, colour and exposure, and bring a collection of photographs together.',status:'In testing'},
 {id:'irodori',name:'Irodori',kind:'Image editing',description:'Build an image with layers, masks, selections and adjustments.',status:'In testing'},
 {id:'fumi',name:'Fumi',kind:'Documents',description:'A place for words, considered page layouts and documents you can share.',status:'In development'},
 {id:'tsuzuri',name:'Tsuzuri',kind:'PDF workspace',description:'Read, organise and work with PDFs in a dedicated workspace.',status:'In development'},
];
---
<Base title="Kōbō creative apps" description="Meet Claudia’s Kōbō creative apps for photographs, images, documents and PDFs. Follow desktop, web and future macOS releases.">
<section class="wrap software-page"><header class="software-intro"><div><span class="eyebrow">工房 · A workshop for your ideas</span><h1>Creative tools.<br/>Room to make them yours.</h1><p>Kōbō brings my creative apps together: a place for photographs, images, words and the work that follows your curiosity.</p><div class="intro-actions"><a class="btn" href="/apps">Open My apps <Icon name="arrow" size={16}/></a><a href="#meet-apps">Meet the apps ↓</a></div><p class="release-note">The suite is in development and testing. Web access is currently invitation-only.</p></div><div class="app-mosaic" aria-hidden="true">{apps.map(app=><span><KoboIcon name={app.id} size={52}/><small>{app.name}</small></span>)}</div></header>
<section id="meet-apps" aria-labelledby="apps-heading"><div class="section-heading"><h2 id="apps-heading">Meet your workshop.</h2><span>Four different ways to create</span></div><div class="software-grid">{apps.map(app=><article><div class="app-heading"><KoboIcon name={app.id} size={46}/><div><h3>{app.name}</h3><span>{app.kind}</span></div><small class="release-status">{app.status}</small></div><p>{app.description}</p><div class="platforms"><span>Windows</span><span>Linux</span><span>Web</span><span class="planned">macOS · Planned</span></div></article>)}</div></section>
<section class="release-panel" aria-labelledby="releases-heading"><div><span class="eyebrow">A home here. More places to follow.</span><h2 id="releases-heading">Desktop and web, together.</h2><p>My apps will continue to have a home on this website. Microsoft Store listings are planned; links will appear here when the releases are published. macOS builds remain part of the roadmap.</p><p>Access plans and release details will be announced when they are ready. Existing testers can use My apps to open their enabled tools and find configured desktop downloads.</p></div><div class="release-actions"><span class="store-status"><Icon name="grid" size={18}/>Microsoft Store · Forthcoming</span><a href="/apps">Your app library <Icon name="arrow" size={15}/></a><a href="/contact">Ask about the apps <Icon name="arrow" size={15}/></a></div></section>
</section></Base>
<style>
.software-page{max-width:1180px;padding-top:28px;padding-bottom:36px}.software-intro{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:40px;align-items:center;padding:14px 0 30px}.software-intro h1{font:450 clamp(35px,4vw,53px)/1.05 var(--serif);letter-spacing:-.025em;margin:12px 0 16px}.software-intro p{font-size:15px;line-height:1.65;max-width:49ch}.intro-actions{display:flex;flex-wrap:wrap;align-items:center;gap:20px;margin-top:20px}.intro-actions a{display:inline-flex;align-items:center;gap:8px;font-size:13px}.software-intro .release-note{font-size:12px;opacity:.7;margin-top:14px}.app-mosaic{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;max-width:360px;justify-self:center;transform:rotate(-3deg);width:100%}.app-mosaic>span{display:flex;flex-direction:column;align-items:center;gap:10px;padding:22px;background:var(--surface);border:1px solid var(--border);border-radius:15px;box-shadow:0 8px 25px #00000006}.app-mosaic small{font-size:12px}.section-heading{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:14px}.section-heading h2,.release-panel h2{font:450 30px/1.1 var(--serif);margin:0}.section-heading>span{font-size:12px;opacity:.7}.software-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.software-grid article{padding:20px;border:1px solid var(--border);border-radius:9px;background:var(--surface);min-width:0}.app-heading{display:flex;gap:12px;align-items:center}.app-heading h3{font:450 27px/1.1 var(--serif);margin:0 0 4px}.app-heading>div>span{font-size:12px;opacity:.7}.release-status{margin-left:auto;font-size:10px;border:1px solid var(--border);padding:4px 7px;border-radius:4px;white-space:nowrap}.software-grid p{font-size:13px;line-height:1.65;margin:14px 0}.platforms{display:flex;flex-wrap:wrap;gap:6px}.platforms span{font-size:10px;border:1px solid var(--border);padding:4px 7px;border-radius:4px}.platforms .planned{border-style:dashed;opacity:.7}.release-panel{margin-top:22px;padding:22px;border:1px solid var(--border);border-radius:9px;display:grid;grid-template-columns:1fr 270px;gap:24px}.release-panel h2{margin-top:8px}.release-panel p{font-size:13px;line-height:1.65;margin:12px 0 0}.release-actions{display:flex;flex-direction:column;justify-content:center;gap:16px}.release-actions a,.store-status{display:flex;align-items:center;gap:9px;font-size:12px}.store-status{padding:12px;border:1px dashed var(--border);border-radius:5px;opacity:.75}@media(max-width:800px){.software-intro{gap:22px}.app-mosaic{gap:10px}.app-mosaic>span{padding:16px}.app-mosaic :global(svg){width:55px;height:55px}.release-panel{grid-template-columns:1fr}.release-actions{flex-direction:row;align-items:center;flex-wrap:wrap}}@media(max-width:600px){.software-page{padding-top:18px}.software-intro{grid-template-columns:minmax(0,1fr);padding-bottom:22px}.software-intro h1{font-size:38px}.software-intro p{font-size:14px}.app-mosaic{max-width:none;grid-template-columns:repeat(4,1fr);transform:none;gap:7px}.app-mosaic>span{padding:12px 4px;border-radius:8px}.app-mosaic :global(svg){width:42px;height:42px}.app-mosaic small{font-size:10px}.section-heading{display:block}.section-heading h2{margin-bottom:8px}.software-grid{grid-template-columns:1fr}.software-grid article{padding:16px}.release-panel{padding:16px}.release-actions{align-items:flex-start;flex-direction:column}.intro-actions>a,.release-actions>a{min-height:44px}.software-intro .eyebrow{font-size:10px}}
</style>
