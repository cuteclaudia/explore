---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Places & map" description="Explore featured places in 2D and 3D, and view a private GPX track in your browser.">
<section class="wrap map-page"><header class="map-heading"><div><span class="eyebrow">A little further</span><h1>Find your next perspective.</h1><p>Featured places, open maps, and room to explore.</p></div><a href="/settings/connections" class="map-connections"><Icon name="settings" size={16}/>Activity connections</a></header>
<div class="explore-map-shell"><aside class="map-sidebar"><h2>Explore places</h2><form id="world-search" class="world-search"><label class="sr-only" for="world-query">Search anywhere in the world</label><input id="world-query" type="search" minlength="2" maxlength="160" placeholder="Search anywhere in the world…" required/><button type="submit" aria-label="Search places"><Icon name="arrow" size={16}/></button></form><div id="world-results" class="world-results" aria-live="polite"></div><p class="world-search-note">Place search: Photon / OpenStreetMap</p><h3 class="featured-heading">Featured places</h3><label class="sr-only" for="place-search">Search featured places</label><input id="place-search" type="search" placeholder="Search featured places…"/><div id="featured-places"></div><div class="map-events-shortcut"><a href="/trips">Trips & events →</a><button id="pick-event-location" type="button" class="btn ghost" hidden>Add a pin</button><p id="event-map-status" role="status"></p></div><div class="track-import"><h3>Your route</h3><p>View a GPX export from Strava, Garmin or Komoot. It stays in this browser and is never uploaded by this map.</p><label class="gpx-import"><Icon name="plus" size={16}/>Open GPX file<input id="gpx-file" type="file" accept=".gpx,application/gpx+xml,application/xml,text/xml"/></label><button id="clear-track" class="btn ghost" type="button" hidden>Clear track</button><p id="track-status" role="status"></p></div></aside>
<div class="map-stage"><div id="explore-map" aria-label="Interactive map of featured places"></div><div class="map-mode" role="group" aria-label="Map view"><button type="button" data-map-mode="2d" aria-pressed="true">2D</button><button type="button" data-map-mode="3d" aria-pressed="false">3D terrain</button><details id="map-layer-menu"><summary><Icon name="layers" size={16}/>Layers</summary><div class="map-layer-options"><h3>Map layers</h3><div id="map-layer-options"></div><label>Labels<select id="map-label-density"><option value="normal">Normal</option><option value="more">More labels</option></select></label><p>Zoom in for small creeks, paths and local names. Unnamed features cannot be labelled.</p><button type="button" id="save-map-layers">Save layer preferences</button><p id="map-layer-status" role="status"></p></div></details></div><p id="outdoor-status" class="outdoor-status" role="status"></p><p id="map-status" role="status">Loading open map…</p><div class="map-fallback" id="map-fallback" hidden><h2>The map couldn’t load.</h2><p>Check your connection or try a browser with WebGL enabled. Featured places remain listed.</p><a href="/photography">Browse photography →</a></div></div>
<section id="track-details" class="track-details" hidden><div><span class="eyebrow">Private route preview</span><h2 id="track-name"></h2><p id="track-metrics"></p></div><svg id="track-profile" viewBox="0 0 600 110" role="img" aria-label="Elevation profile from the imported GPX file"><path id="elevation-line" fill="none" stroke="currentColor" stroke-width="2"/></svg><p id="elevation-note"></p></section>
</div><p class="map-footnote">Maps: OpenFreeMap / OpenStreetMap. 3D heights: Mapzen terrain data. Terrain is approximate; this map is for exploring and viewing tracks, not navigation or live position tracking. <a href="/map-credits">Map credits & data sources</a>.</p></section>
</Base>
<script>import '../scripts/explore-map';</script>
<style>.map-page{max-width:1480px;padding-top:38px;padding-bottom:45px}.map-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:30px}.map-heading h1{font:450 clamp(30px,4vw,48px)/1.15 var(--serif);margin:14px 0}.map-heading p{font-size:14px;opacity:.65}.map-connections{display:flex;align-items:center;gap:8px;font-size:12px;text-decoration:none;white-space:nowrap}.explore-map-shell{display:grid;grid-template-columns:245px minmax(0,1fr);border:1px solid var(--border);border-radius:12px;overflow:hidden;background:var(--surface)}.map-sidebar{padding:22px}.map-sidebar h2{font-size:20px;font-weight:450;font-family:var(--serif);margin:0 0 20px}.map-sidebar input[type=search]{width:100%;padding:10px;border:1px solid var(--border);border-radius:5px;color:var(--text);background:var(--bg);font-size:12px}.map-sidebar :global(.place-button){display:block;width:100%;text-align:left;padding:15px 0;border:0;border-bottom:1px solid var(--border);background:none;color:var(--text);cursor:pointer}.map-sidebar :global(.place-button strong){display:block;font-size:13px;font-weight:500}.map-sidebar :global(.place-button span){font-size:11px;opacity:.6}.map-sidebar :global(.place-button[aria-pressed=true]){color:var(--accent)}.track-import{margin-top:30px}.track-import h3{font-size:14px;font-weight:500}.track-import p{font-size:11px;line-height:1.6;opacity:.7}.gpx-import{display:inline-flex;align-items:center;gap:8px;font-size:12px;cursor:pointer;padding:10px 0}.gpx-import input{position:absolute;width:1px;height:1px;clip:rect(0,0,0,0)}.gpx-import:focus-within{outline:2px solid var(--accent);outline-offset:4px}.map-stage{position:relative;min-height:600px;background:var(--surface-2)}#explore-map{position:absolute;inset:0}.map-mode{position:absolute;top:16px;left:16px;display:flex;gap:3px;background:var(--surface);padding:3px;border-radius:7px;box-shadow:0 2px 10px #0001}.map-mode button{padding:8px 12px;border:0;border-radius:5px;background:transparent;color:var(--text);font-size:12px;cursor:pointer}.map-mode button[aria-pressed=true]{background:var(--accent);color:var(--on-accent)}#map-status{position:absolute;left:16px;bottom:28px;max-width:75%;padding:7px 10px;background:var(--surface);font-size:11px;border-radius:5px;pointer-events:none}.map-fallback{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:30px;background:var(--bg);text-align:center}.map-fallback p{font-size:14px;max-width:45ch}.track-details{grid-column:1/-1;display:grid;grid-template-columns:250px 1fr;align-items:center;gap:15px;padding:20px 25px;border-top:1px solid var(--border)}.track-details h2{font:450 22px var(--serif);margin:10px 0}.track-details p,.map-footnote{font-size:11px;opacity:.65}.track-details svg{width:100%;height:120px;color:var(--accent)}#elevation-note{grid-column:1/-1;margin:0}.map-footnote{margin-top:16px}.map-stage :global(.maplibregl-popup-content){background:var(--surface);color:var(--text);padding:12px;font:13px system-ui;border-radius:8px}.map-stage :global(.maplibregl-ctrl-attrib){color:#222!important;background:#ffffffe6!important}@media(max-width:750px){.explore-map-shell{grid-template-columns:1fr}.map-heading{align-items:flex-start;flex-direction:column;gap:0}.map-sidebar{padding:18px}.map-sidebar #featured-places{display:flex;overflow:auto;gap:20px}.map-sidebar :global(.place-button){min-width:150px;border:0}.track-import{margin-top:12px}.map-stage{min-height:460px}.track-details{grid-template-columns:1fr}.map-heading h1{font-size:34px}}.map-mode{z-index:3;align-items:center}.map-mode details{position:relative}.map-mode summary{display:flex;align-items:center;gap:6px;font-size:12px;cursor:pointer;list-style:none;padding:8px}.map-mode summary::-webkit-details-marker{display:none}.map-layer-options{position:absolute;left:0;top:calc(100% + 8px);width:265px;max-height:420px;overflow:auto;padding:16px;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:8px;box-shadow:0 8px 25px #0002}.map-layer-options h3{font-size:14px;margin:0 0 12px}.map-layer-options label{display:flex;align-items:center;gap:9px;font-size:12px;margin:11px 0}.map-layer-options input{accent-color:var(--accent);width:15px;height:15px}.map-layer-options p{font-size:11px;line-height:1.5;opacity:.7}.map-layer-options select{max-width:150px;color:var(--text);background:var(--surface);border:1px solid var(--border);padding:5px}.map-events-shortcut{margin-top:24px;padding-top:18px;border-top:1px solid var(--border)}.map-events-shortcut a{font-size:13px;display:block;margin-bottom:10px;text-decoration:none}.map-events-shortcut p{font-size:11px;opacity:.7}.event-popup a{display:block;margin-top:8px}@media(max-width:500px){.map-layer-options{left:auto;right:-10px;width:245px}} .world-search{display:flex;gap:5px}.world-search input{min-width:0;font-size:11px!important}.world-search button{border:1px solid var(--border);border-radius:5px;background:var(--surface);color:var(--text);padding:6px;cursor:pointer}.world-results button{overflow-wrap:anywhere;display:block;width:100%;text-align:left;padding:10px 0;border:0;border-bottom:1px solid var(--border);background:none;color:var(--accent);font-size:11px;cursor:pointer}.world-results p,.world-search-note{font-size:10px;opacity:.7}.featured-heading{font-size:12px;margin-top:24px}.outdoor-status{position:absolute;left:16px;bottom:65px;max-width:80%;background:var(--surface);font-size:11px;padding:5px 9px;border-radius:4px;pointer-events:none}.outdoor-status:empty{display:none} </style>
