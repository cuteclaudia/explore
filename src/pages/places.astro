---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
const satelliteKey=(import.meta.env.PUBLIC_MAPTILER_KEY||'').trim();
const activities=[['hiking','Hiking'],['mtb','Mountain biking'],['skiing','Skiing'],['climbRoutes','Rock climbing'],['iceClimbing','Ice climbing'],['climbing','Climbing sites'],['alpine','Alpine & via ferrata']];
---
<Base title="Explore places & trails" description="Discover mapped hiking routes, mountain biking tracks, ski pistes and climbing sites. Explore in 2D or 3D, or preview your own GPX privately.">
<section class="wrap map-page" id="explore-planner" data-view="map" data-satellite-key={satelliteKey}>
  <header class="map-heading"><div><span class="eyebrow">Places, paths & possibilities</span><h1>Find your next perspective.</h1></div><a href="/trips">My trips & plans →</a></header>
  <div class="explore-toolbar">
    <form id="world-search" class="world-search"><label class="sr-only" for="world-query">Search places, mountains or towns</label><input id="world-query" type="search" minlength="2" maxlength="160" placeholder="Search a place, mountain or town…" required/><button type="submit" aria-label="Search places"><Icon name="arrow" size={18}/></button></form>
    <div class="view-switch" role="group" aria-label="Explore view"><button type="button" data-explore-view="map" aria-pressed="true">Map</button><button type="button" data-explore-view="list" aria-pressed="false">List</button></div>
  </div>
  <div id="world-results" class="world-results" aria-live="polite"></div>
  <div class="activity-filters" role="group" aria-label="Show mapped activities">{activities.map(([id,label])=><button type="button" title={id==='alpine'?'Via ferrata: mountain routes with fixed cables, rungs or ladders.':undefined} data-activity={id} aria-pressed="false">{label}</button>)}</div>
  <p id="satellite-status" class="reference-status" role="status"></p>
  <p id="climbing-status" class="reference-status" role="status"></p>
  <p id="reference-status" class="reference-status" role="status"></p>
  <div class="explore-map-shell">
    <aside class="map-sidebar">
      <section class="route-results" aria-labelledby="mapped-heading"><div class="results-heading"><h2 id="mapped-heading">In this area</h2><span id="outdoor-count"></span></div><p id="route-list-status" role="status">Choose an activity.</p><button type="button" id="reload-outdoor" class="reload-outdoor" hidden>Refresh this area</button><div id="outdoor-list" class="outdoor-list"></div><div id="outdoor-detail" hidden></div></section>
      <details class="planner-section" open><summary>Places to explore</summary><div id="featured-places"></div></details>
      <details class="planner-section"><summary>Your GPX route</summary><div class="track-import"><p>Open an existing GPX track to see its distance and elevation profile. The file stays in this browser.</p><label class="gpx-import"><Icon name="plus" size={16}/>Open GPX file<input id="gpx-file" type="file" accept=".gpx,application/gpx+xml,application/xml,text/xml"/></label><button id="clear-track" class="btn ghost" type="button" hidden>Clear track</button><p id="track-status" role="status"></p></div></details>
      <details class="planner-section"><summary>Trips & connections</summary><div class="map-events-shortcut"><a href="/trips">My trips & events →</a><button id="pick-event-location" type="button" class="btn ghost" hidden>Add a private pin</button><p id="event-map-status" role="status"></p><a href="/settings/connections">Activity connections →</a></div></details>
    </aside>
    <div class="map-stage" id="map-stage"><div id="explore-map" aria-label="Interactive map of places and trails"></div><div class="map-mode" role="group" aria-label="Map view"><button type="button" data-map-mode="2d" aria-pressed="true">2D</button><button type="button" data-map-imagery="satellite" aria-pressed="false" hidden={!satelliteKey}>Satellite</button><button type="button" data-map-mode="3d" aria-pressed="false">3D terrain</button><details id="map-layer-menu"><summary><Icon name="layers" size={16}/>Layers</summary><div class="map-layer-options"><h3>Map layers</h3><div id="map-layer-options"></div><label>Labels<select id="map-label-density"><option value="normal">Normal</option><option value="more">More labels</option></select></label><p>Zoom in for mapped creeks, paths and local names.</p><button type="button" id="save-map-layers">Save layer preferences</button><p id="map-layer-status" role="status"></p></div></details></div><p id="outdoor-status" class="outdoor-status" role="status"></p><p id="map-status" role="status">Loading open map…</p><div class="map-fallback" id="map-fallback" hidden><h2>The map couldn’t load.</h2><p>Try List view to browse featured places, or check your connection and WebGL support.</p><button type="button" data-explore-view="list">Open List view</button></div></div>
    <section id="track-details" class="track-details" hidden><div><span class="eyebrow">Private route preview</span><h2 id="track-name"></h2><p id="track-metrics"></p></div><svg id="track-profile" viewBox="0 0 600 110" role="img" aria-label="Elevation profile from the imported GPX file"><path id="elevation-line" fill="none" stroke="currentColor" stroke-width="2"/></svg><p id="elevation-note"></p></section>
  </div>
  <p class="provider-credits">{satelliteKey&&<span>Satellite: <a href="https://www.maptiler.com/copyright/">© MapTiler & imagery contributors</a>. </span>}Data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors · ODbL</a>. Trail overlays: <a href="https://waymarkedtrails.org/">Waymarked Trails</a> · <a href="https://creativecommons.org/licenses/by-sa/3.0/de/">CC BY-SA 3.0 DE</a>; ski overlays: <a href="https://www.opensnowmap.org/">OpenSnowMap</a> · <a href="https://creativecommons.org/licenses/by-sa/">CC BY-SA</a>.</p>
  <p class="map-footnote">Community-mapped features can be incomplete. Check access, closures and conditions with the land manager or resort. Climbing sites and individual routes are labelled separately. Pins may use an area location; they are not pitch topos or current ice-condition reports. <a href="/map-credits">Sources & map credits</a>.</p>
</section>
</Base>
<script>import '../scripts/explore-map';</script>
<style>
.map-page{max-width:1480px;padding-top:20px;padding-bottom:28px}.map-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px}.map-heading h1{font:450 clamp(27px,3.4vw,38px)/1.12 var(--serif);margin:5px 0 0}.map-heading>a{font-size:12px;white-space:nowrap;text-decoration:none}.explore-toolbar{display:flex;gap:12px;align-items:center}.world-search{display:flex;flex:1;max-width:680px;gap:6px}.world-search input{width:100%;min-width:0;flex:1;padding:10px 12px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text);font:16px system-ui}.world-search button,.view-switch button{padding:9px 12px;border:1px solid var(--border);border-radius:5px;background:var(--surface);color:var(--text);cursor:pointer}.world-search button{display:flex;align-items:center}.view-switch{display:flex;gap:4px;margin-left:auto}.view-switch button{font-size:13px}.view-switch button[aria-pressed=true],.activity-filters button[aria-pressed=true]{background:var(--accent);color:var(--on-accent);border-color:var(--accent)}.activity-filters{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0}.activity-filters button{font:13px system-ui;padding:8px 12px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text);cursor:pointer}.world-results{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:0 16px}.world-results:empty{display:none}.world-results :global(button){width:100%;text-align:left;padding:10px 0;border:0;border-bottom:1px solid var(--border);background:none;color:var(--accent);font:13px/1.5 system-ui;cursor:pointer;overflow-wrap:anywhere}.world-results :global(p){font-size:13px}.explore-map-shell{display:grid;grid-template-columns:270px minmax(0,1fr);border:1px solid var(--border);border-radius:9px;overflow:hidden;background:var(--surface)}.map-sidebar{padding:14px;min-width:0;max-height:650px;overflow:auto}.results-heading{display:flex;justify-content:space-between;gap:8px;align-items:center}.results-heading h2{font:450 22px var(--serif);margin:0}.results-heading span{font-size:11px;opacity:.7}#route-list-status{font-size:12px;line-height:18px;height:18px;min-height:18px;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:8px 0}.reload-outdoor{font:12px system-ui;padding:8px 10px;border:1px solid var(--border);border-radius:5px;background:var(--surface);color:var(--text);cursor:pointer;margin-bottom:5px}.outdoor-list{display:grid;gap:0}.outdoor-list :global(button),.map-sidebar :global(.place-button){display:block;width:100%;text-align:left;padding:11px 0;border:0;border-bottom:1px solid var(--border);background:none;color:var(--text);cursor:pointer}.outdoor-list :global(strong),.map-sidebar :global(.place-button strong){display:block;font:500 13px/1.5 system-ui;overflow-wrap:anywhere}.outdoor-list :global(span),.map-sidebar :global(.place-button span){display:block;font:12px/1.5 system-ui;opacity:.75}.outdoor-list :global(button[aria-pressed=true]),.map-sidebar :global(.place-button[aria-pressed=true]){color:var(--accent)}.planner-section{border-top:1px solid var(--border);margin-top:14px;padding-top:11px}.planner-section summary{font-size:13px;font-weight:500;cursor:pointer;min-height:26px}.track-import p,.map-events-shortcut p{font-size:12px;line-height:1.6}.gpx-import{display:inline-flex;gap:8px;align-items:center;font-size:13px;cursor:pointer;padding:10px 0}.gpx-import input{position:absolute;width:1px;height:1px;clip-path:inset(50%)}.gpx-import:focus-within{outline:2px solid var(--accent);outline-offset:3px}.map-events-shortcut a{display:block;font-size:13px;margin:12px 0}.map-stage{position:relative;min-height:560px;min-width:0;background:var(--surface-2)}#explore-map{position:absolute;inset:0}.map-mode{position:absolute;top:12px;left:12px;z-index:3;display:flex;align-items:center;gap:3px;background:var(--surface);padding:3px;border-radius:6px;box-shadow:0 2px 10px #0002}.map-mode button,.map-mode summary{padding:8px 10px;border:0;border-radius:4px;background:transparent;color:var(--text);font:12px system-ui;cursor:pointer}.map-mode button[aria-pressed=true]{background:var(--accent);color:var(--on-accent)}.map-mode summary{display:flex;align-items:center;gap:6px;list-style:none}.map-mode summary::-webkit-details-marker{display:none}.map-layer-options{position:absolute;top:calc(100% + 6px);left:0;width:280px;max-width:calc(100vw - 64px);max-height:400px;overflow:auto;padding:14px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text);box-shadow:0 8px 25px #0002}.map-layer-options h3{font-size:14px;margin:0 0 10px}.map-layer-options :global(label){display:flex;align-items:center;gap:9px;font-size:12px;margin:9px 0}.map-layer-options :global(input){accent-color:var(--accent);width:16px;height:16px}.map-layer-options p{font-size:12px;line-height:1.5}.map-layer-options select{max-width:145px;background:var(--surface);color:var(--text);border:1px solid var(--border);font-size:16px;padding:5px}#map-status,.outdoor-status{position:absolute;left:12px;max-width:calc(100% - 70px);padding:6px 9px;background:var(--surface);font:11px/1.5 system-ui;border-radius:4px;pointer-events:none}#map-status{bottom:26px}.outdoor-status{bottom:76px}.outdoor-status{height:28px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.outdoor-status:empty{display:none}.map-fallback{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:24px;background:var(--bg);text-align:center}.map-fallback h2{font-size:25px}.map-fallback p{font-size:14px;max-width:40ch}.track-details{grid-column:1/-1;display:grid;grid-template-columns:230px minmax(0,1fr);align-items:center;gap:12px;padding:16px;border-top:1px solid var(--border)}.track-details h2{font:450 22px var(--serif);margin:8px 0}.track-details p,.map-footnote{font-size:12px;line-height:1.6}.track-details svg{width:100%;height:110px;color:var(--accent)}#elevation-note{grid-column:1/-1;margin:0}.provider-credits{font-size:11px;line-height:1.6;margin:12px 0 0}.reference-status{font-size:12px;line-height:18px;height:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:6px 0 10px}.reference-status:empty{display:none}.map-footnote{margin-top:12px;max-width:110ch;opacity:.8}.map-stage :global(.imagery-logo){background:transparent;box-shadow:none}.map-stage :global(.imagery-logo img){display:block;width:110px;height:30px}.map-stage :global(.maplibregl-popup-content){background:var(--surface);color:var(--text);padding:12px;font:13px/1.5 system-ui;border-radius:7px}.map-stage :global(.maplibregl-ctrl-attrib){color:#222!important;background:#ffffffe6!important}#outdoor-detail{border:1px solid var(--border);border-radius:6px;margin-top:12px;padding:12px}#outdoor-detail :global(h3){font:500 18px var(--serif);margin:0 0 8px}#outdoor-detail :global(p),#outdoor-detail :global(a){font-size:12px;line-height:1.6}#outdoor-detail :global(button){font:12px system-ui;margin-top:10px}#explore-planner[data-view=list] .map-stage{display:none}#explore-planner[data-view=list] .explore-map-shell{grid-template-columns:minmax(0,1fr)}#explore-planner[data-view=list] .map-sidebar{max-height:none}#explore-planner[data-view=list] .outdoor-list{grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:0 20px}@media(max-width:900px){.explore-map-shell{grid-template-columns:minmax(0,1fr)}.map-stage{grid-row:1;min-height:clamp(320px,50dvh,450px)}.map-sidebar{max-height:none}.outdoor-list{max-height:280px;overflow:auto}#explore-planner[data-view=list] .outdoor-list{max-height:none}.map-heading>a{font-size:12px}.map-mode{left:8px;top:8px;max-width:calc(100% - 56px);flex-wrap:wrap}.track-details{grid-template-columns:1fr}}@media(max-width:600px){.map-page{padding-top:16px}.map-heading{align-items:flex-start;gap:8px}.map-heading h1{font-size:27px}.map-heading>a{max-width:85px;white-space:normal;text-align:right;line-height:1.5}.map-heading .eyebrow{font-size:10px}.explore-toolbar{gap:6px}.world-search{gap:4px}.world-search input{padding-inline:9px}.view-switch{gap:2px}.view-switch button{padding:9px}.activity-filters{gap:5px}.activity-filters button{font-size:12px;padding:8px 10px}.map-sidebar{padding:12px}.map-mode button,.map-mode summary{min-height:40px}.map-footnote{font-size:12px}}@media(pointer:coarse){.activity-filters button,.view-switch button,.world-search button,.planner-section summary{min-height:44px}.map-layer-options :global(label){min-height:34px}}
</style>
