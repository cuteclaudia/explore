---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Places & map" description="Explore featured places in 2D and 3D, and view a private GPX track in your browser.">
<section class="wrap map-page"><header class="map-heading"><div><span class="eyebrow">A little further</span><h1>Find your next perspective.</h1><p>Featured places, open maps, and room to explore.</p></div><a href="/settings/connections" class="map-connections"><Icon name="settings" size={16}/>Activity connections</a></header>
<div class="explore-map-shell"><aside class="map-sidebar"><h2>Explore places</h2><label class="sr-only" for="place-search">Search featured places</label><input id="place-search" type="search" placeholder="Search featured places…"/><div id="featured-places"></div><div class="track-import"><h3>Your route</h3><p>View a GPX export from Strava, Garmin or Komoot. It stays in this browser and is never uploaded by this map.</p><label class="gpx-import"><Icon name="plus" size={16}/>Open GPX file<input id="gpx-file" type="file" accept=".gpx,application/gpx+xml,application/xml,text/xml"/></label><button id="clear-track" class="btn ghost" type="button" hidden>Clear track</button><p id="track-status" role="status"></p></div></aside>
<div class="map-stage"><div id="explore-map" aria-label="Interactive map of featured places"></div><div class="map-mode" role="group" aria-label="Map view"><button type="button" data-map-mode="2d" aria-pressed="true">2D</button><button type="button" data-map-mode="3d" aria-pressed="false">3D terrain</button></div><p id="map-status" role="status">Loading open map…</p><div class="map-fallback" id="map-fallback" hidden><h2>The map couldn’t load.</h2><p>Check your connection or try a browser with WebGL enabled. Featured places remain listed.</p><a href="/photography">Browse photography →</a></div></div>
<section id="track-details" class="track-details" hidden><div><span class="eyebrow">Private route preview</span><h2 id="track-name"></h2><p id="track-metrics"></p></div><svg id="track-profile" viewBox="0 0 600 110" role="img" aria-label="Elevation profile from the imported GPX file"><path id="elevation-line" fill="none" stroke="currentColor" stroke-width="2"/></svg><p id="elevation-note"></p></section>
</div><p class="map-footnote">Maps: OpenFreeMap / OpenStreetMap. 3D heights: Mapzen terrain data. Terrain is approximate; this map is for exploring and viewing tracks, not navigation or live position tracking. <a href="/map-credits">Map credits & data sources</a>.</p></section>
</Base>
<script>import '../scripts/explore-map';</script>
<style>.map-page{max-width:1480px;padding-top:38px;padding-bottom:45px}.map-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:30px}.map-heading h1{font:450 clamp(30px,4vw,48px)/1.15 var(--serif);margin:14px 0}.map-heading p{font-size:14px;opacity:.65}.map-connections{display:flex;align-items:center;gap:8px;font-size:12px;text-decoration:none;white-space:nowrap}.explore-map-shell{display:grid;grid-template-columns:245px minmax(0,1fr);border:1px solid var(--border);border-radius:12px;overflow:hidden;background:var(--surface)}.map-sidebar{padding:22px}.map-sidebar h2{font-size:20px;font-weight:450;font-family:var(--serif);margin:0 0 20px}.map-sidebar input[type=search]{width:100%;padding:10px;border:1px solid var(--border);border-radius:5px;color:var(--text);background:var(--bg);font-size:12px}.map-sidebar :global(.place-button){display:block;width:100%;text-align:left;padding:15px 0;border:0;border-bottom:1px solid var(--border);background:none;color:var(--text);cursor:pointer}.map-sidebar :global(.place-button strong){display:block;font-size:13px;font-weight:500}.map-sidebar :global(.place-button span){font-size:11px;opacity:.6}.map-sidebar :global(.place-button[aria-pressed=true]){color:var(--accent)}.track-import{margin-top:30px}.track-import h3{font-size:14px;font-weight:500}.track-import p{font-size:11px;line-height:1.6;opacity:.7}.gpx-import{display:inline-flex;align-items:center;gap:8px;font-size:12px;cursor:pointer;padding:10px 0}.gpx-import input{position:absolute;width:1px;height:1px;clip:rect(0,0,0,0)}.gpx-import:focus-within{outline:2px solid var(--accent);outline-offset:4px}.map-stage{position:relative;min-height:600px;background:var(--surface-2)}#explore-map{position:absolute;inset:0}.map-mode{position:absolute;top:16px;left:16px;display:flex;gap:3px;background:var(--surface);padding:3px;border-radius:7px;box-shadow:0 2px 10px #0001}.map-mode button{padding:8px 12px;border:0;border-radius:5px;background:transparent;color:var(--text);font-size:12px;cursor:pointer}.map-mode button[aria-pressed=true]{background:var(--accent);color:var(--on-accent)}#map-status{position:absolute;left:16px;bottom:28px;max-width:75%;padding:7px 10px;background:var(--surface);font-size:11px;border-radius:5px;pointer-events:none}.map-fallback{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:30px;background:var(--bg);text-align:center}.map-fallback p{font-size:14px;max-width:45ch}.track-details{grid-column:1/-1;display:grid;grid-template-columns:250px 1fr;align-items:center;gap:15px;padding:20px 25px;border-top:1px solid var(--border)}.track-details h2{font:450 22px var(--serif);margin:10px 0}.track-details p,.map-footnote{font-size:11px;opacity:.65}.track-details svg{width:100%;height:120px;color:var(--accent)}#elevation-note{grid-column:1/-1;margin:0}.map-footnote{margin-top:16px}.map-stage :global(.maplibregl-popup-content){background:var(--surface);color:var(--text);padding:12px;font:13px system-ui;border-radius:8px}.map-stage :global(.maplibregl-ctrl-attrib){color:#222!important;background:#ffffffe6!important}@media(max-width:750px){.explore-map-shell{grid-template-columns:1fr}.map-heading{align-items:flex-start;flex-direction:column;gap:0}.map-sidebar{padding:18px}.map-sidebar #featured-places{display:flex;overflow:auto;gap:20px}.map-sidebar :global(.place-button){min-width:150px;border:0}.track-import{margin-top:12px}.map-stage{min-height:460px}.track-details{grid-template-columns:1fr}.map-heading h1{font-size:34px}}</style>
