---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getJournal, formatDate, shownLocation, readingTime } from '../../lib/site';

export async function getStaticPaths() {
  return (await getJournal()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const where = shownLocation(entry.data.location, entry.data.locationPrecision);
---
<Base title={entry.data.title} description={entry.data.summary} image={entry.data.cover ?? undefined}>
  <article>
    <header class="article-head wrap">
      <div class="inner">
        <a class="eyebrow" href="/journal" style="text-decoration:none">Journal</a>
        <h1>{entry.data.title}</h1>
        <div class="meta">
          <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          {where && <span>{where}{entry.data.locationPrecision === 'approximate' ? ' (approximate)' : ''}</span>}
          <span>{readingTime(entry.body)}</span>
        </div>
      </div>
    </header>
    {entry.data.cover && <figure class="article-hero" style="margin-top:0"><img src={entry.data.cover} alt={entry.data.coverAlt} /></figure>}
    <div class="prose"><Content /></div>
  </article>
</Base>
