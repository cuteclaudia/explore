---
import {productDestinations} from '../lib/product-destinations.mjs';
const destinations=productDestinations({PUBLIC_KOBO_WORKSPACE_URL:import.meta.env.PUBLIC_KOBO_WORKSPACE_URL,PUBLIC_HOBBYNEST_SHOP_URL:import.meta.env.PUBLIC_HOBBYNEST_SHOP_URL});
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="HobbyNest · 3D printing" description="A home for Claudia’s 3D printing projects, design experiments and notes from the making process."><section class="wrap printing-page"><header class="printing-intro"><div><span class="eyebrow">HobbyNest · Ideas, made tangible</span><h1>A different dimension<br/>to making.</h1><p>HobbyNest is my 3D printing business. This is the home for its projects: a place to bring together design experiments, finished pieces and the things learned along the way.</p><a class="btn" href={destinations.shop} target="_blank" rel="noopener" aria-label="Visit HobbyNest (new tab)">{destinations.shop==='/hobbynest'?'Preview HobbyNest ↗':'Visit HobbyNest ↗'} <Icon name="arrow" size={16}/></a><a class="btn ghost" href="/contact">Talk about a project <Icon name="arrow" size={16}/></a></div><div class="printing-illustration" aria-hidden="true"><svg viewBox="0 0 400 300" fill="none"><path d="m200 38 118 68v133l-118 68-118-68V106Z" stroke="currentColor" stroke-width="1" opacity=".2"/><path d="m82 106 118 68 118-68M200 174v133" stroke="currentColor" opacity=".2"/><path d="m200 86 76 44v88l-76 44-76-44v-88Z" fill="var(--surface)" stroke="currentColor" stroke-width="1.5"/><path d="m124 130 76 44 76-44M200 174v88" stroke="currentColor" stroke-width="1.5"/>{[146,158,170,182,194,206].map(y=><path d={'M124 '+y+'l76 44 76-44'} stroke="currentColor" opacity=".3"/>)}<circle cx="200" cy="86" r="4" fill="currentColor"/><circle cx="124" cy="218" r="4" fill="currentColor"/><circle cx="276" cy="218" r="4" fill="currentColor"/></svg><span>From a sketch to something you can hold.</span></div></header><section class="printing-gallery" aria-labelledby="projects-heading"><div><span class="eyebrow">Projects & process</span><h2 id="projects-heading">On the workbench.</h2><p>The project gallery is being prepared. I’ll add photographs, design notes and material details as the collection takes shape.</p></div><span class="portfolio-status">Portfolio in preparation</span></section><div class="making-notes"><article><span>01</span><h3>Design</h3><p>Exploring shape, purpose and the small details that make an idea work.</p></article><article><span>02</span><h3>Make</h3><p>Turning a digital model into a physical object, one layer at a time.</p></article><article><span>03</span><h3>Refine</h3><p>Learning from each iteration and making room for the next experiment.</p></article></div><p class="printing-link">Looking for my creative software? <a href="/kobo">Meet the SoraSpace apps →</a></p></section></Base>
<style>
.printing-page{max-width:1100px;padding-top:28px;padding-bottom:36px}.printing-intro{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:center;padding:12px 0 28px}.printing-intro h1{font:450 clamp(35px,4vw,53px)/1.06 var(--serif);letter-spacing:-.02em;margin:12px 0 18px}.printing-intro p{max-width:45ch;font-size:15px;line-height:1.7;margin:0 0 20px}.printing-intro a{margin:0 10px 10px 0;display:inline-flex;align-items:center;gap:10px;font-size:13px}.printing-illustration{color:var(--accent);text-align:center;max-width:350px;justify-self:center}.printing-illustration svg{width:100%;height:auto;max-height:270px}.printing-illustration>span{display:block;font:23px Caveat,cursive;transform:rotate(-3deg);margin-top:15px}.printing-gallery{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:22px;border:1px solid var(--border);border-radius:9px;background:var(--surface)}.printing-gallery h2{font:450 31px/1.1 var(--serif);margin:7px 0 10px}.printing-gallery p{font-size:13px;line-height:1.65;max-width:60ch;margin:0}.portfolio-status{font-size:11px;border:1px dashed var(--border);border-radius:5px;padding:8px 11px;white-space:nowrap;opacity:.75}.making-notes{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:24px}.making-notes article{border-top:1px solid var(--border);padding-top:14px}.making-notes article>span{font-size:10px;letter-spacing:.15em;opacity:.55}.making-notes h3{font:450 25px var(--serif);margin:8px 0}.making-notes p,.printing-link{font-size:13px;line-height:1.65}.printing-link{margin-top:24px}@media(max-width:700px){.printing-intro{grid-template-columns:1fr;gap:8px}.printing-illustration{max-width:250px}.printing-illustration svg{max-height:180px}.printing-illustration>span{font-size:21px}.printing-gallery{flex-direction:column;align-items:flex-start;gap:14px}.making-notes{gap:16px}.making-notes h3{font-size:23px}.making-notes p{font-size:12px}}@media(max-width:450px){.printing-page{padding-top:18px}.printing-intro h1{font-size:37px}.printing-intro p{font-size:14px}.printing-gallery{padding:16px}.making-notes{grid-template-columns:1fr;gap:12px}.making-notes h3{margin:4px 0}.making-notes p{margin:6px 0}.printing-intro a{margin:0 10px 10px 0;min-height:44px}}
</style>
