---
import {protectPage} from '../../../server/identity';
import KoboWorkspace from '../../layouts/KoboWorkspace.astro';
import KoboIcon from '../../components/KoboIcon.astro';
import Icon from '../../components/Icon.astro';
export const prerender=false;
const actor=await protectPage('/apps/irodori','tools.photocraft');if(actor instanceof Response)return actor;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<KoboWorkspace actor={actor} title="SoraImage" section="irodori" appMode><div class="app-shell">
<header class="irodori-bar"><a href="/apps" aria-label="Return to SoraSpace workspace">SoraSpace</a><strong><KoboIcon name="irodori" size={27}/><span>SoraImage<small lang="ja">Irodori · 彩り</small></span></strong><span class="save-destination">Saves to this device</span><button type="button" id="irodori-save-help" aria-label="Saving and export information"><span class="desktop-copy">Save & export</span><span class="phone-copy">Save info</span></button><button type="button" id="irodori-fullscreen" aria-label="Enter full screen" title="Enter full screen" disabled><Icon name="expand" size={18}/></button></header>
<p class="sr-only" id="irodori-live-status" role="status">Opening SoraImage — image editing and design…</p><div id="irodori-notice" role="status"><p id="irodori-message">Opening SoraImage — image editing and design…</p><button type="button" id="irodori-retry" hidden>Retry</button><a id="irodori-previous" href="/apps/irodori-legacy" hidden>Open the previous editor</a></div>
<iframe id="irodori-frame" title="SoraImage — image editing and design" sandbox="allow-scripts allow-same-origin allow-downloads allow-popups allow-modals" allow="clipboard-read; clipboard-write; fullscreen" referrerpolicy="no-referrer" hidden></iframe>
<dialog id="irodori-saving"><h1>Save your work</h1><p>Use SoraImage’s File → Save or Export to download your work to this device. Reopen the downloaded file to check it.</p><p>Google Drive and kDrive sync are still in development for SoraImage. They are not used by this version.</p><p>Download your work before leaving or signing out. Browser recovery is best effort and depends on the deployed app version. Older builds can share local preferences and brushes between logins; keep a downloaded copy. Cloud documents are not available yet.</p><p>The editor currently uses its desktop layout. A tablet or computer gives you more room.</p><p><a href="/apps/irodori-legacy">Previous editor & saved site files →</a></p>{actor.isOwner&&<p><a href="/studio/irodori-test" target="_blank" rel="noopener">Owner development preview ↗</a></p>}<button type="button" id="irodori-saving-close">Return to editor</button></dialog>
<script>import '../../scripts/irodori-workspace';</script>
</div></KoboWorkspace>
<style is:global>.app-shell{font:14px system-ui,sans-serif}.irodori-bar{display:flex;align-items:center;gap:12px;flex-shrink:0;min-height:48px;padding:0 12px;border-bottom:1px solid var(--border,#718093)}.irodori-bar>a{font-size:12px;text-decoration:none;white-space:nowrap}.irodori-bar strong{display:flex;align-items:center;gap:8px;margin-right:auto;font-size:14px;min-width:0}.irodori-bar strong>span{display:flex;flex-direction:column;gap:2px}.irodori-bar small{font-size:10px;font-weight:400;opacity:.7}.save-destination{font-size:11px;opacity:.7}.irodori-bar button{font-size:12px;flex-shrink:0}#irodori-fullscreen{display:flex;align-items:center;justify-content:center;min-width:36px}#irodori-frame{display:block;flex:1;min-height:0;width:100%;border:0;background:#1c2135}#irodori-frame:fullscreen{height:100%;background:#1c2135}#irodori-notice{padding:5px 12px;display:flex;align-items:center;flex-wrap:wrap;gap:8px 12px;flex-shrink:0;border-bottom:1px solid var(--border);background:var(--surface);font:12px/1.5 system-ui}#irodori-notice p{margin:0;flex:1;min-width:180px}#irodori-notice a{font-size:12px;margin:0}#irodori-notice button{font-size:12px;padding:5px 10px}#irodori-notice[data-state=error]{border-bottom-color:var(--accent)}#irodori-saving{width:min(540px,calc(100vw - 32px));max-height:85dvh;overflow:auto;background:var(--bg,#fff2f6);color:var(--text,#4a293a);border:1px solid var(--border,#718093);border-radius:8px;padding:20px}#irodori-saving::backdrop{background:#0008}#irodori-saving h1{font-size:23px;margin:0 0 14px}#irodori-saving p{font-size:14px;line-height:1.6}.phone-copy{display:none}[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}@media(max-width:380px){.irodori-bar>a{display:none}}@media(max-width:699px){.irodori-bar{gap:8px;padding-inline:8px;min-height:44px}.irodori-bar button,.irodori-bar>a{min-height:44px;display:flex;align-items:center}.desktop-copy,.save-destination,.irodori-bar small{display:none}.phone-copy{display:inline}.irodori-bar strong{font-size:13px;gap:5px}.irodori-bar .kobo-icon{width:22px!important;height:22px!important}#irodori-fullscreen{min-width:44px}.irodori-bar button{padding:6px 8px}}@media(pointer:coarse){button{min-height:44px}}</style>
