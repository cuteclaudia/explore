---
import Base from '../../layouts/Base.astro';
import AppCard from '../../components/AppCard.astro';
import KoboIcon from '../../components/KoboIcon.astro';
import {protectPage} from '../../../server/identity';
import {DESKTOP_TOOLS as CRAFT_TOOLS} from '../../../server/desktop-tools.mjs';
export const prerender=false;
const actor=await protectPage('/apps');if(actor instanceof Response)return actor;
Astro.response.headers.set('Cache-Control','private, no-store');
const apps=Object.entries(CRAFT_TOOLS).filter(([id,tool])=>actor.permissions[tool.capability]||actor.permissions['desktop.'+id]);
---
<Base title="Kōbō · My apps" noindex>
<section class="wrap apps-library"><header class="page-head"><span class="eyebrow">CuteClaudia · Your creative workshop</span><h1><span class="kobo-kanji">工房</span> Kōbō</h1><p>Open your web apps or download available desktop installers. Your saved revisions and storage connections belong to your account.</p><a href="/studio">← My Studio</a></header><div class="apps-grid">{apps.map(([id,tool])=><AppCard id={id} tool={tool} canOpen={!tool.desktopOnly&&actor.permissions[tool.capability]} betaAccess={tool.slug==='hikari'&&actor.permissions['beta.hikari']&&actor.permissions[tool.capability]}/>)}</div>{actor.isOwner&&<section class="upcoming-suite"><h2>Next from Kōbō</h2><p>In development · not available to open yet</p><div>{[['akari','Akari','Presentations'],['sen','Sen','Illustration'],['hanga','Hanga','Page layout'],['hinagata','Hinagata','UI design'],['kage','Kage','Video'],['hibiki','Hibiki','Audio'],['mai','Mai','Motion'],['takumi','Takumi','CAD']].map(([id,name,kind])=><article><KoboIcon name={id} size={38}/><span><strong>{name}</strong><small>{kind}</small></span></article>)}</div></section>}<p class="pending-apps">App access and desktop downloads follow your account permissions. Save information is available inside each app.</p><p style="margin-top:20px"><a href="/settings">Settings · storage & save preferences</a></p></section>
</Base>
<style>.apps-library{max-width:1100px;padding-top:22px;padding-bottom:36px}.apps-library h2{font-size:30px}.apps-grid{display:grid;grid-template-columns:1fr 1fr;column-gap:45px}@media(max-width:650px){.apps-grid{grid-template-columns:1fr}}.pending-apps{font-size:12px;opacity:.65;margin-top:30px}.kobo-kanji{color:#c48b24;font-size:.8em;margin-right:10px}.upcoming-suite{margin-top:24px}.upcoming-suite h2{font-size:25px}.upcoming-suite>p{font-size:12px;opacity:.65}.upcoming-suite>div{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:25px}.upcoming-suite article{display:flex;align-items:center;gap:12px}.upcoming-suite article span{display:flex;flex-direction:column}.upcoming-suite strong{font-size:13px;font-weight:500}.upcoming-suite small{font-size:11px;opacity:.65}@media(max-width:600px){.upcoming-suite>div{grid-template-columns:1fr 1fr}} </style>
