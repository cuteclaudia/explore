---
import Base from '../../layouts/KoboWorkspace.astro';
import {CRAFT_TOOLS as WEB_TOOLS} from '../../../server/craft-tools.mjs';
import AppCard from '../../components/AppCard.astro';
import KoboIcon from '../../components/KoboIcon.astro';
import Icon from '../../components/Icon.astro';
import {UPCOMING_APPS} from '../../lib/soraspace-upcoming-apps.mjs';
import {APP_PRESENTATION} from '../../lib/app-presentation.mjs';
import {protectPage} from '../../../server/identity';
import {DESKTOP_TOOLS as CRAFT_TOOLS} from '../../../server/desktop-tools.mjs';
export const prerender=false;
const actor=await protectPage('/apps');if(actor instanceof Response)return actor;
Astro.response.headers.set('Cache-Control','private, no-store');
const apps=Object.entries(CRAFT_TOOLS).filter(([id,tool])=>actor.permissions[tool.capability]||actor.permissions['desktop.'+id]);
const fileTools=Object.fromEntries(Object.entries(WEB_TOOLS).filter(([id,t])=>actor.permissions[t.capability]).map(([id,t])=>[id,{name:APP_PRESENTATION[t.slug]?.shortName||t.name,slug:t.slug}]));
---
<Base title="Your workspace" actor={actor}>
<section class="apps-library">
 <header class="workspace-heading"><span class="eyebrow"><span data-i18n="Your workspace">Your workspace</span></span><h1><span data-i18n="Welcome to SoraSpace.">Welcome to SoraSpace.</span></h1><p><span data-i18n="Your files, apps and daily essentials, together.">Your files, apps and daily essentials, together.</span></p></header>
 <div class="welcome-dashboard">
 <section class="workspace-section" id="workspace-apps" aria-labelledby="apps-heading"><header class="panel-heading app-section-heading"><h2 id="apps-heading"><span data-i18n="Your apps">Your apps</span></h2><span class="app-launch-note"><span data-i18n="Apps open in new tabs ↗">Apps open in new tabs ↗</span></span></header><p id="workspace-search-status" class="workspace-note" role="status"></p>
 {!actor.isOwner&&actor.permissions['beta.soraspace']&&<div class="trial-website-tools"><strong><span data-i18n="Your website trial">Your website trial</span></strong><a href="/studio/soraspace-setup" target="_blank" rel="noopener"><span data-i18n="Site setup ↗">Site setup ↗</span></a><a href="/studio/soraspace-editor" target="_blank" rel="noopener"><span data-i18n="Edit private draft ↗">Edit private draft ↗</span></a><a href="/studio/welcome"><span data-i18n="Account &amp; services →">Account &amp; services →</span></a></div>}
 <div class="apps-grid">{apps.map(([id,tool])=><AppCard inWorkspace={true} id={id} tool={tool} canOpen={!tool.desktopOnly&&actor.permissions[tool.capability]} betaAccess={tool.slug==='hikari'&&actor.permissions['beta.hikari']&&actor.permissions[tool.capability]}/>)}</div>{actor.isOwner&&<details class="upcoming-suite"><summary><span data-i18n="Next from SoraSpace">Next from SoraSpace</span> <span><span data-i18n="In development">In development</span></span></summary><div>{UPCOMING_APPS.map(({id,name,kind})=><article><KoboIcon name={id} size={38}/><span><strong>{name}</strong><small data-i18n={kind}>{kind}</small></span></article>)}</div></details>}<p class="pending-apps"><span data-i18n="Access follows your account permissions. macOS is planned.">Access follows your account permissions. macOS is planned.</span></p></section>
  <div class="welcome-daily" id="workspace-mail-calendar">
   <section class="welcome-panel" id="workspace-mail" aria-labelledby="mail-heading"><header class="panel-heading"><h2 id="mail-heading"><Icon name="mail" size={21}/><span data-i18n="Mail">Mail</span></h2><span class="preview-label"><span data-i18n="Coming soon">Coming soon</span></span></header><p class="workspace-note"><span data-i18n="Your inbox preview will appear here.">Your inbox preview will appear here.</span></p></section>
   <section class="welcome-panel" id="workspace-calendar" aria-labelledby="calendar-heading"><header class="panel-heading"><h2 id="calendar-heading"><Icon name="calendar" size={21}/><span data-i18n="Calendar">Calendar</span></h2><span class="preview-label"><span data-i18n="Coming soon">Coming soon</span></span></header><p class="workspace-note"><span data-i18n="Your upcoming events will appear here.">Your upcoming events will appear here.</span></p></section>
  <section class="welcome-panel welcome-files" aria-labelledby="recent-heading">
   <header class="panel-heading"><h2 id="recent-heading"><span data-i18n="Files &amp; folders">Files &amp; folders</span></h2><button type="button" class="btn ghost" id="workspace-files-refresh"><span data-i18n="Refresh">Refresh</span></button></header>
   <p class="workspace-note"><span data-i18n="Recent site files, grouped by app.">Recent site files, grouped by app.</span></p>
   <nav id="workspace-folder-list" class="workspace-folders" aria-label="File groups"></nav>
   <h3><span data-i18n="Recent files">Recent files</span></h3><p id="workspace-files-status" role="status"><span data-i18n="Loading saved site revisions…">Loading saved site revisions…</span></p>
   <div id="workspace-files-list" class="workspace-file-list" data-tools={JSON.stringify(fileTools)} data-limit="3" data-compact="true"></div>
   <div class="workspace-links"><a href="/apps/files"><span data-i18n="All saved site files →">All saved site files →</span></a><a href="/studio/storage" target="_blank" rel="noopener"><span data-i18n="Storage connections ↗">Storage connections ↗</span></a></div>
  </section>

  </div>
 </div>
</section>
</Base>
<style>
.apps-library{max-width:1600px;padding-bottom:8px}.apps-library>.workspace-heading{margin-bottom:16px}.apps-library>.workspace-heading h1{font-size:30px;margin-bottom:4px}.apps-library>.workspace-heading p{margin:0;font-size:13px}.welcome-dashboard{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,1fr);align-items:start;gap:24px}.welcome-dashboard>#workspace-apps{margin:0;min-width:0}.apps-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 20px}.apps-grid>[hidden]{display:none}.welcome-daily{display:grid;gap:10px;min-width:0}.welcome-panel{min-width:0;padding:12px 14px;border:1px solid var(--border);border-radius:8px;background:var(--surface)}.panel-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap}.welcome-panel h2,.app-section-heading h2{font:450 22px/1.2 var(--serif);margin:0;display:flex;align-items:center;gap:8px}.panel-heading button{font-size:12px;min-height:34px;padding:5px 9px}.app-section-heading input{width:170px;font-size:14px;padding:8px 10px}.preview-label{font-size:10px;white-space:nowrap;padding:3px 6px;border-radius:4px;background:var(--bg)}.welcome-panel>p{font-size:12px;line-height:1.45;margin:7px 0 0}.welcome-panel h3{font-size:12px;font-weight:600;margin:10px 0 3px}.workspace-folders{display:flex;gap:6px;overflow-x:auto;max-width:100%;margin-top:9px;padding-bottom:3px}.workspace-folders:empty{display:none}.workspace-folders :global(a){display:flex;flex-direction:column;justify-content:center;flex:0 0 94px;min-height:44px;padding:6px 8px;border:1px solid var(--border);border-radius:5px;text-decoration:none;color:inherit;font-size:12px}.workspace-folders :global(small){font-size:10px;opacity:.65;margin-top:2px}.welcome-files :global(.workspace-file-list article){gap:3px 10px;padding:7px 0;grid-template-columns:minmax(0,1fr) auto}.welcome-files :global(.workspace-file-list a){font-size:11px;min-height:32px}.welcome-files :global(.workspace-file-list small){font-size:10px}.welcome-files .workspace-links{gap:0 14px;margin-top:4px}.welcome-files .workspace-links a{min-height:32px;font-size:11px}.welcome-daily section{scroll-margin-top:20px}.upcoming-suite{margin-top:14px;border-top:1px solid var(--border);padding-top:8px}.upcoming-suite summary{font-size:12px;cursor:pointer;padding:8px 0}.upcoming-suite summary span{font-size:10px;opacity:.65;margin-left:8px}.upcoming-suite>div{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:12px}.upcoming-suite article{display:flex;align-items:center;gap:8px}.upcoming-suite article span{display:flex;flex-direction:column}.upcoming-suite strong{font-size:12px;font-weight:500}.upcoming-suite small{font-size:11px;opacity:.65}.pending-apps{font-size:11px;opacity:.65;margin:8px 0 0}
.apps-grid :global(.app-tile){padding:12px 0;gap:6px;align-items:start}.apps-grid :global(.app-open){gap:10px}.apps-grid :global(.app-tile-icon){width:36px;height:36px}.apps-grid :global(.app-tile-icon img){width:36px;height:36px}.apps-grid :global(.app-tile-text strong){font-size:15px}.apps-grid :global(.app-tile-text){gap:3px}.apps-grid :global(.app-tile-text>span){font-size:12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.apps-grid :global(.app-tile-arrow){display:none}.apps-grid :global(.desktop-roadmap){font-size:10px}.apps-grid :global(.app-beta){font-size:10px;padding:6px 0}.apps-grid :global(.app-separate){min-width:28px;min-height:28px}
@media(min-width:1101px) and (max-height:800px){.apps-library>.workspace-heading .eyebrow{display:none}.apps-library>.workspace-heading{margin-bottom:12px}.apps-library>.workspace-heading h1{font-size:27px}.welcome-panel{padding:10px 12px}.welcome-files>p{font-size:11px}.apps-grid :global(.app-tile){padding:10px 0}.welcome-files :global(.workspace-file-list article:nth-child(n+3)){display:none}}
@media(max-width:1100px){.welcome-dashboard{grid-template-columns:minmax(0,1fr)}.welcome-daily{grid-template-columns:repeat(2,minmax(0,1fr))}.welcome-files{grid-column:1/-1}.apps-grid{gap:0 24px}}@media(max-width:600px){.apps-grid{grid-template-columns:minmax(0,1fr)}.welcome-daily{grid-template-columns:minmax(0,1fr)}.welcome-files{grid-column:auto}.app-section-heading{align-items:start}.app-section-heading label{max-width:65%}.app-section-heading input{max-width:100%;width:155px}.upcoming-suite>div{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(pointer:coarse){.welcome-files .workspace-links a,.welcome-files :global(.workspace-file-list a),.panel-heading button,.apps-grid :global(.app-separate){min-height:44px;min-width:44px}}
</style>

<style is:global>
.workspace-content:has(.apps-library){max-width:1800px;padding:18px 24px}.apps-library .workspace-folders strong{font-size:11px;font-weight:500;white-space:nowrap}.apps-library .welcome-files .workspace-file-list strong{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.apps-library .welcome-files #workspace-files-status:empty{display:none}.apps-library>.workspace-heading h1{margin-top:0}@media(min-width:1101px) and (max-height:800px){.apps-library>.workspace-heading>p{display:none}}@media(min-width:1920px){.apps-library .apps-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:600px){.workspace-content:has(.apps-library){padding:18px 16px}}
</style>

<style is:global>@media(min-width:1101px) and (max-height:700px){.workspace-content:has(.apps-library){padding-block:6px}}</style>

<style is:global>
.apps-library>.workspace-heading{padding:18px 20px;border-radius:12px;border:1px solid var(--border);background:linear-gradient(90deg,var(--surface) 35%,color-mix(in srgb,var(--surface) 80%,transparent)),url('/images/dolomites-dusk.jpg') center 43%/cover}.apps-library>.workspace-heading h1{font-family:system-ui,sans-serif;font-weight:600;font-size:29px;letter-spacing:-.03em}.apps-library>.workspace-heading .eyebrow{font-size:10px;letter-spacing:.1em}.welcome-dashboard{gap:18px}.apps-library .apps-grid{gap:10px}.apps-library .apps-grid .app-tile{background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:12px;transition:box-shadow .15s,border-color .15s}.apps-library .apps-grid .app-tile:hover{border-color:var(--accent);box-shadow:0 3px 12px #0000000a}.apps-library .apps-grid .app-open{align-items:start}.apps-library .welcome-panel{border-radius:10px;box-shadow:0 2px 8px #00000003}.apps-library .panel-heading h2{font:600 17px/1.3 system-ui,sans-serif;letter-spacing:-.015em}.app-launch-note{font-size:11px;opacity:.7}.apps-library .pending-apps{font-size:10px}.apps-library .upcoming-suite{margin-top:10px;padding-top:4px}.apps-library .workspace-links a{font-weight:500}
@media(min-width:1101px) and (max-height:800px){.apps-library>.workspace-heading{padding:10px 16px;margin-bottom:12px}.apps-library>.workspace-heading h1{font-size:25px}.apps-library .apps-grid .app-tile{padding:9px 10px}.apps-library .apps-grid{gap:8px}.apps-library .pending-apps{margin-top:6px}}
@media(max-width:650px){.apps-library>.workspace-heading{padding:14px 16px}.apps-library>.workspace-heading h1{font-size:25px}.apps-library .apps-grid{grid-template-columns:minmax(0,1fr)}.apps-library .app-tile{min-height:76px}}
@media(prefers-reduced-motion:reduce){.apps-library .apps-grid .app-tile{transition:none}}
</style>

<style is:global>body .workspace-content .apps-library .welcome-panel .panel-heading h2,body .workspace-content .apps-library .app-section-heading h2{font:600 17px/1.3 system-ui,sans-serif;letter-spacing:-.015em}@media(min-width:1101px) and (max-height:700px){body .apps-library .welcome-panel{padding:8px 12px}.apps-library .welcome-panel>p{margin-top:4px}.apps-library .welcome-files h3{margin-top:7px}}</style>

<style>.trial-website-tools{display:flex;gap:8px 16px;align-items:center;flex-wrap:wrap;padding:10px 12px;border:1px solid var(--border);border-radius:7px;margin-bottom:12px;font-size:12px}.trial-website-tools strong{flex-basis:100%}.trial-website-tools a{display:inline-flex;align-items:center;min-height:44px}</style>
<style>.apps-grid :global(.app-tile-text>.app-title-line){display:flex;align-items:baseline;flex-wrap:wrap;overflow:visible;-webkit-line-clamp:unset;gap:3px 8px}.apps-grid :global(.app-title-line .app-legacy){white-space:nowrap}</style>

<style is:global>
.apps-library .welcome-files .workspace-file-list article>div{min-width:0;position:relative}.apps-library .welcome-files a.workspace-file-name{display:block!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-height:44px!important;padding-bottom:16px;box-sizing:border-box}.apps-library .welcome-files .workspace-file-list small{position:absolute;bottom:0;left:0;pointer-events:none}
</style>
