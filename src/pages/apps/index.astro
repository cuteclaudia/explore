---
import Base from '../../layouts/KoboWorkspace.astro';
import {CRAFT_TOOLS as WEB_TOOLS} from '../../../server/craft-tools.mjs';
import AppCard from '../../components/AppCard.astro';
import KoboIcon from '../../components/KoboIcon.astro';
import {protectPage} from '../../../server/identity';
import {DESKTOP_TOOLS as CRAFT_TOOLS} from '../../../server/desktop-tools.mjs';
export const prerender=false;
const actor=await protectPage('/apps');if(actor instanceof Response)return actor;
Astro.response.headers.set('Cache-Control','private, no-store');
const apps=Object.entries(CRAFT_TOOLS).filter(([id,tool])=>actor.permissions[tool.capability]||actor.permissions['desktop.'+id]);
---
<Base title="Your apps" actor={actor}>
<section class="apps-library"><header class="workspace-heading"><span class="eyebrow">Your creative workshop</span><h1>Welcome to SoraSpace.</h1><p>Your apps, your work, one place to begin. Open an app here, or choose another tab to work side by side.</p><label><span class="sr-only">Find an app</span><input id="workspace-app-search" type="search" placeholder="Find an app…"/></label><p id="workspace-search-status" class="workspace-note" role="status"></p></header><div class="apps-grid">{apps.map(([id,tool])=><AppCard inWorkspace={true} id={id} tool={tool} canOpen={!tool.desktopOnly&&actor.permissions[tool.capability]} betaAccess={tool.slug==='hikari'&&actor.permissions['beta.hikari']&&actor.permissions[tool.capability]}/>)}</div><section class="workspace-section" aria-labelledby="recent-heading"><h2 id="recent-heading">Recently saved</h2><p id="workspace-files-status" role="status">Loading saved site revisions…</p><div id="workspace-files-list" class="workspace-file-list" data-tools={JSON.stringify(Object.fromEntries(Object.entries(WEB_TOOLS).filter(([id,t])=>actor.permissions[t.capability]).map(([id,t])=>[id,{name:t.name,slug:t.slug}])))} data-limit="6"></div><div class="workspace-links"><a href="/apps/files">All saved site files →</a><a href="/studio/storage" target="_blank" rel="noopener">Storage connections ↗</a></div></section>{actor.isOwner&&<section class="upcoming-suite"><h2>Next from SoraSpace</h2><p>In development · not available to open yet</p><div>{[['akari','Akari','Presentations'],['sen','Sen','Illustration'],['hanga','Hanga','Page layout'],['hinagata','Hinagata','UI design'],['kage','Kage','Video'],['hibiki','Hibiki','Audio'],['mai','Mai','Motion'],['takumi','Takumi','CAD']].map(([id,name,kind])=><article><KoboIcon name={id} size={38}/><span><strong>{name}</strong><small>{kind}</small></span></article>)}</div></section>}<p class="pending-apps">App access and desktop downloads follow your account permissions. Save information is available inside each app.</p></section>
</Base>
<style>.apps-library{max-width:1100px;padding-bottom:24px}.apps-library h2{font-size:30px}.apps-grid{display:grid;grid-template-columns:1fr 1fr;column-gap:45px}@media(max-width:650px){.apps-grid{grid-template-columns:1fr}}.pending-apps{font-size:12px;opacity:.65;margin-top:30px}.kobo-kanji{color:#c48b24;font-size:.8em;margin-right:10px}.upcoming-suite{margin-top:24px}.upcoming-suite h2{font-size:25px}.upcoming-suite>p{font-size:12px;opacity:.65}.upcoming-suite>div{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:25px}.upcoming-suite article{display:flex;align-items:center;gap:12px}.upcoming-suite article span{display:flex;flex-direction:column}.upcoming-suite strong{font-size:13px;font-weight:500}.upcoming-suite small{font-size:11px;opacity:.65}@media(max-width:600px){.upcoming-suite>div{grid-template-columns:1fr 1fr}} .apps-grid>[hidden]{display:none}@media(pointer:coarse){.apps-library a{min-height:44px}}</style>
