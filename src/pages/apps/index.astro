---
import Base from '../../layouts/KoboWorkspace.astro';
import {CRAFT_TOOLS as WEB_TOOLS} from '../../../server/craft-tools.mjs';
import AppCard from '../../components/AppCard.astro';
import KoboIcon from '../../components/KoboIcon.astro';
import Icon from '../../components/Icon.astro';
import {APP_PRESENTATION} from '../../lib/app-presentation.mjs';
import {protectPage} from '../../../server/identity';
import {DESKTOP_TOOLS as CRAFT_TOOLS} from '../../../server/desktop-tools.mjs';
export const prerender=false;
const actor=await protectPage('/apps');if(actor instanceof Response)return actor;
Astro.response.headers.set('Cache-Control','private, no-store');
const apps=Object.entries(CRAFT_TOOLS).filter(([id,tool])=>actor.permissions[tool.capability]||actor.permissions['desktop.'+id]);
const fileTools=Object.fromEntries(Object.entries(WEB_TOOLS).filter(([id,t])=>actor.permissions[t.capability]).map(([id,t])=>[id,{name:APP_PRESENTATION[t.slug]?.shortName||t.name,slug:t.slug}]));
---
<Base title="Your workspace" actor={actor}>
<section class="apps-library">
 <header class="workspace-heading"><span class="eyebrow">Your workspace</span><h1>Welcome to SoraSpace.</h1><p>Your files, apps and daily essentials, together.</p></header>
 <div class="welcome-dashboard">
  <section class="welcome-panel welcome-files" aria-labelledby="recent-heading">
   <header class="panel-heading"><h2 id="recent-heading">Files &amp; folders</h2><button type="button" class="btn ghost" id="workspace-files-refresh">Refresh</button></header>
   <p class="workspace-note">Site files grouped by app. Connected-drive folders and libraries stay inside their apps.</p>
   <nav id="workspace-folder-list" class="workspace-folders" aria-label="File groups"></nav>
   <h3>Recent files</h3><p id="workspace-files-status" role="status">Loading saved site revisions…</p>
   <div id="workspace-files-list" class="workspace-file-list" data-tools={JSON.stringify(fileTools)} data-limit="6"></div>
   <div class="workspace-links"><a href="/apps/files">All saved site files →</a><a href="/studio/storage" target="_blank" rel="noopener">Storage connections ↗</a></div>
  </section>
  <div class="welcome-daily" id="workspace-mail-calendar">
   <section class="welcome-panel" id="workspace-mail" aria-labelledby="mail-heading"><header class="panel-heading"><h2 id="mail-heading"><Icon name="mail" size={21}/>Mail</h2><span class="preview-label">Coming soon</span></header><p>Your inbox, alongside your work.</p><p class="workspace-note">The web mail preview is in development. Messages will appear here once a supported account is connected.</p><a href="#workspace-apps" class="preview-app-link">View your apps →</a></section>
   <section class="welcome-panel" id="workspace-calendar" aria-labelledby="calendar-heading"><header class="panel-heading"><h2 id="calendar-heading"><Icon name="calendar" size={21}/>Calendar</h2><span class="preview-label">Coming soon</span></header><p>A little space for what’s next.</p><p class="workspace-note">Upcoming events will appear here when calendar connections are available.</p></section>
  </div>
 </div>
 <section class="workspace-section" id="workspace-apps" aria-labelledby="apps-heading"><header class="panel-heading app-section-heading"><h2 id="apps-heading">Your apps</h2><label><span class="sr-only">Find an app</span><input id="workspace-app-search" type="search" placeholder="Find an app…"/></label></header><p id="workspace-search-status" class="workspace-note" role="status"></p>
 <div class="apps-grid">{apps.map(([id,tool])=><AppCard inWorkspace={true} id={id} tool={tool} canOpen={!tool.desktopOnly&&actor.permissions[tool.capability]} betaAccess={tool.slug==='hikari'&&actor.permissions['beta.hikari']&&actor.permissions[tool.capability]}/>)}</div></section>
{actor.isOwner&&<section class="upcoming-suite"><h2>Next from SoraSpace</h2><p>In development · not available to open yet</p><div>{[['akari','Akari','Presentations'],['sen','Sen','Illustration'],['hanga','Hanga','Page layout'],['hinagata','Hinagata','UI design'],['kage','Kage','Video'],['hibiki','Hibiki','Audio'],['mai','Mai','Motion'],['takumi','Takumi','CAD']].map(([id,name,kind])=><article><KoboIcon name={id} size={38}/><span><strong>{name}</strong><small>{kind}</small></span></article>)}</div></section>}<p class="pending-apps">App access and desktop downloads follow your account permissions. Save information is available inside each app.</p></section>
</Base>
<style>.apps-library{max-width:1100px;padding-bottom:24px}.apps-library h2{font-size:30px}.apps-grid{display:grid;grid-template-columns:1fr 1fr;column-gap:45px}@media(max-width:650px){.apps-grid{grid-template-columns:1fr}}.pending-apps{font-size:12px;opacity:.65;margin-top:30px}.kobo-kanji{color:#c48b24;font-size:.8em;margin-right:10px}.upcoming-suite{margin-top:24px}.upcoming-suite h2{font-size:25px}.upcoming-suite>p{font-size:12px;opacity:.65}.upcoming-suite>div{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:25px}.upcoming-suite article{display:flex;align-items:center;gap:12px}.upcoming-suite article span{display:flex;flex-direction:column}.upcoming-suite strong{font-size:13px;font-weight:500}.upcoming-suite small{font-size:11px;opacity:.65}@media(max-width:600px){.upcoming-suite>div{grid-template-columns:1fr 1fr}} .apps-grid>[hidden]{display:none}@media(pointer:coarse){.apps-library a{min-height:44px}}</style>

<style>
.welcome-dashboard{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:16px;margin-top:20px}.welcome-panel{min-width:0;padding:18px;border:1px solid var(--border);border-radius:9px;background:var(--surface)}.welcome-daily{display:grid;gap:16px;align-content:start;min-width:0}.welcome-panel h2,.app-section-heading h2{font:450 24px/1.25 var(--serif);margin:0;display:flex;align-items:center;gap:8px}.welcome-panel h3{font-size:13px;font-weight:600;margin:18px 0 6px}.panel-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.panel-heading button{font-size:12px;min-height:44px;padding:7px 10px}.preview-label{font-size:10px;white-space:nowrap;padding:4px 7px;border-radius:5px;background:var(--bg);color:var(--text)}.welcome-panel>p{font-size:13px;line-height:1.6}.preview-app-link{display:inline-flex;align-items:center;min-height:44px;font-size:12px}.workspace-folders{display:flex;gap:8px;overflow-x:auto;max-width:100%;padding-bottom:5px}.workspace-folders:empty{display:none}.workspace-folders :global(a){display:flex;flex-direction:column;justify-content:center;flex:0 0 110px;min-height:62px;padding:9px;border:1px solid var(--border);border-radius:6px;text-decoration:none;color:inherit;font-size:12px}.workspace-folders :global(small){font-size:10px;opacity:.65;margin-top:3px}.welcome-files :global(.workspace-file-list article){gap:4px 12px;padding:9px 0}.welcome-files :global(.workspace-file-list a){font-size:11px}.app-section-heading input{max-width:100%}.welcome-daily section{scroll-margin-top:20px}@media(max-width:1100px){.welcome-dashboard{grid-template-columns:minmax(0,1fr)}.welcome-daily{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.welcome-panel{padding:14px}.welcome-daily{grid-template-columns:minmax(0,1fr)}.app-section-heading{align-items:start;flex-direction:column}.app-section-heading label{width:100%}.app-section-heading input{width:100%}}
</style>
