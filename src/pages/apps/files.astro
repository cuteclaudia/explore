---
import KoboWorkspace from '../../layouts/KoboWorkspace.astro';
import {protectPage} from '../../../server/identity';
import {APP_PRESENTATION} from '../../lib/app-presentation.mjs';
import {CRAFT_TOOLS} from '../../../server/craft-tools.mjs';
export const prerender=false;
const actor=await protectPage('/apps/files');if(actor instanceof Response)return actor;
Astro.response.headers.set('Cache-Control','private, no-store');
const tools=Object.fromEntries(Object.entries(CRAFT_TOOLS).filter(([id,t])=>actor.permissions[t.capability]).map(([id,t])=>[id,{name:APP_PRESENTATION[t.slug]?.shortName||t.name,slug:t.slug}]));
---
<KoboWorkspace actor={actor} title="Saved site files" section="files">
 <header class="workspace-heading"><h1><span data-i18n="Saved site files">Saved site files</span></h1><p><span data-i18n="Private revisions saved to this website. Search by filename or app using the search bar above.">Private revisions saved to this website. Search by filename or app using the search bar above.</span></p></header>
 <nav class="file-locations" aria-label="File locations"><span aria-current="page"><span data-i18n="Site revisions">Site revisions</span></span><a href="/studio/storage" target="_blank" rel="noopener"><span data-i18n="Connected storage ↗">Connected storage ↗</span></a><a href="/apps"><span data-i18n="App libraries →">App libraries →</span></a></nav>
 <p class="workspace-note"><span data-i18n="Connected-drive files, photo libraries and files on your device stay in their respective apps. They are not listed here.">Connected-drive files, photo libraries and files on your device stay in their respective apps. They are not listed here.</span></p>
 <section class="workspace-section" aria-label="Browse saved revisions">
  <div class="file-toolbar"><label><span data-i18n="App">App</span> <select id="workspace-file-filter"><option value="" data-i18n="All apps">All apps</option>{Object.entries(tools).map(([id,tool])=><option value={id}>{tool.name}</option>)}</select></label><label><span data-i18n="Sort">Sort</span> <select id="workspace-file-sort"><option value="newest" data-i18n="Newest first">Newest first</option><option value="oldest" data-i18n="Oldest first">Oldest first</option><option value="name" data-i18n="Filename A–Z">Filename A–Z</option><option value="app" data-i18n="App A–Z">App A–Z</option></select></label><button type="button" class="btn ghost" id="workspace-files-refresh"><span data-i18n="Refresh files">Refresh files</span></button></div>
  <p id="workspace-files-status" role="status"><span data-i18n="Loading saved site revisions…">Loading saved site revisions…</span></p>
  <div id="workspace-files-list" class="workspace-file-list" data-tools={JSON.stringify(tools)} data-limit="30"></div>
  <button type="button" class="btn ghost" id="workspace-files-more" hidden><span data-i18n="Show more files">Show more files</span></button>
  <p class="workspace-note"><span data-i18n="Revisions may include earlier saves of the same document. Click a filename to open it in its app. This does not copy, move or publish your work.">Revisions may include earlier saves of the same document. Click a filename to open it in its app. This does not copy, move or publish your work.</span></p>
 </section>
</KoboWorkspace>

<style>.file-locations,.file-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px}.file-locations{border-bottom:1px solid var(--border);margin-top:18px}.file-locations a,.file-locations span{display:inline-flex;align-items:center;min-height:44px;font-size:13px}.file-locations span{color:var(--accent);border-bottom:2px solid currentColor}.file-toolbar label{display:inline-flex;align-items:center;gap:8px;font-size:13px;max-width:100%}.file-toolbar select{padding:9px;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:5px;min-height:44px;max-width:100%;font-size:16px}#workspace-files-more[hidden]{display:none}#workspace-files-more{margin-top:16px;min-height:44px}@media(max-width:450px){.file-toolbar{align-items:stretch}.file-toolbar label{flex:1 1 100%;justify-content:space-between}.file-toolbar select{width:75%;min-width:0}}</style>
