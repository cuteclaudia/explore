---
import {APP_PRESENTATION,appIdentity} from '../../lib/app-presentation.mjs';
import KoboLauncher from '../../components/KoboLauncher.astro';
import KoboIcon from '../../components/KoboIcon.astro';
import {protectPage} from '../../../server/identity';
import {CRAFT_TOOLS,resolveToolId} from '../../../server/craft-tools.mjs';
export const prerender=false;
const legacyIrodori=Astro.params.tool==='irodori-legacy';const id=legacyIrodori?'photocraft':resolveToolId(Astro.params.tool||'');if(!Object.hasOwn(CRAFT_TOOLS,id))return new Response('App not found',{status:404});
const tool=CRAFT_TOOLS[id];if(!legacyIrodori&&Astro.params.tool!==tool.slug)return Astro.redirect('/apps/'+tool.slug+Astro.url.search,302);const actor=await protectPage(legacyIrodori?'/apps/irodori-legacy':'/apps/'+tool.slug,tool.capability);if(actor instanceof Response)return actor;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{legacyIrodori?'Irodori previous editor':tool.name} | Kōbō</title><link rel="icon" href="/favicon.svg"/><script is:inline src="/site-theme.js"></script></head><body>
<header class="app-bar"><KoboLauncher actor={actor} current={tool.slug}/><a href="/apps" aria-label="Kōbō workspace">Kōbō</a><strong title={appIdentity(tool.slug)}><KoboIcon name={tool.slug} size={28}/><span class="app-caption">{tool.name}<small class="app-purpose">{legacyIrodori?'Previous editor · saved site files':APP_PRESENTATION[tool.slug]?.purpose}</small></span></strong><button type="button" id="open-app-files" aria-label="Files & save location" title="Files & save location"><span class="wide-label">Files & save location</span><span class="phone-label">Files</span></button><button type="button" id="app-fullscreen" aria-label="Enter full screen" title="Enter full screen"><span class="wide-label">Enter full screen</span><span class="phone-label">⛶</span></button></header>
<iframe id="craft-frame" title={tool.name+' editor'} src={'/studio/workspaces/'+id+tool.query} sandbox="allow-scripts allow-downloads allow-modals" allow="fullscreen"></iframe>
<dialog id="app-files"><button type="button" id="close-app-files">Return to app</button><section data-cloud-tool={id} data-managed-saves="true"><h1>My files & save location</h1><p>Export in the app, then choose where to save the resulting file. Other app users cannot access your private site files.</p><p id="cloud-status" role="status">Loading your files…</p><label>Choose an existing file to save<input id="cloud-upload" type="file"/></label><div id="cloud-pending"></div><h2>My private site revisions</h2><div id="cloud-list"></div><p><a href="/studio/storage" target="_blank" rel="noopener">My storage connections & preferences ↗</a></p></section></dialog>
<script>import '../../scripts/workspace-files';const dialog=document.getElementById('app-files') as HTMLDialogElement;document.getElementById('open-app-files')!.onclick=()=>dialog.showModal();document.getElementById('close-app-files')!.onclick=()=>dialog.close();window.addEventListener('explore:save-ready',()=>{if(!dialog.open)dialog.showModal();});document.getElementById('app-fullscreen')!.onclick=async()=>{try{if(document.fullscreenElement)await document.exitFullscreen();else await document.getElementById('craft-frame')!.requestFullscreen();}catch{document.getElementById('cloud-status')!.textContent='Your browser declined full screen. The app still fills this window.';}};</script>
</body></html>
<style is:global>html,body{margin:0;height:100%;font:15px system-ui,sans-serif;background:#121924;color:#eef2f6}.app-bar{height:48px;display:flex;align-items:center;gap:10px;padding:0 12px}.app-bar a{color:#f5b7cb}.app-bar strong{min-width:0;overflow:hidden;margin-right:auto;display:flex;align-items:center;gap:9px}button,.btn{cursor:pointer;border:1px solid #718093;background:#26374a;color:white;border-radius:8px;padding:9px 12px}#craft-frame{display:block;width:100%;height:calc(100dvh - 48px);border:0}dialog{width:min(850px,90vw);max-height:85vh;overflow:auto;background:#fff2f6;color:#4a293a;border:1px solid #e4b8ca;border-radius:15px;padding:25px}dialog::backdrop{background:#000a}dialog input,dialog select{padding:10px;margin:8px;max-width:100%;box-sizing:border-box}dialog a{color:#873454}dialog article{margin:15px 0;padding:15px;border:1px solid #e4b8ca}dialog button{background:#a83f6b}dialog h1{font-size:28px}.app-caption{display:flex;flex-direction:column;gap:2px}.app-purpose{font-size:11px;font-weight:400;opacity:.75}.phone-label{display:none}#craft-frame:fullscreen{height:100%;background:#121924}@media(max-width:380px){.app-bar>a{display:none}.app-bar strong .kobo-icon{display:none}}@media(max-width:699px){.app-bar{height:44px;gap:5px;padding:0 8px;font-size:12px;white-space:nowrap}.app-bar strong{min-width:0;overflow:hidden;text-overflow:ellipsis;gap:5px}.app-bar strong .kobo-icon{width:20px;height:20px;flex-shrink:0}.app-bar button,.app-bar>a{min-height:44px;box-sizing:border-box;display:flex;align-items:center;flex-shrink:0}.app-bar button{font-size:12px;padding:6px 10px}.app-purpose{display:none}.wide-label{display:none}.phone-label{display:inline}#app-fullscreen{min-width:44px}#craft-frame{height:calc(100dvh - 44px)}}</style>
