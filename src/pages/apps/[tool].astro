---
import KoboIcon from '../../components/KoboIcon.astro';
import {protectPage} from '../../../server/identity';
import {CRAFT_TOOLS,resolveToolId} from '../../../server/craft-tools.mjs';
export const prerender=false;
const id=resolveToolId(Astro.params.tool||'');if(!Object.hasOwn(CRAFT_TOOLS,id))return new Response('App not found',{status:404});
const tool=CRAFT_TOOLS[id];if(Astro.params.tool!==tool.slug)return Astro.redirect('/apps/'+tool.slug+Astro.url.search,302);const actor=await protectPage('/apps/'+tool.slug,tool.capability);if(actor instanceof Response)return actor;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>{tool.name} | Kōbō</title><link rel="icon" href="/favicon.svg"/></head><body>
<header class="app-bar"><a href="/apps">← Kōbō</a><strong><KoboIcon name={tool.slug} size={28}/>{tool.name}</strong><button type="button" id="open-app-files">Files & save location</button><button type="button" id="app-fullscreen">Enter full screen</button></header>
<iframe id="craft-frame" title={tool.name+' editor'} src={'/studio/workspaces/'+id+tool.query} sandbox="allow-scripts allow-downloads allow-modals" allow="fullscreen"></iframe>
<dialog id="app-files"><button type="button" id="close-app-files">Return to app</button><section data-cloud-tool={id} data-managed-saves="true"><h1>My files & save location</h1><p>Export in the app, then choose where to save the resulting file. Other app users cannot access your private site files.</p><p id="cloud-status" role="status">Loading your files…</p><label>Choose an existing file to save<input id="cloud-upload" type="file"/></label><div id="cloud-pending"></div><h2>My private site revisions</h2><div id="cloud-list"></div><p><a href="/studio/storage" target="_blank" rel="noopener">My storage connections & preferences ↗</a></p></section></dialog>
<script>import '../../scripts/workspace-files';const dialog=document.getElementById('app-files') as HTMLDialogElement;document.getElementById('open-app-files')!.onclick=()=>dialog.showModal();document.getElementById('close-app-files')!.onclick=()=>dialog.close();window.addEventListener('explore:save-ready',()=>{if(!dialog.open)dialog.showModal();});document.getElementById('app-fullscreen')!.onclick=async()=>{try{if(document.fullscreenElement)await document.exitFullscreen();else await document.documentElement.requestFullscreen();}catch{document.getElementById('cloud-status')!.textContent='Your browser declined full screen. The app still fills this window.';}};document.addEventListener('fullscreenchange',()=>{document.getElementById('app-fullscreen')!.textContent=document.fullscreenElement?'Exit full screen':'Enter full screen';});</script>
</body></html>
<style is:global>html,body{margin:0;height:100%;font:15px system-ui,sans-serif;background:#121924;color:#eef2f6}.app-bar{height:48px;display:flex;align-items:center;gap:18px;padding:0 15px}.app-bar a{color:#f5b7cb}.app-bar strong{margin-right:auto;display:flex;align-items:center;gap:9px}button,.btn{cursor:pointer;border:1px solid #718093;background:#26374a;color:white;border-radius:8px;padding:9px 12px}#craft-frame{display:block;width:100%;height:calc(100dvh - 48px);border:0}dialog{width:min(850px,90vw);max-height:85vh;overflow:auto;background:#fff2f6;color:#4a293a;border:1px solid #e4b8ca;border-radius:15px;padding:25px}dialog::backdrop{background:#000a}dialog input,dialog select{padding:10px;margin:8px;max-width:100%;box-sizing:border-box}dialog a{color:#873454}dialog article{margin:15px 0;padding:15px;border:1px solid #e4b8ca}dialog button{background:#a83f6b}dialog h1{font-size:28px}@media(max-width:600px){.app-bar{gap:7px;font-size:12px}.app-bar button{font-size:11px;padding:6px}}</style>
