---
import '../styles/global.css';
import { getHome, PALETTES } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  overlayHeader?: boolean;
  image?: string;
}

const { title, description, overlayHeader = false, image } = Astro.props;
const home = await getHome();
const fullTitle = title ? `${title} | Explore by Claudia` : 'Explore by Claudia | Strategy, Security & Exploration';
const desc = description || home.intro;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/chinaseries', label: 'China Series' },
  { href: '/dailycyberreport', label: 'Cyber' },
  { href: '/', label: 'Explore home' },
  { href: '/explore', label: 'Explore' },
  { href: '/journal', label: 'Journal' },
  { href: '/photography', label: 'Photography' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const current = (href: string) => path === href || path.startsWith(href + '/');
const ogImage = new URL(image && image.startsWith('/') ? image : '/images/hero.jpg', Astro.site);
---
<!doctype html>
<html lang="en-AU" data-palette={home.defaultPalette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Claudia Gilbert" href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Inter:wght@400;500;600;700&family=Caveat:wght@500;600&display=swap"
    />
    <script is:inline>
      try {
        const p = localStorage.getItem('palette');
        if (p) document.documentElement.dataset.palette = p;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class:list={['site-header', { overlay: overlayHeader }]}>
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="Explore by Claudia, home">
          <svg viewBox="0 0 40 24" width="38" height="23" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M2 22 L13 6 L20 15 L26 8 L38 22"></path><path d="M10 10.5 L13 6 L16 10"></path></svg>
          <span>Explore by Claudia</span>
        </a>
        <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu" data-menu>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </button>
        <nav class="nav" id="site-nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="header-actions">
          <div class="palette">
            <button class="icon-btn" type="button" aria-expanded="false" aria-controls="palette-panel" aria-label="Choose a colour palette" data-palette-toggle>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18c1.2 0 1.8-.8 1.8-1.7 0-.5-.2-.9-.5-1.3-.3-.4-.5-.8-.5-1.3 0-1 .8-1.7 1.8-1.7H17a4 4 0 0 0 4-4C21 6.6 17 3 12 3z"></path><circle cx="7.5" cy="11" r="1.2"></circle><circle cx="10.5" cy="7.2" r="1.2"></circle><circle cx="15" cy="7.5" r="1.2"></circle></svg>
            </button>
            <div class="palette-panel" id="palette-panel" role="dialog" aria-label="Colour palette">
              <h2>Select a colour palette</h2>
              <div class="palette-grid">
                {PALETTES.map((p) => (
                  <button type="button" data-set-palette={p.id} aria-pressed="false">
                    <span class="swatches">{p.swatch.map((c) => <i style={`background:${c}`}></i>)}</span>
                    {p.name}
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <div class="serif" style="font-size:24px">Explore by Claudia</div>
          <div class="muted" style="font-size:14px">Strategy, security and the places in between.</div>
        </div>
        <nav aria-label="Footer">
          <a href="/chinaseries">China Series</a>
          <a href="/dailycyberreport">Daily Cyber Report</a>
          <a href="https://www.stratwatch.net" rel="noopener">StratWatch</a>
          <a href="/explore">Explore</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="https://www.linkedin.com/in/claudiaegilbert/" rel="noopener">LinkedIn</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <p class="small">© {new Date().getFullYear()} Claudia Gilbert. Views expressed are the author’s own. Landscape photography via Pexels; photographers are credited where their work appears.</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const root = document.documentElement;
        const panel = document.getElementById('palette-panel');
        const toggle = document.querySelector('[data-palette-toggle]');
        const buttons = document.querySelectorAll('[data-set-palette]');
        const mark = () => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setPalette === root.dataset.palette)));
        mark();
        toggle.addEventListener('click', () => {
          const open = panel.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(open));
        });
        buttons.forEach((b) => b.addEventListener('click', () => {
          root.dataset.palette = b.dataset.setPalette;
          try { localStorage.setItem('palette', b.dataset.setPalette); } catch (e) {}
          mark();
        }));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && panel.classList.contains('open')) {
            panel.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.focus();
          }
        });
        document.addEventListener('click', (e) => {
          if (!panel.contains(e.target) && !toggle.contains(e.target)) {
            panel.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
          }
        });
        const menu = document.querySelector('[data-menu]');
        const nav = document.getElementById('site-nav');
        menu.addEventListener('click', () => {
          const open = nav.classList.toggle('open');
          menu.setAttribute('aria-expanded', String(open));
        });
      })();
    </script>
  </body>
</html>
