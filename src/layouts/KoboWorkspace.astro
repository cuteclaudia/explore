---
import '../styles/global.css';
import {getHome} from '../lib/site';
import KoboLauncher from '../components/KoboLauncher.astro';
import Icon from '../components/Icon.astro';
import KoboIcon from '../components/KoboIcon.astro';
import {CRAFT_TOOLS} from '../../server/craft-tools.mjs';
import {APP_PRESENTATION} from '../lib/app-presentation.mjs';
const {actor,title='Workspace',section='home'}=Astro.props;
const home=await getHome();
const railApps=Object.values(CRAFT_TOOLS).filter(tool=>actor.permissions[tool.capability]===true);
---
<!doctype html><html lang="en-AU" data-palette={home.defaultPalette}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{title} · SoraSpace</title><link rel="icon" href="/kobo/icons/hikari.svg"/><script is:inline src="/site-theme.js"></script></head><body><a class="skip" href="#main">Skip to content</a><header class="workspace-bar"><button type="button" class="workspace-menu-toggle" id="workspace-menu-toggle" aria-label="Open workspace menu" aria-controls="workspace-navigation" aria-expanded="false"><Icon name="menu" size={20}/></button><KoboLauncher actor={actor}/><a class="workspace-brand" href="/apps"><span aria-hidden="true">空</span> SoraSpace<small>by Claudia</small></a><label class="workspace-global-search"><Icon name="search" size={17}/><span class="sr-only">Search apps and saved site files</span><input id="workspace-app-search" type="search" placeholder="Search apps and saved files…" autocomplete="off"/></label><nav aria-label="Workspace account"><a href="/settings" target="_blank" rel="noopener" aria-label="Settings (new tab)"><Icon name="settings" size={18}/></a><a href="/studio/account" target="_blank" rel="noopener" aria-label="Account and security (new tab)"><Icon name="user" size={18}/></a><button type="button" id="workspace-logout" aria-label="Sign out" title="Sign out"><Icon name="logout" size={18}/></button><a class="workspace-explore" href="/" aria-label="Return to Explore"><span>Explore</span> <Icon name="external" size={13}/></a></nav></header><div class="workspace-shell"><aside class="workspace-sidebar" id="workspace-navigation" aria-label="Workspace navigation"><div class="workspace-menu-tools"><button type="button" id="workspace-menu-pin" aria-label="Pin workspace menu" aria-pressed="false" title="Pin workspace menu"><Icon name="pin" size={19}/><span>Pin menu</span></button><button type="button" id="workspace-menu-close" aria-label="Close workspace menu" title="Close menu"><Icon name="close" size={18}/></button></div><nav aria-label="Workspace"><a href="/apps" aria-label="Workspace home" title="Workspace home" aria-current={section==='home'?'page':undefined}><Icon name="grid" size={21}/><span>Home</span></a><a class="rail-utility" href="/apps#workspace-mail-calendar" aria-label="Mail and calendar previews · coming soon" title="Mail & calendar · coming soon"><Icon name="mail" size={21}/><span>Mail</span></a><a href="/apps/files" aria-label="Saved site files" title="Saved site files" aria-current={section==='files'?'page':undefined}><Icon name="document" size={21}/><span>Files</span></a>{railApps.map(tool=><a class="rail-app" href={'/apps/'+tool.slug} data-app-launch target="_blank" rel="noopener" aria-label={(APP_PRESENTATION[tool.slug]?.shortName||tool.name)+' (opens separately)'} title={(APP_PRESENTATION[tool.slug]?.shortName||tool.name)+' · opens separately'}><KoboIcon name={tool.slug} size={24}/><span>{APP_PRESENTATION[tool.slug]?.shortName||tool.name}</span></a>)}<a class="rail-utility" href="/studio/storage" target="_blank" rel="noopener" aria-label="Storage connections (new tab)" title="Storage connections"><Icon name="storage" size={21}/><span>Storage</span></a><a class="rail-utility" href="/settings" target="_blank" rel="noopener" aria-label="Appearance (new tab)" title="Appearance"><Icon name="palette" size={21}/><span>Theme</span></a>{actor.isOwner&&<a class="rail-utility" href="/studio" target="_blank" rel="noopener" aria-label="Owner Studio (new tab)" title="Owner Studio"><Icon name="edit" size={21}/><span>Studio</span></a>}<a class="rail-utility" href="/" aria-label="Return to Explore" title="Return to Explore"><Icon name="external" size={21}/><span>Explore</span></a></nav></aside><button type="button" class="workspace-menu-backdrop" id="workspace-menu-backdrop" aria-label="Close workspace menu" hidden></button><main id="main" class="workspace-content" data-workspace-owner={actor.user.id}><slot/></main></div><p class="workspace-session" id="workspace-session" role="status"></p><script>import '../scripts/kobo-workspace';</script></body></html>
<style is:global>.workspace-bar{display:flex;align-items:center;gap:12px;min-height:64px;padding:8px 24px;background:var(--surface);border-bottom:1px solid var(--border)}.workspace-brand{display:flex;align-items:baseline;gap:9px;text-decoration:none;font:450 25px var(--serif);color:var(--text)}.workspace-brand>span{font-size:20px;color:var(--accent)}.workspace-brand small{font:11px system-ui;opacity:.65;margin-left:8px}.workspace-bar>nav{margin-left:auto;display:flex;align-items:center;gap:8px}.workspace-bar>nav a{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;color:var(--text);text-decoration:none}.workspace-bar>nav button{border:0;background:none;color:inherit;min-width:44px;min-height:44px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}.workspace-bar .workspace-explore{font-size:12px;padding:0 8px}.workspace-shell{display:grid;grid-template-columns:200px minmax(0,1fr);min-height:calc(100dvh - 64px)}.workspace-sidebar{padding:24px 14px;border-right:1px solid var(--border);background:var(--surface)}.workspace-sidebar nav{display:grid;gap:6px}.workspace-sidebar a{display:flex;align-items:center;gap:10px;padding:10px;border-radius:6px;text-decoration:none;font-size:13px;color:var(--text);min-height:44px}.workspace-sidebar a[aria-current=page],.workspace-sidebar a:hover{background:color-mix(in srgb,var(--accent) 9%,transparent);color:var(--accent)}.workspace-sidebar p{font-size:11px;line-height:1.6;opacity:.65;padding:8px 10px}.workspace-content{min-width:0;padding:26px 32px;max-width:1300px;width:100%}.workspace-session{padding:0 24px;font-size:12px;line-height:1.6}.workspace-session:empty{display:none}.workspace-heading h1{font:450 clamp(28px,4vw,36px)/1.15 var(--serif);margin:0 0 10px}.workspace-heading p{font-size:14px;line-height:1.6;max-width:65ch;opacity:.75}.workspace-section{margin-top:24px}.workspace-section h2{font:450 25px var(--serif);margin:0 0 12px}.workspace-section>p,.workspace-section>div>p{font-size:13px;line-height:1.6}.workspace-links{display:flex;flex-wrap:wrap;gap:10px 20px}.workspace-links a{font-size:12px;min-height:44px;display:inline-flex;align-items:center}.workspace-file-list{display:grid;gap:0}.workspace-file-list article{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 20px;padding:12px 0;border-bottom:1px solid var(--border);align-items:center}.workspace-file-list strong{display:block;font-size:13px;font-weight:500;overflow-wrap:anywhere}.workspace-file-list small{display:block;font-size:11px;line-height:1.6;opacity:.7}.workspace-file-list a{font-size:12px;min-height:44px;display:inline-flex;align-items:center}.workspace-content input[type=search]{font-size:16px;width:min(100%,320px);padding:10px 12px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text)}.workspace-note{font-size:12px;line-height:1.6;opacity:.7}@media(max-width:900px){.workspace-shell{grid-template-columns:minmax(0,1fr)}.workspace-sidebar{padding:8px 16px;border-right:0;border-bottom:1px solid var(--border)}.workspace-sidebar nav{display:flex;gap:4px;overflow-x:auto}.workspace-sidebar nav a{flex-shrink:0;font-size:12px;white-space:nowrap}.workspace-sidebar p{display:none}.workspace-content{padding:22px 20px}.workspace-brand small{display:none}}@media(max-width:380px){.workspace-brand>span{display:none}.workspace-bar>nav a,.workspace-bar>nav button{min-width:38px}}@media(max-width:450px){.workspace-bar{padding:6px 10px;gap:5px}.workspace-brand{font-size:22px;gap:6px}.workspace-brand>span{font-size:16px}.workspace-bar>nav{gap:0}.workspace-bar>nav button{border:0;background:none;color:inherit;min-width:44px;min-height:44px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}.workspace-bar .workspace-explore{font-size:11px;padding:0 4px}.workspace-content{padding:20px 16px}.workspace-file-list article{grid-template-columns:minmax(0,1fr)}.workspace-file-list a{min-height:36px}.workspace-sidebar{padding-inline:8px}}
</style>

<style is:global>@media(max-width:450px){.workspace-brand{font-size:18px}.workspace-bar .workspace-explore{min-width:44px;padding:0}.workspace-bar .workspace-explore{display:none}}</style>

<style is:global>.sidebar-soon{font-size:9px;opacity:.6;margin-left:auto}</style>

<style is:global>
.workspace-bar{min-height:56px;padding:6px 18px;gap:14px;box-sizing:border-box;background:color-mix(in srgb,var(--surface) 92%,var(--accent));box-shadow:0 1px 8px #00000006}.workspace-brand{font-size:23px;white-space:nowrap}.workspace-brand small{font-size:10px}.workspace-global-search{display:flex;gap:10px;align-items:center;width:min(440px,40vw);margin-left:clamp(8px,3vw,50px);padding:0 12px;border:1px solid var(--border);border-radius:7px;background:var(--surface);min-width:0;min-height:40px}.workspace-global-search input{width:100%;min-width:0;border:0!important;background:transparent!important;color:var(--text);font:14px system-ui;padding:8px 0;outline-offset:3px}.workspace-global-search svg{flex-shrink:0;opacity:.65}.workspace-shell{grid-template-columns:76px minmax(0,1fr);min-height:calc(100dvh - 56px);background:linear-gradient(135deg,var(--bg),color-mix(in srgb,var(--bg) 96%,var(--accent)))}.workspace-sidebar{padding:8px 5px;border-right:1px solid var(--border);border-bottom:0;position:sticky;top:0;align-self:start;max-height:calc(100dvh - 56px);overflow-y:auto;scrollbar-width:thin;background:color-mix(in srgb,var(--surface) 94%,var(--accent))}.workspace-sidebar nav{display:grid;gap:2px;overflow:visible}.workspace-sidebar a{flex-direction:column;justify-content:center;gap:3px;padding:5px 2px;min-height:48px;font-size:10px;line-height:1.15;white-space:normal;text-align:center;border-radius:7px}.workspace-sidebar a span{max-width:100%;overflow-wrap:anywhere}.workspace-sidebar a[aria-current=page]{box-shadow:inset 3px 0 var(--accent)}.workspace-sidebar .rail-app:hover{background:color-mix(in srgb,var(--accent) 12%,var(--surface))}.workspace-content{max-width:1850px;padding:22px 28px}.workspace-heading h1,.workspace-section h2{font-family:system-ui,sans-serif;font-weight:600;letter-spacing:-.025em}.workspace-file-list article{border-bottom-color:color-mix(in srgb,var(--border) 75%,transparent)}
@media(max-width:1000px){.workspace-brand small{display:none}.workspace-global-search{margin-left:0;flex:1;width:auto}.workspace-bar{gap:8px}.workspace-bar .workspace-explore{display:none}.workspace-content{padding:18px}}
@media(max-width:650px){.workspace-bar{flex-wrap:wrap;padding:5px 10px;gap:2px 8px}.workspace-brand{font-size:21px}.workspace-global-search{order:3;flex-basis:100%;margin:3px 0;min-height:38px}.workspace-bar>nav{gap:0}.workspace-shell{grid-template-columns:minmax(0,1fr);padding-bottom:64px;min-height:calc(100dvh - 104px)}.workspace-sidebar{position:fixed;top:auto;bottom:0;left:0;right:0;max-height:none;padding:4px 6px;border-right:0;border-top:1px solid var(--border);z-index:25;background:var(--surface)}.workspace-sidebar nav{display:flex;gap:2px;overflow-x:auto;scrollbar-width:thin}.workspace-sidebar a{min-width:46px;flex:1;min-height:48px;padding:3px 2px;font-size:9px}.workspace-sidebar .rail-utility{display:none}.workspace-sidebar a[aria-current=page]{box-shadow:inset 0 3px var(--accent)}.workspace-content{padding:16px}.workspace-brand small{display:none}}
@media(prefers-reduced-motion:reduce){.workspace-sidebar a{transition:none}}@media(forced-colors:active){.workspace-sidebar a[aria-current=page]{outline:2px solid Highlight}.workspace-global-search{border-color:CanvasText}}
</style>

<style is:global>
.workspace-menu-toggle{display:inline-flex;align-items:center;justify-content:center;width:40px;height:44px;flex-shrink:0;border:0;border-radius:6px;color:var(--text);background:transparent;cursor:pointer}.workspace-shell{grid-template-columns:64px minmax(0,1fr);transition:grid-template-columns .16s ease}.workspace-sidebar{width:64px;box-sizing:border-box;z-index:28;overflow-x:hidden;transition:width .16s ease;box-shadow:none}.workspace-sidebar nav{gap:2px}.workspace-sidebar a{flex-direction:row;justify-content:flex-start;padding:9px 14px;gap:12px;min-height:44px;font-size:13px;white-space:nowrap}.workspace-sidebar a>svg,.workspace-sidebar a>img{flex-shrink:0}.workspace-sidebar a>span{opacity:0;visibility:hidden;overflow:hidden;white-space:nowrap;transition:opacity .12s ease}.workspace-menu-tools{display:flex;align-items:center;gap:3px;margin-bottom:4px;min-width:0}.workspace-menu-tools button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-width:44px;min-height:44px;padding:8px;border:0;border-radius:6px;background:transparent;color:var(--text);cursor:pointer;font-size:12px;flex-shrink:0}.workspace-menu-tools #workspace-menu-pin>span{display:none}.workspace-menu-tools #workspace-menu-close{display:none;margin-left:auto}.workspace-menu-tools button[aria-pressed=true]{color:var(--accent);background:color-mix(in srgb,var(--accent) 10%,transparent)}.workspace-shell.sidebar-pinned{grid-template-columns:224px minmax(0,1fr)}.workspace-sidebar.is-open,.sidebar-pinned .workspace-sidebar{width:224px;box-shadow:5px 0 18px #00000012}.workspace-sidebar.is-open a>span,.sidebar-pinned .workspace-sidebar a>span{opacity:1;visibility:visible}.workspace-sidebar.is-open #workspace-menu-pin>span,.sidebar-pinned #workspace-menu-pin>span{display:inline}.workspace-sidebar.is-open #workspace-menu-close{display:inline-flex}.sidebar-pinned #workspace-menu-close{display:none}.workspace-menu-backdrop{position:fixed;inset:0;z-index:55;background:#0005;border:0;padding:0}.workspace-menu-backdrop[hidden]{display:none}.workspace-sidebar a:hover,.workspace-menu-toggle:hover,.workspace-menu-tools button:hover{background:color-mix(in srgb,var(--accent) 10%,var(--surface))}
@media(max-width:650px){.workspace-shell,.workspace-shell.sidebar-pinned{grid-template-columns:minmax(0,1fr);padding-bottom:0}.workspace-sidebar{position:fixed;top:0;bottom:0;left:0;right:auto;width:224px;max-height:100dvh;overflow-y:auto;transform:translateX(-105%);z-index:60;padding:10px 8px;border-top:0;border-right:1px solid var(--border);transition:transform .16s ease;visibility:hidden}.workspace-sidebar.is-open{transform:translateX(0);visibility:visible;width:224px}.workspace-sidebar nav{display:grid;overflow:visible}.workspace-sidebar a{justify-content:flex-start;min-width:0;padding:10px 12px;min-height:46px;flex-direction:row;font-size:13px}.workspace-sidebar .rail-utility{display:flex}.workspace-sidebar a>span{opacity:1;visibility:visible}.workspace-sidebar #workspace-menu-pin{display:none!important}.workspace-sidebar #workspace-menu-close{display:inline-flex!important}.workspace-sidebar .workspace-menu-tools{justify-content:flex-end}.workspace-sidebar a[aria-current=page]{box-shadow:inset 3px 0 var(--accent)}.workspace-bar{gap:2px 4px}.workspace-brand{font-size:19px}.workspace-bar .kobo-launcher summary{min-width:36px;width:36px}.workspace-bar>nav a,.workspace-bar>nav button{min-width:38px}.workspace-global-search{flex-basis:100%}}
@media(prefers-reduced-motion:reduce){.workspace-shell,.workspace-sidebar,.workspace-sidebar a>span{transition:none}}
</style>
