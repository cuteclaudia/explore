---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import prototype from '../templates/explore.html?raw';
const head = prototype.split('<html lang="en">')[1].split('<body>')[0];
const body = prototype.split('<body>')[1].replace('</body></html>', '');
---
<!doctype html>
<html lang="en-AU" class="interactive-site">
  <head>
    <Fragment set:html={head} />
    <link rel="stylesheet" href="/site-chrome.css" />
    <style is:global>.interactive-site button{border-radius:6px;padding:8px 13px;font-size:13px}.interactive-site .hero h1{font-size:clamp(32px,4.8vw,54px)}.interactive-site .card .body{padding:16px}.interactive-site h2{font-size:28px}.interactive-site h3{font-size:22px}.interactive-site .tags{gap:6px}.interactive-site .tags button{background:transparent;border-color:var(--border)}.interactive-site .tags button.active{background:var(--accent);color:white}.interactive-site .hero{height:auto;min-height:clamp(340px,48svh,440px)}.interactive-site .wrap{padding-block:28px}.interactive-site .heading h2{margin-block:8px 16px}.interactive-site .grid{gap:18px}.interactive-site .card img{height:210px}.interactive-site main>section>h1{font-size:clamp(30px,4.8vw,48px);margin:12px 0}.interactive-site button.active,.interactive-site .primary{color:var(--on-accent,#fff)}@media(max-width:750px){.interactive-site .wrap{padding-block:20px}.interactive-site .grid{gap:14px}.interactive-site h2{font-size:25px}.interactive-site .card img{height:190px}}</style>
    <script is:inline src="/site-theme.js"></script>
  </head>
  <body>
    <SiteHeader />
    <Fragment set:html={body} />
    <SiteFooter />
  </body>
</html>
