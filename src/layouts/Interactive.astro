---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import prototype from '../templates/explore.html?raw';
const head = prototype.split('<html lang="en">')[1].split('<body>')[0];
const body = prototype.split('<body>')[1].replace('</body></html>', '');
---
<!doctype html>
<html lang="en-AU" class="interactive-site">
  <head>
    <Fragment set:html={head} />
    <link rel="stylesheet" href="/site-chrome.css" />
    <style is:global>.interactive-site button{border-radius:6px;padding:8px 13px;font-size:13px}.interactive-site .hero h1{font-size:clamp(32px,4.8vw,54px)}.interactive-site .card .body{padding:16px}.interactive-site h2{font-size:28px}.interactive-site h3{font-size:22px}.interactive-site .tags{gap:6px}.interactive-site .tags button{background:transparent;border-color:var(--border)}.interactive-site .tags button.active{background:var(--accent);color:white}.interactive-site .hero{height:auto;min-height:clamp(340px,48svh,440px)}.interactive-site .wrap{padding-block:28px}.interactive-site .heading h2{margin-block:8px 16px}.interactive-site .grid{gap:18px}.interactive-site .card img{height:210px}.interactive-site main>section>h1{font-size:clamp(30px,4.8vw,48px);margin:12px 0}.interactive-site button.active,.interactive-site .primary{color:var(--on-accent,#fff)}@media(max-width:750px){.interactive-site .wrap{padding-block:20px}.interactive-site .grid{gap:14px}.interactive-site h2{font-size:25px}.interactive-site .card img{height:190px}}.stratwatch-preview{display:flex;align-items:center;gap:18px;border:1px solid var(--border);border-radius:9px;background:var(--surface);padding:18px;margin:20px 0}.stratwatch-mark{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:62px;height:62px;border-radius:8px;background:var(--accent);color:var(--on-accent,#fff);font:450 26px Georgia,serif}.stratwatch-copy{min-width:0;flex:1}.interactive-site .stratwatch-copy h2{font-size:25px;margin:4px 0}.stratwatch-copy .eyebrow{font-size:9px}.stratwatch-copy p{font-size:12px;line-height:1.6;margin:4px 0}.stratwatch-copy small{display:block;font-size:11px;opacity:.7}.stratwatch-preview>a{display:inline-flex;align-items:center;gap:8px;font-size:12px;min-height:44px;white-space:nowrap}.stratwatch-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}@media(max-width:600px){.stratwatch-preview{flex-wrap:wrap;gap:12px;padding:14px}.stratwatch-mark{width:48px;height:48px;font-size:21px}.stratwatch-copy{flex-basis:calc(100% - 62px)}.stratwatch-preview>a{margin-left:60px}}@media(forced-colors:active){.stratwatch-mark{background:Canvas;color:CanvasText;border:1px solid CanvasText}}</style>
    <style is:global>
.interactive-site .writing-page{max-width:1500px}.writing-layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:24px;align-items:start}.interactive-site .writing-intro h1{font-size:clamp(30px,3.1vw,38px);margin:8px 0}.writing-intro>p{font-size:14px;margin:8px 0 16px}.writing-main,.writing-sidebar{min-width:0}.writing-sidebar{display:grid;gap:14px}.writing-sidebar .stratwatch-preview{margin:0;padding:14px;display:block}.writing-sidebar .stratwatch-mark{float:left;margin:0 12px 6px 0;width:40px;height:40px;font-size:18px}.writing-sidebar .stratwatch-copy small{font-size:10px}.writing-sidebar .stratwatch-preview>a{margin:4px 0 0;white-space:normal}.writing-controls,.pinned-card{padding:16px;border:1px solid var(--border);border-radius:8px;background:var(--surface)}.interactive-site .writing-controls h2,.interactive-site .pinned-card h2{font-size:23px;margin:4px 0 9px;overflow-wrap:anywhere}.writing-controls label{font-size:12px}.writing-controls input{font-size:16px;width:100%;min-width:0;padding:9px;border:1px solid var(--border);border-radius:5px;background:var(--bg);color:var(--text)}.writing-sidebar .writing-filters{display:grid;margin:10px 0 0;max-height:220px;overflow:auto;gap:5px}.writing-sidebar .writing-filters button{text-align:left;white-space:normal;overflow-wrap:anywhere;min-height:36px}.pinned-card p{font-size:13px;line-height:1.55;margin:8px 0}.pinned-card .eyebrow{font-size:9px}.feature-read{font-size:12px;display:inline-flex;align-items:center;min-height:36px}.interactive-site #writing-results{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.writing-main #writing-count{font-size:12px;margin:0 0 10px}.writing-main .card h3{font-size:22px}.writing-main .card p{font-size:13px;line-height:1.55;margin:8px 0}.writing-main .card .eyebrow{font-size:9px;letter-spacing:1px}.writing-main .card .tags{font-size:11px;margin:8px 0}.writing-main .card .body>a{font-size:12px;display:inline-flex;align-items:center;min-height:36px}.interactive-site .hero{overflow:visible}.interactive-site .hero-copy{width:62%;max-width:760px}.home-feature{position:absolute;top:20px;right:24px;width:min(300px,30%);padding:14px;border:1px solid var(--border);border-radius:8px;background:color-mix(in srgb,var(--surface) 96%,transparent);color:var(--ink);box-shadow:0 8px 24px #0002}.home-feature[hidden]{display:none}.home-feature .pinned-card{padding:0;border:0;background:none}.interactive-site .home-feature h2{font-size:22px;line-height:1.2;margin:4px 0 8px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.home-feature .pinned-card p{font-size:12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.home-quick-links{display:grid;grid-template-columns:1fr 1fr;gap:4px 10px;border-top:1px solid var(--border);padding-top:8px;margin-top:4px}.home-quick-links a{font-size:11px;min-height:30px;display:flex;align-items:center}.home-feature h2 a,.home-feature a{color:inherit}.writing-intro{max-width:100%}@media(min-width:1800px){.interactive-site #writing-results{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:1000px){.writing-layout{grid-template-columns:minmax(0,1fr)}.writing-sidebar{grid-row:1;grid-template-columns:repeat(2,minmax(0,1fr))}.writing-controls{grid-column:1/-1;grid-row:1}.writing-sidebar .writing-filters{display:flex;flex-wrap:wrap}.writing-sidebar .writing-filters button{flex:0 1 auto}.writing-sidebar #writing-feature:empty{display:none}.interactive-site .hero-copy{width:60%;padding:5vw 4vw}.home-feature{right:16px;width:34%;top:16px}}@media(max-width:650px){.interactive-site #writing-results{grid-template-columns:minmax(0,1fr)}.writing-sidebar{grid-template-columns:minmax(0,1fr)}.writing-sidebar .writing-controls{grid-column:auto}.interactive-site .hero{display:block}.interactive-site .hero-copy{width:100%;padding:32px 5%;max-width:100%}.home-feature{position:relative;top:auto;right:auto;width:auto;margin:0 5% 22px;box-shadow:none}.interactive-site .home-feature h2{font-size:21px}.writing-controls,.pinned-card{padding:13px}.writing-sidebar .stratwatch-preview{padding:13px}}@media(pointer:coarse){.feature-read,.home-quick-links a,.writing-sidebar .writing-filters button,.writing-main .card .body>a{min-height:44px}}
    </style>
    <style is:global>.writing-main #writing-feature .pinned-card{margin-bottom:16px;padding:14px 16px;border-left:3px solid var(--accent)}.writing-main #writing-feature h2{font-size:24px;margin:5px 0}.writing-main #writing-feature p{font-size:13px;line-height:1.5;margin:6px 0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.home-latest{display:block;margin:6px 0;padding-top:7px;border-top:1px solid var(--border);font-size:11px}.home-latest span{font-size:9px;text-transform:uppercase;letter-spacing:1px;opacity:.75}.home-latest strong{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-weight:500;line-height:1.7}.home-quick-links{margin-top:6px}.interactive-site .home-feature h2{font-size:21px;-webkit-line-clamp:2}</style>
    <style is:global>@media(max-width:1000px){.writing-layout{row-gap:16px}.writing-main{grid-row:2}.writing-sidebar{display:contents}.writing-controls{grid-row:1}.writing-sidebar>.stratwatch-preview{grid-row:3}.writing-sidebar .writing-filters{max-height:180px}}</style>
    <style is:global>.writing-results-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:10px}.writing-main .writing-results-head #writing-count{margin:0}.writing-results-head nav{display:flex;gap:6px}.writing-results-head nav:empty{display:none}.writing-results-head button{min-height:36px}.writing-results-head button:disabled{opacity:.45;cursor:default}.writing-main .card h3{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.writing-main .card .body>p{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}@media(pointer:coarse){.writing-results-head button{min-height:44px}}</style>
    <script is:inline src="/site-theme.js"></script>
  </head>
  <body>
    <SiteHeader />
    <Fragment set:html={body} />
    <SiteFooter />
  </body>
</html>
