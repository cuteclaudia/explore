---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
const {title,section}=Astro.props;
const navigation=[['/settings','Appearance','palette','appearance'],['/studio/storage','Files & storage','storage','storage'],['/studio/account','Sign-in & security','shield','security'],['/settings/connections','Activities & maps','mountain','connections']];
---
<Base title={title} description="Personalise your Explore experience and manage your account connections." noindex>
<div class="wrap settings-shell"><header class="settings-heading"><span class="eyebrow">Your account</span><h1>Settings</h1><p>A little more your own.</p></header><div class="settings-columns"><aside><nav aria-label="Settings">{navigation.map(([href,label,icon,id])=><a href={href} aria-current={section===id?'page':undefined}><Icon name={icon}/>{label}</a>)}<a href="/apps"><Icon name="grid"/>My apps</a><a href="/studio/downloads" data-owner-settings hidden aria-current={section==='downloads'?'page':undefined}><Icon name="download"/>Desktop installers</a><a href="/studio/users" data-owner-settings hidden><Icon name="user"/>User permissions</a></nav></aside><section class="settings-content"><slot/></section></div></div>
</Base>
<style>.settings-shell{max-width:1140px;padding-top:24px;padding-bottom:40px}.settings-heading{margin-bottom:20px}.settings-heading h1{font-size:30px;font-weight:450;font-family:var(--serif);margin:8px 0}.settings-heading p{margin:0;opacity:.65}.settings-columns{display:grid;grid-template-columns:210px minmax(0,1fr);gap:32px}.settings-columns aside nav{display:flex;flex-direction:column;gap:6px;position:sticky;top:20px}.settings-columns aside a{display:flex;align-items:center;gap:12px;padding:9px 12px;border-radius:7px;text-decoration:none;font-size:14px;color:inherit}.settings-columns aside a[aria-current=page]{background:color-mix(in srgb,var(--accent) 9%,transparent);color:var(--accent)}.settings-columns aside a:hover{background:color-mix(in srgb,var(--accent) 6%,transparent)}.settings-content{min-width:0}.settings-content :global(h2){font-family:var(--serif);font-size:23px;font-weight:450;margin:0 0 10px}.settings-content :global(h3){font-size:17px;font-weight:500}.settings-content :global(.settings-section){padding:0 0 20px;margin:0 0 20px;border-bottom:1px solid var(--border)}.settings-content :global(p){font-size:14px;max-width:65ch;opacity:.8}.settings-content :global(label){font-size:14px}.settings-content :global(input:not([type=color]):not([type=checkbox])),.settings-content :global(select){max-width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text)}@media(max-width:750px){.settings-columns{grid-template-columns:1fr;gap:30px}.settings-columns aside nav{position:static;flex-direction:row;flex-wrap:wrap;gap:2px}.settings-columns aside a{font-size:12px;padding:10px}.settings-heading{margin-bottom:20px}.settings-heading h1{font-size:28px}.settings-shell{padding-top:20px}}</style>
