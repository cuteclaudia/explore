---
import Icon from './Icon.astro';
---
<section class="explore-welcome wrap" aria-labelledby="explore-title">
  <div class="welcome-scene">
    <img src="/images/hiking.jpg" alt="A walker looking across a mountain ridge in the evening light" width="900" height="601" fetchpriority="high" />
    <div class="welcome-copy"><span class="eyebrow">Hike · Ride · Climb · Ski</span><h1 id="explore-title">A little further.<br />A little more alive.</h1><p>Find a trail, follow your curiosity, and make the outside part of your everyday.</p><div class="welcome-actions"><a class="btn" href="#explore-planner">Find your next adventure <Icon name="arrow" size={16}/></a><a href="/trips">My trips & plans</a></div></div>
    <span class="scene-note">Good things happen outside.</span>
  </div>
  <section class="activity-glance" aria-labelledby="activity-heading">
    <div class="glance-intro"><span class="eyebrow">Your own perspective</span><h2 id="activity-heading">Your route, at a glance.</h2><p id="activity-summary-note" role="status">Open a GPX, TCX or FIT route to see your statistics here. It stays in this browser view.</p><button type="button" id="open-route-preview"><Icon name="plus" size={16}/>Open route file</button><button type="button" id="clear-route-preview" hidden>Clear preview</button></div>
    <dl class="activity-numbers"><div><dt>Distance</dt><dd id="activity-distance">—</dd><span>Mapped track</span></div><div><dt>Elevation gain</dt><dd id="activity-ascent">—</dd><span id="activity-source-label">From your route</span></div><div><dt>Highest point</dt><dd id="activity-highest">—</dd><span>With full elevation data</span></div><div><dt>Track points</dt><dd id="activity-points">—</dd><span>In this preview</span></div></dl>
    <div class="connection-note"><Icon name="layers" size={16}/><p><strong>Bring your activities together.</strong> Preview selected activities from Strava once your account is connected.</p><a href="/settings/connections">Activity connections <Icon name="arrow" size={14}/></a></div>
  </section>
</section>
<style>
.explore-welcome{padding-top:18px}.welcome-scene{position:relative;isolation:isolate;overflow:hidden;border-radius:12px;min-height:260px;background:#e9e9e4;color:#23392e}.welcome-scene>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 62%;z-index:-2}.welcome-scene:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#f9f7ef 0%,#f9f7eff2 24%,#f9f7ef80 51%,transparent 76%);z-index:-1}.welcome-copy{max-width:590px;padding:28px 32px}.welcome-copy .eyebrow{font-size:10px;letter-spacing:.17em}.welcome-copy h1{font:450 clamp(36px,4vw,55px)/1.02 var(--serif);letter-spacing:-.025em;margin:12px 0}.welcome-copy p{font-size:14px;line-height:1.55;max-width:37ch;margin:12px 0 18px}.welcome-actions{display:flex;align-items:center;gap:18px;flex-wrap:wrap}.welcome-actions .btn{background:#376b5c;color:#fff;display:inline-flex;align-items:center;gap:10px;border-color:#376b5c;font-size:12px;padding:10px 14px}.welcome-actions>a:not(.btn){color:inherit;font-size:12px;text-underline-offset:4px}.scene-note{position:absolute;right:20px;bottom:18px;color:#fff;font:23px/1.1 Caveat,cursive;text-shadow:0 1px 5px #0008;transform:rotate(-4deg)}.activity-glance{margin-top:14px;border:1px solid var(--border);border-radius:10px;background:var(--surface);display:grid;grid-template-columns:260px minmax(0,1fr);gap:12px 24px;padding:18px 22px}.glance-intro .eyebrow{font-size:9px}.glance-intro h2{font:450 25px/1.15 var(--serif);margin:6px 0}.glance-intro p{font-size:12px;line-height:1.5;margin:8px 0;min-height:36px}.glance-intro button[hidden]{display:none}.glance-intro button{display:inline-flex;align-items:center;gap:6px;font:12px system-ui;padding:6px 0;border:0;background:none;color:var(--accent);cursor:pointer;min-height:36px}.activity-numbers{margin:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:center;gap:12px}.activity-numbers>div{min-width:0;border-left:1px solid var(--border);padding-left:18px}.activity-numbers dt{font-size:11px;font-weight:500}.activity-numbers dd{font:450 clamp(24px,2.8vw,36px)/1.1 var(--serif);margin:10px 0;overflow-wrap:anywhere}.activity-numbers span{font-size:10px;line-height:1.4;display:block;opacity:.7}.connection-note{grid-column:1/-1;border-top:1px solid var(--border);padding-top:10px;display:flex;align-items:center;gap:10px}.connection-note p{font-size:11px;line-height:1.5;margin:0;flex:1}.connection-note strong{font-weight:500}.connection-note a{display:inline-flex;align-items:center;gap:6px;font-size:11px;white-space:nowrap;color:var(--accent)}@media(max-width:900px){.activity-glance{grid-template-columns:1fr;padding:16px;gap:10px}.glance-intro{display:grid;grid-template-columns:1fr auto;column-gap:16px}.glance-intro .eyebrow,.glance-intro h2{grid-column:1}.glance-intro p{grid-column:1/-1;min-height:0}.glance-intro button{grid-column:2;grid-row:1/3}.glance-intro #clear-route-preview{grid-column:2;grid-row:4}.activity-numbers{padding:8px 0}.activity-numbers>div:first-child{border-left:0;padding-left:0}}@media(max-width:600px){.explore-welcome{padding-top:10px}.welcome-scene{min-height:290px}.welcome-scene:after{background:linear-gradient(90deg,#f9f7eff5,#f9f7efc9 58%,#f9f7ef21)}.welcome-copy{padding:24px 20px;max-width:100%}.welcome-copy h1{font-size:39px;max-width:12ch}.welcome-copy p{font-size:13px;max-width:28ch}.welcome-actions{gap:12px}.scene-note{display:none}.glance-intro{display:block}.glance-intro h2{font-size:24px}.activity-numbers{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.activity-numbers>div{padding-left:14px}.activity-numbers>div:nth-child(3){border-left:0;padding-left:0}.activity-numbers dd{font-size:30px;margin:6px 0}.connection-note{flex-wrap:wrap;align-items:flex-start}.connection-note p{flex-basis:calc(100% - 30px)}.connection-note a{margin-left:26px;min-height:32px}.welcome-actions>a,.glance-intro button{min-height:44px;display:inline-flex;align-items:center}}@media(pointer:coarse){.glance-intro button,.connection-note a,.welcome-actions>a{min-height:44px}}@media(forced-colors:active){.welcome-scene{background:Canvas;color:CanvasText;border:1px solid CanvasText}.welcome-scene>img,.welcome-scene:after,.scene-note{display:none}.welcome-actions .btn{background:ButtonFace;color:ButtonText;border:1px solid ButtonText}}
</style>
