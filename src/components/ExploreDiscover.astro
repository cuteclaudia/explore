---
import Icon from './Icon.astro';
const suggestions=[
 {name:'Walk among the escarpments',where:'Blue Mountains · Australia',activity:'hiking',label:'Hiking',place:0,image:'blue-mountains.jpg',alt:'Forested escarpments in the Blue Mountains',note:'Explore mapped walking paths and marked trails.'},
 {name:'Find your next ride',where:'Canberra region · Australia',activity:'mtb',label:'Mountain biking',place:4,image:'cycling.jpg',alt:'Cycling landscape inspiration',note:'Browse mapped MTB tracks and source difficulty grades.'},
 {name:'A different kind of ascent',where:'Blue Mountains · Australia',activity:'climbRoutes',label:'Climbing',place:0,image:'tre-cime-cave.jpg',alt:'Rocky mountain landscape inspiration',note:'Discover recorded climbing areas and individual routes.'},
 {name:'Follow the snow',where:'Mont Blanc region · France / Italy',activity:'skiing',label:'Skiing',place:3,image:'snow-range.jpg',alt:'Snow-covered mountain landscape inspiration',note:'Explore mapped pistes and lifts, where coverage exists.'},
];
---
<section class="wrap explore-discover" aria-labelledby="discover-heading"><header><div><span class="eyebrow">A change of scene</span><h2 id="discover-heading">Where will curiosity take you?</h2></div><a href="#explore-planner">Explore the map <Icon name="arrow" size={16}/></a></header><div class="adventure-grid">{suggestions.map(item=><article class="adventure-card"><a href={'/places?place='+item.place+'&activity='+item.activity+'#explore-planner'} data-discover-place={item.place} data-discover-activity={item.activity}><div class="card-image"><img src={'/images/'+item.image} alt={item.alt} width="450" height="280" loading="lazy"/><span>{item.label}</span></div><div class="card-copy"><p class="region">{item.where}</p><h3>{item.name}</h3><p>{item.note}</p><span class="card-action">Find mapped options <Icon name="arrow" size={14}/></span></div></a></article>)}</div><p class="discovery-note">Destination inspiration, not verified itineraries; photographs are illustrative. Select a mapped feature for its source and available details. Route distances describe the mapped section, not necessarily a complete outing. Check current access, weather and conditions locally.</p><div class="next-adventure"><Icon name="mountain" size={22}/><div><h3>Turn a possibility into a plan.</h3><p>Keep your trips, dates and places together in your own workspace.</p></div><a class="btn ghost" href="/trips">My trips & plans <Icon name="arrow" size={15}/></a></div></section>
<style>
.explore-discover{padding-top:4px;padding-bottom:30px}.explore-discover>header{display:flex;justify-content:space-between;align-items:end;gap:12px;margin-bottom:16px}.explore-discover .eyebrow{font-size:9px}.explore-discover h2{font:450 clamp(25px,3vw,33px)/1.15 var(--serif);margin:6px 0 0}.explore-discover>header>a{display:inline-flex;gap:6px;align-items:center;color:var(--accent);font-size:12px;white-space:nowrap}.adventure-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.adventure-card{min-width:0;border:1px solid var(--border);border-radius:9px;background:var(--surface);overflow:hidden;transition:transform .18s,box-shadow .18s}.adventure-card:hover{transform:translateY(-3px);box-shadow:0 8px 20px #0001}.adventure-card>a{color:inherit;text-decoration:none;display:block;height:100%}.adventure-card>a:focus-visible{outline:3px solid var(--accent);outline-offset:-3px}.card-image{position:relative;height:150px;overflow:hidden}.card-image img{width:100%;height:100%;object-fit:cover;transition:transform .3s}.adventure-card:hover img{transform:scale(1.035)}.card-image>span{position:absolute;left:10px;bottom:10px;background:#f9f7eff2;color:#23392e;border-radius:4px;font-size:10px;padding:4px 7px}.card-copy{padding:13px}.card-copy .region{font-size:10px;opacity:.7;margin:0}.card-copy h3{font:450 23px/1.1 var(--serif);margin:8px 0}.card-copy p{font-size:12px;line-height:1.55;margin:8px 0}.card-action{font-size:11px;color:var(--accent);display:inline-flex;align-items:center;gap:6px;margin-top:7px;min-height:28px}.discovery-note{font-size:11px;line-height:1.6;opacity:.75;margin:12px 0 20px}.next-adventure{display:flex;align-items:center;gap:14px;padding:16px 18px;border:1px solid var(--border);border-radius:9px;background:var(--surface)}.next-adventure h3{font:450 24px var(--serif);margin:0 0 5px}.next-adventure p{font-size:12px;line-height:1.5;margin:0}.next-adventure>a{margin-left:auto;display:inline-flex;gap:8px;align-items:center;font-size:12px;white-space:nowrap}@media(max-width:1000px){.adventure-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.card-image{height:170px}}@media(max-width:600px){.explore-discover>header{align-items:start}.explore-discover>header>a{white-space:normal;max-width:80px;line-height:1.5}.adventure-grid{gap:10px}.card-image{height:115px}.card-copy{padding:11px}.card-copy h3{font-size:21px}.card-copy .region{min-height:30px}.card-copy p{font-size:11px}.next-adventure{flex-wrap:wrap;padding:14px}.next-adventure>div{flex:1}.next-adventure>a{margin-left:36px;min-height:44px}.card-action{font-size:10px;min-height:40px}}@media(prefers-reduced-motion:reduce){.adventure-card,.card-image img{transition:none}.adventure-card:hover,.adventure-card:hover img{transform:none}}
</style>
