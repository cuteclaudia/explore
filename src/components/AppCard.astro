---
import Icon from './Icon.astro';
import KoboIcon from './KoboIcon.astro';
import {APP_PRESENTATION} from '../lib/app-presentation.mjs';
const {id,tool,canOpen=true,betaAccess=false,inWorkspace=false}=Astro.props;
const display=APP_PRESENTATION[tool.slug];
---
<article class="app-tile" data-desktop-app={id}><div class="app-main">{canOpen?<a class="app-open" href={'/apps/'+tool.slug} target={inWorkspace?undefined:'_blank'} rel={inWorkspace?undefined:'noopener'}><span class="app-tile-icon"><KoboIcon name={tool.slug} size={52}/></span><span class="app-tile-text"><strong>{inWorkspace?(display?.shortName||tool.name):(display?.name||tool.name)}</strong><small class="app-legacy">{display?.legacyName||tool.name}</small><span>{tool.description}</span></span><span class="app-tile-arrow"><Icon name="arrow" size={17}/></span></a>:<div class="app-open"><span class="app-tile-icon"><KoboIcon name={tool.slug} size={52}/></span><span class="app-tile-text"><strong>{inWorkspace?(display?.shortName||tool.name):(display?.name||tool.name)}</strong><small class="app-legacy">{display?.legacyName||tool.name}</small><span>{tool.desktopOnly?'Desktop app · in development. Downloads appear when a release is configured.':'Desktop access · download an installer below.'}</span></span></div>}</div>{betaAccess&&<a class="app-beta" href={'/studio/kobo-test?app='+tool.slug} aria-label={'Open '+(display?.name||tool.name)+' beta'}>Beta</a>}<div class="desktop-access">{canOpen&&inWorkspace&&<a class="app-separate" href={'/apps/'+tool.slug} target="_blank" rel="noopener" aria-label={'Open '+(display?.name||tool.name)+' in another tab'} title="Open in another tab"><Icon name="external" size={16}/><span class="sr-only">Open in another tab</span></a>}<details class="desktop-download" hidden><summary aria-label={'Download '+(display?.name||tool.name)+' for desktop'}><Icon name="download" size={14}/>Desktop</summary><div class="desktop-options"></div></details><span class="desktop-roadmap" title="macOS support is planned as a future project; no installer is available yet.">macOS · Planned</span></div></article>
<script>import '../scripts/app-downloads';</script>
<style>.app-tile[hidden]{display:none}.app-tile{position:relative;display:flex;align-items:center;gap:10px;padding:18px 0;border-bottom:1px solid var(--border);color:inherit;min-width:0}.app-main{min-width:0;flex:1}.app-open{display:flex;align-items:center;gap:17px;text-decoration:none;color:inherit;min-width:0}.app-tile-icon{display:flex;align-items:center;justify-content:center;width:50px;height:50px;flex-shrink:0;color:var(--accent)}.app-tile-text{display:flex;flex-direction:column;gap:5px;min-width:0}.app-tile-text strong{font-size:16px;font-weight:500}.app-tile-text>span{font-size:12px;line-height:1.5;opacity:.65;max-width:40ch}.app-tile-arrow{margin-left:auto;opacity:.35;transition:transform .15s,opacity .15s}.app-open:hover .app-tile-arrow,.app-open:focus-visible .app-tile-arrow{transform:translateX(4px);opacity:1}.app-open:hover strong{color:var(--accent)}.app-beta{flex-shrink:0;font-size:12px;color:var(--accent);text-decoration:none;padding:9px 3px}.app-separate{font-size:16px;min-height:32px;min-width:32px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;color:var(--accent)}.desktop-access{flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;gap:2px}.desktop-roadmap{font-size:10px;line-height:1.4;opacity:.65;white-space:nowrap}.desktop-roadmap[hidden]{display:none}.desktop-download{flex-shrink:0;position:relative}.desktop-download summary{display:flex;align-items:center;gap:4px;cursor:pointer;list-style:none;font-size:11px;color:var(--accent);padding:8px 0}.desktop-download summary::-webkit-details-marker{display:none}.desktop-options{position:absolute;right:0;top:100%;min-width:180px;max-width:260px;z-index:10;background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:6px;box-shadow:0 8px 20px #0001}.desktop-options :global(a){display:block;text-decoration:none;font-size:12px;color:var(--text);padding:9px}.desktop-options :global(a:hover){background:var(--bg)}.desktop-options :global(small){display:block;font-size:10px;opacity:.65;margin-top:4px;overflow-wrap:anywhere}@media(max-width:450px){.app-open{gap:10px}.app-tile-icon{width:40px}.app-tile-icon :global(svg),.app-tile-icon :global(img){width:40px;height:40px}.app-tile-arrow{display:none}}</style>

<style>.app-legacy{font-size:10px;opacity:.6}.app-tile-text strong{overflow-wrap:anywhere}</style>
