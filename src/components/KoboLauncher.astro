---
import {CRAFT_TOOLS} from '../../server/craft-tools.mjs';
import Icon from './Icon.astro';
import KoboIcon from './KoboIcon.astro';
import {APP_PRESENTATION} from '../lib/app-presentation.mjs';
const {actor,current=''}=Astro.props;
const tools=Object.values(CRAFT_TOOLS).filter(tool=>actor.permissions[tool.capability]===true);
---
<details class="kobo-launcher"><summary aria-label="Switch SoraSpace app" title="Switch app"><Icon name="grid" size={19}/><span class="launcher-copy"><span data-i18n="Apps">Apps</span></span></summary><nav aria-label="SoraSpace app launcher"><a class="launcher-home" href="/apps"><span data-i18n="SoraSpace workspace">SoraSpace workspace</span></a>{tools.map(tool=><a href={'/apps/'+tool.slug} data-app-launch target="_blank" rel="noopener" aria-label={(APP_PRESENTATION[tool.slug]?.shortName||tool.name)+' (opens separately)'} aria-current={tool.slug===current?'page':undefined}><KoboIcon name={tool.slug} size={28}/><span>{APP_PRESENTATION[tool.slug]?.shortName||tool.name}<small class="app-japanese" lang="ja">{APP_PRESENTATION[tool.slug]?.legacyName} · {APP_PRESENTATION[tool.slug]?.japaneseName}</small></span></a>)}<a class="launcher-home" href="/apps/files"><span data-i18n="Saved site files">Saved site files</span></a><a class="launcher-home" href="/settings" target="_blank" rel="noopener"><span data-i18n="Settings">Settings </span><Icon name="external" size={13}/><span class="launcher-sr"> (new tab)</span></a></nav></details>
<script>
import '../scripts/app-launch.mjs';
for(const menu of document.querySelectorAll<HTMLDetailsElement>('.kobo-launcher')){document.addEventListener('click',event=>{if(!menu.contains(event.target as Node))menu.open=false;});document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menu.open){menu.open=false;menu.querySelector('summary')?.focus();}});}
</script>
<style>.kobo-launcher{position:relative;flex-shrink:0;font:13px/1.4 system-ui;z-index:30}.kobo-launcher summary{display:flex;align-items:center;justify-content:center;gap:7px;cursor:pointer;min-width:44px;min-height:44px;padding:6px 8px;box-sizing:border-box;list-style:none;border-radius:5px;color:inherit}.kobo-launcher summary::-webkit-details-marker{display:none}.kobo-launcher summary:hover{background:color-mix(in srgb,currentColor 9%,transparent)}.kobo-launcher nav{position:absolute;left:0;top:calc(100% + 4px);width:240px;max-width:calc(100vw - 32px);max-height:min(520px,70dvh);overflow:auto;background:var(--surface,#fff);color:var(--text,#263b31);border:1px solid var(--border,#ccc);border-radius:8px;box-shadow:0 10px 30px #0003;padding:6px;display:grid;grid-template-columns:1fr 1fr;gap:3px}.kobo-launcher nav a{display:flex;align-items:center;gap:8px;padding:8px;min-height:44px;font:12px/1.4 system-ui;text-decoration:none;color:inherit;box-sizing:border-box;border-radius:4px}.kobo-launcher nav a:hover,.kobo-launcher nav a[aria-current=page]{background:color-mix(in srgb,currentColor 9%,transparent)}.kobo-launcher nav a.launcher-home{grid-column:1/-1}.launcher-sr{position:absolute;width:1px;height:1px;clip-path:inset(50%);overflow:hidden}@media(max-width:600px){.launcher-copy{display:none}.kobo-launcher summary{padding:6px}}
</style>

<style>.app-japanese{font:10px/1.4 system-ui;opacity:.7;margin-left:6px;white-space:nowrap}.rail-app>span{min-width:0;overflow-wrap:anywhere}.rail-app .app-japanese{display:inline-block}.kobo-launcher nav{width:340px}.kobo-launcher nav a>span{min-width:0;overflow-wrap:anywhere}.kobo-launcher .app-japanese{display:inline-block}</style>
