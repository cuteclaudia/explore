---
import Icon from './Icon.astro';
const links = [
  ['/#home', 'Home', 'home'],
  ['/#writing', 'Writing & analysis', 'writing'],
  ['/places', 'Explore', 'map'],
  ['/#photography', 'Photography', 'photography'],
  ['/journal', 'Journal', 'journal'],
  ['/trips', 'Trips', 'trips'],
  ['/about', 'About Claudia', 'about'],
  ['/contact', 'Contact', 'contact'],
];
---

<header class="explore-header">
  <a class="explore-brand" href="/#home" aria-label="Explore by Claudia, home"><Icon name="mountain" size={30}/><span class="brand-name">Explore<small>BY CLAUDIA</small></span></a>
  <button class="explore-menu" type="button" aria-label="Menu" aria-controls="explore-navigation" aria-expanded="false"><Icon name="menu"/><span class="sr-only">Menu</span></button>
  <nav class="explore-navigation" id="explore-navigation" aria-label="Main navigation">
    {links.map(([href, label, section]) => <a href={href} data-section={section}>{label}</a>)}
  </nav>
  <div class="explore-account" aria-label="Your account">
    <a class="explore-signin" href="/studio/login" data-account-signin>Sign in</a>
    <a class="icon-control" href="/apps" aria-label="My apps" data-tooltip="My apps" data-account-apps hidden><Icon name="grid"/></a>
    <a class="icon-control" href="/studio" aria-label="My Studio" data-tooltip="My Studio" data-account-studio hidden><Icon name="edit"/><span class="sr-only" data-account-label>My Studio</span></a>
    <details class="explore-account-menu" data-account-menu>
      <summary class="icon-control" aria-label="Account menu" data-tooltip="Account"><Icon name="user"/></summary>
      <div class="explore-account-panel">
        <span class="account-menu-label">Your space</span>
        <a href="/apps" data-auth-link hidden><Icon name="grid"/>My apps</a><a href="/studio" data-owner-studio-link hidden><Icon name="edit"/>My Studio</a>
        <a href="/trips"><Icon name="mountain"/>Trips & events</a><a href="/settings"><Icon name="settings"/>Settings</a>
        <a href="/studio/account" data-auth-link hidden><Icon name="shield"/>Sign-in & security</a>
        <a href="/studio/users" data-account-permissions hidden><Icon name="user"/>User permissions</a>
        <button type="button" data-account-logout hidden><Icon name="logout"/>Sign out</button>
        <p role="status" data-account-status></p>
      </div>
    </details>
  </div>
</header>
<script>
  import '../scripts/account-navigation';
  const nav = document.getElementById('explore-navigation')!;
  const toggle = document.querySelector<HTMLButtonElement>('.explore-menu')!;
  const close = () => { nav.classList.remove('is-open'); toggle.setAttribute('aria-expanded', 'false'); };
  const mark = () => {
    const path = location.pathname.replace(/\/$/, '') || '/';
    const hash = location.hash.slice(1).split('/')[0];
    let section = '';
    if (path === '/' || path === '/prototype') section = ['members', 'member'].includes(hash) ? 'home' : hash || 'home';
    else if (path.startsWith('/about')) section = 'about';
    else if (path.startsWith('/contact')) section = 'contact';
    else if (/^\/(chinaseries|dailycyberreport|strategy)(\/|$)/.test(path)) section = 'writing';
    else if (path.startsWith('/tags')) section = 'tags';
    else if (path.startsWith('/trips')) section = 'trips';
    else if (path.startsWith('/journal')) section = 'journal';
    else if (path.startsWith('/photography')) section = 'photography';
    else if (path.startsWith('/places')) section = 'map';
    else if (path.startsWith('/explore')) section = 'map';
    nav.querySelectorAll<HTMLAnchorElement>('a').forEach(link => {
      if (link.dataset.section === section) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  };
  toggle.addEventListener('click', () => {
    const open = nav.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  nav.addEventListener('click', event => { if ((event.target as Element).closest('a')) close(); });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && nav.classList.contains('is-open')) { close(); toggle.focus(); }
  });
  window.addEventListener('hashchange', mark);
  mark();
</script>
